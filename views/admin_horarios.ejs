<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Admin horarios',
    description: 'Panel para administrar horarios y salidas.',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-horarios">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Horarios', tag: 'Salidas por fecha y horarios base' }) %>

<main class="home-main admin-main">
<section class="container">
    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Administración de horarios</h2>
            <div class="home-tabs-tools">
                <%- include('partials/admin-nav', { adminNav: 'horarios' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="horarios-toolbar">
        <div class="horarios-toolbar-top">
            <div class="horarios-date-block">
                <p class="horarios-date-label" id="kDatePretty">—</p>
                <p class="horarios-date-meta" id="kDir">—</p>
            </div>

            <div class="horarios-toolbar-form">
                <div id="dateWrap" class="horarios-day-nav">
                    <button type="button" class="horarios-day-arrow" id="prevDay" title="Día anterior" aria-label="Ir al día anterior"><%- include('partials/icon', { name: 'chevron-left', size: 18 }) %></button>
                    <span class="horarios-date-input">
                        <span class="horarios-date-fake" id="dateFake" aria-hidden="true">—</span>
                        <input id="trip_date" type="date" class="form-control" aria-label="Fecha">
                    </span>
                    <button type="button" class="horarios-day-arrow" id="nextDay" title="Día siguiente" aria-label="Ir al día siguiente"><%- include('partials/icon', { name: 'chevron-right', size: 18 }) %></button>
                </div>

                <div id="directionWrap" class="admin-filter-seg horarios-dir" hidden>
                    <select id="direction" class="visually-hidden" aria-label="Dirección">
                        <option value="VIC_TO_LLE">Victoria → Llera</option>
                        <option value="LLE_TO_VIC">Llera → Victoria</option>
                    </select>
                    <button type="button" class="is-on" data-dir="VIC_TO_LLE">Victoria → Llera</button>
                    <button type="button" data-dir="LLE_TO_VIC">Llera → Victoria</button>
                </div>

                <button id="loadBtn" class="btn btn-ghost horarios-load" type="button" hidden>Cargar</button>
            </div>
        </div>

        <div class="horarios-tabs-bar">
            <div class="tabs-panel">
                <div class="tabs" id="tabs" role="tablist" aria-label="Secciones de horarios">
                    <button type="button" class="tabbtn is-active" data-tab="ops" role="tab" aria-selected="true" title="Salidas por fecha: habilita o deshabilita un día">
                        Salidas <span class="badge" id="bOps">—</span>
                    </button>
                    <button type="button" class="tabbtn" data-tab="templates" role="tab" aria-selected="false" title="Horarios base: hora, cupo y estado para todas las fechas">
                        Horarios base <span class="badge" id="bTemplates">—</span>
                    </button>
                </div>
            </div>
            <div class="horarios-status">
                <span class="status-pill" id="statusText">—</span>
            </div>
        </div>
    </div>

    <div class="slots-wrap">
        <p class="hint visually-hidden" id="hint">Selecciona pestaña.</p>
        <div id="list"></div>
    </div>

        </div>
    </div>
</section>
</main>

<%- include('partials/toast') %>
<%- include('partials/admin-footer') %>

<script>
    const tripDateEl = document.getElementById("trip_date");
    const directionEl = document.getElementById("direction");
    const loadBtn = document.getElementById("loadBtn");
    const listEl = document.getElementById("list");

    const kDatePretty = document.getElementById("kDatePretty");
    const dateFake = document.getElementById("dateFake");
    const kickerText = document.getElementById("kickerText");
    const prevDay = document.getElementById("prevDay");
    const nextDay = document.getElementById("nextDay");
    const kDir = document.getElementById("kDir");
    const hint = document.getElementById("hint");
    const statusText = document.getElementById("statusText");
    const dateWrap = document.getElementById("dateWrap");
    const directionWrap = document.getElementById("directionWrap");

    const tabsEl = document.getElementById("tabs");
    const bOps = document.getElementById("bOps");
    const bTemplates = document.getElementById("bTemplates");

    let currentTab = "ops";
    const TEMPLATE_MAX_CAP = 200; // Mismo tope de seguridad que src/capacity.js (solo evita errores de dedo).

    function ico(name, size) {
        return (window.Icons && typeof window.Icons.svg === "function")
            ? window.Icons.svg(name, { size: size || 14 })
            : "";
    }

    // Aviso emergente a prueba de fallos: si notify.js no cargó, no rompe el flujo de guardado.
    function safeNotify(message, opts){
        try {
            if (typeof window.notify === "function") window.notify(message, opts);
        } catch (e) {
            console.error(e);
        }
    }

    function todayISO(){
        return new Date().toLocaleDateString("en-CA", { timeZone: "America/Monterrey" });
    }

    function addDaysISO(dateISO, days){
        const d = new Date(`${dateISO}T00:00:00`);
        d.setDate(d.getDate() + Number(days || 0));
        return d.toLocaleDateString("en-CA", { timeZone: "America/Monterrey" });
    }

    function dirLabel(d){
        return d === "VIC_TO_LLE" ? "Victoria → Llera" : "Llera → Victoria";
    }

    function formatPrettyDate(iso){
        const s = String(iso || "").trim();
        if (!s) return "";
        try {
            const d = new Date(`${s}T12:00:00`);
            if (isNaN(d.getTime())) return s;
            const raw = new Intl.DateTimeFormat("es-MX", {
                weekday: "long",
                day: "numeric",
                month: "long",
            }).format(d);
            return raw.charAt(0).toUpperCase() + raw.slice(1);
        } catch {
            return s;
        }
    }

    function formatDateShort(iso){
        const parts = String(iso || "").split("-");
        if (parts.length !== 3) return String(iso || "");
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function setDateHeading(iso, kicker){
        const pretty = formatPrettyDate(iso);
        if (kDatePretty) kDatePretty.textContent = pretty || iso || "—";
        if (dateFake) dateFake.textContent = formatDateShort(iso) || "—";
        if (kickerText) kickerText.textContent = kicker || "Horarios";
    }

    function hhmm(t){
        return String(t || "").slice(0, 5);
    }

    function occupancyMeta(used, cap){
        const c = Math.max(0, Number(cap) || 0);
        const u = Math.min(c, Number(used) || 0);
        const remaining = Math.max(0, c - u);
        const pct = c > 0 ? Math.min(100, Math.round((u / c) * 100)) : 0;
        let tone = "empty";
        if (c > 0 && u >= c) tone = "full";
        else if (u > 0 && remaining <= 2) tone = "tight";
        else if (u > 0) tone = "ok";
        let status = "Vacía";
        if (tone === "full") status = "Llena";
        else if (tone === "tight" || tone === "ok") status = remaining + (remaining === 1 ? " libre" : " libres");
        return { c, u, remaining, pct, tone, status };
    }

    function syncDirectionChips(){
        const current = directionEl?.value || "VIC_TO_LLE";
        document.querySelectorAll("#directionWrap [data-dir]").forEach((btn) => {
            btn.classList.toggle("is-on", btn.dataset.dir === current);
        });
    }

    function tagByAvailability(avail){
        const n = Number(avail || 0);
        if (n <= 0) return "tag-bad";
        if (n <= 2) return "tag-warn";
        return "tag-ok";
    }

    function escapeHtml(s){
        return String(s || "").replace(/[&<>"']/g, m => ({
            "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"
        }[m]));
    }

    // Nunca lanza: devuelve {ok:false, message} si falla la red, la sesión expiró o la respuesta no es JSON.
    async function parseResponse(res){
        const type = String(res.headers.get("content-type") || "");
        if (res.redirected && /\/login/.test(res.url)) {
            return {ok: false, message: "Tu sesión expiró. Vuelve a iniciar sesión."};
        }
        if (!type.includes("application/json")) {
            return {ok: false, message: res.status === 401 || res.status === 403
                ? "Tu sesión expiró. Vuelve a iniciar sesión."
                : `Respuesta inesperada del servidor (${res.status}).`};
        }
        try {
            return await res.json();
        } catch {
            return {ok: false, message: "No pude leer la respuesta del servidor."};
        }
    }

    async function apiGet(url){
        try {
            return await parseResponse(await fetch(url, {credentials: "same-origin"}));
        } catch {
            return {ok: false, message: "Sin conexión con el servidor."};
        }
    }

    async function apiPost(url, body){
        try {
            return await parseResponse(await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {"Content-Type":"application/json"},
                body: JSON.stringify(body)
            }));
        } catch {
            return {ok: false, message: "Sin conexión con el servidor."};
        }
    }

    /* -----------------------------
       OPS (2 columnas)
    ----------------------------- */
    function opsRowTemplate(r) {
        const disabledBecauseTemplate = !r.template_active;
        const tripEnabled = (String(r.trip_status || "OPEN").toUpperCase() === "OPEN");
        const dayOff = !tripEnabled && !disabledBecauseTemplate;
        const dayCancelledClass = dayOff ? "day-cancelled" : "";
        const occ = occupancyMeta(r.used, r.capacity);
        const time = hhmm(r.depart_time);

        return `
            <div class="slot-row is-${occ.tone} ${disabledBecauseTemplate ? "disabled-row" : ""} ${dayCancelledClass}"
                 data-templateid="${r.template_id}"
                 data-direction="${escapeHtml(r.direction)}"
                 data-depart="${escapeHtml(r.depart_time)}"
                 data-capacity="${Number(r.capacity || 0)}"
                 data-used="${Number(r.used || 0)}">
                <div class="slot-time mono">${escapeHtml(time)}</div>
                <div class="slot-body">
                    <div class="slot-top">
                        <span class="slot-status">${dayOff ? "Deshabilitada este día" : occ.status}</span>
                        <span class="slot-cap mono"><strong>${occ.u}</strong>/${occ.c}</span>
                    </div>
                    <div class="slot-meter" role="meter" aria-valuemin="0" aria-valuemax="${occ.c}" aria-valuenow="${occ.u}" aria-label="${occ.u} de ${occ.c} asientos" style="--w:${occ.pct}%"><span></span></div>
                </div>
                <div class="slot-actions">
                    ${disabledBecauseTemplate ? `<span class="slot-tag-off" title="El horario base está inactivo: no se ofrece en ninguna fecha">Horario base inactivo</span>` : ""}
                    ${dayOff ? `<span class="slot-tag-off is-day">Deshabilitada</span>` : ""}
                    <label class="switch" title="Habilita o deshabilita solo esta salida en la fecha elegida">
                        <span class="switch-text">Este día</span>
                        <input class="trip-toggle" type="checkbox"
                               ${tripEnabled ? "checked" : ""}
                               ${disabledBecauseTemplate ? "disabled" : ""}>
                    </label>
                    <button class="btn-mini btn-mini-ghost tpl-link" type="button" title="Cambiar hora, cupo o estado para todas las fechas">${ico("wrench", 14)} Horario base</button>
                </div>
            </div>
        `;
    }

    function bindOpsRow(rowEl, date) {
        const templateId = Number(rowEl.dataset.templateid);
        const rowDir = String(rowEl.dataset.direction || "");

        rowEl.querySelector(".tpl-link")?.addEventListener("click", () => {
            directionEl.value = rowDir;
            syncDirectionChips();
            setActiveTab("templates");
        });

        const tripToggle = rowEl.querySelector(".trip-toggle");

        // ✅ Mejora 1 + 2: confirmación inteligente + refrescar SOLO fila
        tripToggle?.addEventListener("change", async () => {
            const enabled = tripToggle.checked;
            const time = hhmm(rowEl.dataset.depart);

            // confirmación inteligente al DESHABILITAR si hay usados
            if (!enabled) {
                const used = Number(rowEl.dataset.used || 0);
                if (used > 0) {
                    const ok = await Confirm.ask({
                        title: `Deshabilitar la salida de las ${time}`,
                        message: `Hay ${used} asiento(s) usados en este horario.\nSe cancelarán las reservas sin pagar de ese día.`,
                        confirmText: "Deshabilitar",
                        tone: "danger"
                    });
                    if (!ok) {
                        tripToggle.checked = true;
                        return;
                    }
                }
            }

            tripToggle.disabled = true;
            rowEl.classList.add("is-saving");
            statusText.textContent = enabled ? "Habilitando…" : "Deshabilitando…";

            const resp = await apiPost("/admin/api/horarios/trip", {
                trip_date: date,
                template_id: templateId,
                enabled
            });

            tripToggle.disabled = false;
            rowEl.classList.remove("is-saving");

            if (!resp?.ok) {
                tripToggle.checked = !enabled;
                statusText.textContent = "No se guardó";
                safeNotify(resp?.message || "No pude actualizar el horario del día.", {variant: "danger", delay: 3500});
                return;
            }

            // Primero el estado real en pantalla; el aviso emergente nunca debe poder bloquearlo.
            statusText.textContent = enabled ? `Habilitada ${time}` : `Deshabilitada ${time}`;

            // refresco la fila y el resumen de deshabilitadas
            await refreshOpsRow(templateId, date, rowDir);
            await refreshDisabledSummary();

            const c = Number(resp.cancelledReservations || 0);
            const p = Number(resp.rejectedPayments || 0);
            const msg = enabled
                ? `Salida de las ${time} habilitada para ese día.`
                : (c || p
                    ? `Salida de las ${time} deshabilitada. Cancelé ${c} reserva(s) y rechacé ${p} pago(s) pendiente(s).`
                    : `Salida de las ${time} deshabilitada para ese día.`);
            safeNotify(msg, {variant: "success", delay: 3000});
        });
    }

    async function refreshOpsRow(templateId, date, direction) {
        const data = await apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent(direction)}`);
        if (!data?.ok) return;

        const rowData = (data.rows || []).find(x => Number(x.template_id) === Number(templateId));
        if (!rowData) return;

        const old = listEl.querySelector(`.ops-grid .slot-row[data-templateid="${templateId}"]`);
        if (!old) return;

        const tmp = document.createElement("div");
        tmp.innerHTML = opsRowTemplate(rowData);
        const fresh = tmp.firstElementChild;

        old.replaceWith(fresh);
        bindOpsRow(fresh, date);
    }

    async function refreshDisabledSummary(){
        const from = todayISO();
        const to = addDaysISO(from, 60);
        const url = (dir) => `/admin/api/horarios/disabled-days?direction=${encodeURIComponent(dir)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;
        const [x, y] = await Promise.all([apiGet(url("VIC_TO_LLE")), apiGet(url("LLE_TO_VIC"))]);
        if (!x?.ok || !y?.ok) return;

        const rows = [...(x.rows || []), ...(y.rows || [])]
            .sort((p, q) => String(p.trip_date).localeCompare(String(q.trip_date)) || String(p.depart_time).localeCompare(String(q.depart_time)));

        const old = listEl.querySelector(".ops-disabled");
        const wasOpen = !!old?.open;
        const html = disabledSummaryHtml(rows);

        if (!html) { old?.remove(); return; }

        const tmp = document.createElement("div");
        tmp.innerHTML = html;
        const fresh = tmp.firstElementChild;
        fresh.open = wasOpen;

        if (old) old.replaceWith(fresh);
        else listEl.prepend(fresh);
        bindDisabledSummary();
    }

    async function loadOps() {
        const date = tripDateEl.value;

        // ops: uso ambas direcciones; oculto selector dirección
        directionWrap.hidden = true;
        dateWrap.hidden = false;

        kDir.textContent = "Ambas direcciones";
        setDateHeading(date, date === todayISO() ? "Hoy" : "Operación");

        if (!date) {
            hint.textContent = "Selecciona una fecha.";
            listEl.innerHTML = "";
            return;
        }

        hint.textContent = "Cargando…";
        statusText.textContent = "";

        const from = todayISO();
        const to = addDaysISO(from, 60);
        const disabledUrl = (dir) => `/admin/api/horarios/disabled-days?direction=${encodeURIComponent(dir)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`;

        const [a, b, offA, offB] = await Promise.all([
            apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent("VIC_TO_LLE")}`),
            apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent("LLE_TO_VIC")}`),
            apiGet(disabledUrl("VIC_TO_LLE")).catch(() => null),
            apiGet(disabledUrl("LLE_TO_VIC")).catch(() => null)
        ]);

        const disabledRows = [...(offA?.rows || []), ...(offB?.rows || [])]
            .sort((x, y) => String(x.trip_date).localeCompare(String(y.trip_date)) || String(x.depart_time).localeCompare(String(y.depart_time)));

        if (!a?.ok || !b?.ok) {
            hint.textContent = "Error al cargar.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const left = a.rows || [];
        const right = b.rows || [];

        bOps.textContent = String(left.length + right.length);

        listEl.innerHTML = disabledSummaryHtml(disabledRows) + `
            <div class="ops-grid">
                <section class="ops-col" aria-label="Victoria a Llera">
                    <div class="ops-col-head">
                        <div class="ops-col-route">
                            <span>Victoria</span>
                            <span class="ops-col-mid">${ico("arrow-left-right", 16)}</span>
                            <span>Llera</span>
                        </div>
                        <span class="ops-col-count">${left.length}</span>
                    </div>
                    <div class="ops-list" id="opsLeft">
                        ${left.length ? left.map(opsRowTemplate).join("") : `<div class="horarios-empty-col">Sin horarios en este rumbo.</div>`}
                    </div>
                </section>
                <section class="ops-col" aria-label="Llera a Victoria">
                    <div class="ops-col-head">
                        <div class="ops-col-route">
                            <span>Llera</span>
                            <span class="ops-col-mid">${ico("arrow-left-right", 16)}</span>
                            <span>Victoria</span>
                        </div>
                        <span class="ops-col-count">${right.length}</span>
                    </div>
                    <div class="ops-list" id="opsRight">
                        ${right.length ? right.map(opsRowTemplate).join("") : `<div class="horarios-empty-col">Sin horarios en este rumbo.</div>`}
                    </div>
                </section>
            </div>
        `;

        hint.textContent = "Listo.";
        statusText.textContent = `${left.length + right.length} horario(s)`;

        // bind events
        listEl.querySelectorAll(".ops-grid .slot-row").forEach(row => bindOpsRow(row, date));
        bindDisabledSummary();
    }

    /* -----------------------------
       Filas de salidas deshabilitadas (resumen dentro de Salidas)
    ----------------------------- */
    function disabledDayRowTemplate(r){
        const occ = occupancyMeta(r.used, r.capacity);
        return `
            <div class="slot-row day-cancelled is-${occ.tone}" data-templateid="${r.template_id}" data-tripdate="${escapeHtml(r.trip_date)}">
                <div class="slot-time mono">${escapeHtml(hhmm(r.depart_time))}</div>
                <div class="slot-body">
                    <div class="slot-top">
                        <span class="slot-status">${escapeHtml(dirLabel(r.direction))}</span>
                        <span class="slot-cap mono"><strong>${occ.u}</strong>/${occ.c}</span>
                    </div>
                    <div class="slot-meter" role="meter" aria-valuemin="0" aria-valuemax="${occ.c}" aria-valuenow="${occ.u}" style="--w:${occ.pct}%"><span></span></div>
                </div>
                <div class="slot-actions">
                    <button class="btn-mini btn-mini-primary enableBtn" type="button">${ico("check", 14)} Habilitar</button>
                </div>
            </div>
        `;
    }

    function disabledSummaryHtml(rows){
        if (!rows.length) return "";

        const byDate = new Map();
        rows.forEach(r => {
            if (!byDate.has(r.trip_date)) byDate.set(r.trip_date, []);
            byDate.get(r.trip_date).push(r);
        });

        const blocks = [];
        for (const [d, items] of byDate.entries()){
            blocks.push(`
                <div class="group-date">
                    <div class="group-title">
                        <span class="group-date-label">${escapeHtml(formatPrettyDate(d) || d)}</span>
                        <span class="ops-col-count">${items.length}</span>
                    </div>
                    ${items.map(disabledDayRowTemplate).join("")}
                </div>
            `);
        }

        return `
            <details class="ops-disabled">
                <summary>
                    ${ico("ban", 14)}
                    <strong>${rows.length}</strong> salida${rows.length === 1 ? "" : "s"} deshabilitada${rows.length === 1 ? "" : "s"} en los próximos 60 días
                    <span class="ops-disabled-hint">Ver y habilitar</span>
                </summary>
                <div class="ops-disabled-body">${blocks.join("")}</div>
            </details>
        `;
    }

    function bindDisabledSummary(){
        listEl.querySelectorAll(".ops-disabled .slot-row").forEach(row => {
            const templateId = Number(row.dataset.templateid);
            const tripDate = String(row.dataset.tripdate || "");
            const enableBtn = row.querySelector(".enableBtn");

            enableBtn?.addEventListener("click", async () => {
                enableBtn.disabled = true;
                statusText.textContent = "Habilitando…";

                const r = await apiPost("/admin/api/horarios/trip", {
                    trip_date: tripDate,
                    template_id: templateId,
                    enabled: true
                });

                enableBtn.disabled = false;

                if (!r?.ok){
                    statusText.textContent = "—";
                    safeNotify("No pude habilitar.", {variant:"danger", delay:2200});
                    return;
                }

                statusText.textContent = "Actualizado.";
                safeNotify("Salida habilitada.", {variant:"success", delay:1400});
                load();
            });
        });
    }

    /* -----------------------------
       TAB: Horarios base (CRUD)
    ----------------------------- */
    function templateRowTemplate(t){
        const active = Number(t.active) === 1;

        return `
            <div class="slot-row tpl-row ${active ? "" : "disabled-row"}" data-id="${t.id}">
                <div class="slot-time mono">${escapeHtml(hhmm(t.depart_time))}</div>
                <div class="slot-body">
                    <div class="tpl-fields">
                        <label class="tpl-field">
                            <span>Hora</span>
                            <input class="t-time" type="time" value="${escapeHtml(t.depart_time)}" aria-label="Hora plantilla ${t.id}">
                        </label>
                        <label class="tpl-field tpl-field-cap">
                            <span>Cupo <em>asientos</em></span>
                            <input class="t-cap" type="number" inputmode="numeric" min="0" max="${TEMPLATE_MAX_CAP}" step="1" value="${Number(t.capacity_passengers || 0)}" aria-label="Capacidad plantilla ${t.id}">
                        </label>
                    </div>
                </div>
                <div class="slot-actions">
                    <label class="switch" title="Activa o desactiva esta plantilla (se aplica al guardar)">
                        <span class="switch-text">Activa</span>
                        <input class="t-active" type="checkbox" ${active ? "checked" : ""}>
                    </label>
                    <button class="btn-mini btn-mini-primary t-save" type="button" disabled>${ico("check", 14)} Guardar</button>
                    <button class="btn-mini btn-mini-danger t-delete" type="button" title="Eliminar horario">${ico("trash-2", 14)} Eliminar</button>
                </div>
            </div>
        `;
    }

    async function loadTemplates(){
        const direction = directionEl.value;

        directionWrap.hidden = false;
        dateWrap.hidden = true;

        kDir.textContent = dirLabel(direction);
        setDateHeading("", "Plantillas");
        if (kDatePretty) kDatePretty.textContent = "Horarios base";

        hint.textContent = "Cargando horarios base…";
        statusText.textContent = "";

        const data = await apiGet(`/admin/api/templates?direction=${encodeURIComponent(direction)}&includeInactive=1`);
        if (!data?.ok){
            hint.textContent = "Error al cargar.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const rows = data.rows || [];
        bTemplates.textContent = String(rows.length);

        const addForm = `
            <div class="tpl-add" id="addForm">
                <div class="tpl-add-head">
                    <div>
                        <p class="tpl-add-title">${ico("plus", 14)} Nueva plantilla</p>
                        <p class="tpl-add-sub">Crea un horario base para la dirección elegida.</p>
                    </div>
                </div>
                <div class="row-form">
                    <div class="field">
                        <div class="mini">Dirección</div>
                        <select id="addDirection">
                            <option value="VIC_TO_LLE" ${direction==="VIC_TO_LLE"?"selected":""}>Victoria → Llera</option>
                            <option value="LLE_TO_VIC" ${direction==="LLE_TO_VIC"?"selected":""}>Llera → Victoria</option>
                        </select>
                    </div>
                    <div class="field">
                        <div class="mini">Hora</div>
                        <input id="addTime" type="time" value="06:30">
                    </div>
                    <div class="field field-cap">
                        <div class="mini">Cupo <em>asientos</em></div>
                        <input id="addCap" type="number" inputmode="numeric" min="0" max="${TEMPLATE_MAX_CAP}" step="1" value="14">
                    </div>
                    <div class="field field-active">
                        <div class="mini">Estado</div>
                        <select id="addActive">
                            <option value="1" selected>Activa</option>
                            <option value="0">Inactiva</option>
                        </select>
                    </div>
                    <button class="btn btn-wine" type="button" id="addBtn">${ico("plus", 16)} Agregar</button>
                </div>
            </div>
        `;

        const listBlock = rows.length
            ? `<div class="tpl-list">${rows.map(templateRowTemplate).join("")}</div>`
            : `<div class="horarios-empty-col">Aún no hay horarios base.</div>`;

        listEl.innerHTML = addForm + listBlock;

        hint.textContent = "Listo.";
        statusText.textContent = `${rows.length} base`;

        const addBtn = document.getElementById("addBtn");
        addBtn?.addEventListener("click", async () => {
            const dir = document.getElementById("addDirection").value;
            const time = document.getElementById("addTime").value;
            const cap = Number(document.getElementById("addCap").value || 0);
            const active = Number(document.getElementById("addActive").value || 1);

            if (!time) { safeNotify("Indica la hora.", {variant:"danger", delay:2300}); return; }
            if (!Number.isInteger(cap) || cap < 0 || cap > TEMPLATE_MAX_CAP) {
                safeNotify(`El cupo debe ser un entero entre 0 y ${TEMPLATE_MAX_CAP}.`, {variant:"danger", delay:2800});
                return;
            }

            addBtn.disabled = true;
            addBtn.classList.add("is-busy");
            statusText.textContent = "Agregando…";

            const r = await apiPost("/admin/api/templates/create", {
                direction: dir,
                depart_time: time,
                capacity_passengers: cap,
                active
            });

            addBtn.disabled = false;
            addBtn.classList.remove("is-busy");

            if (!r?.ok){
                statusText.textContent = "No se agregó";
                safeNotify(r?.message || "No pude agregar el horario.", {variant:"danger", delay:3500});
                return;
            }

            statusText.textContent = "Agregado.";
            safeNotify("Horario base agregado.", {variant:"success", delay:1500});
            load();
        });

        listEl.querySelectorAll(".slot-row[data-id]").forEach(row => {
            const id = Number(row.dataset.id);
            const timeEl = row.querySelector(".t-time");
            const capEl = row.querySelector(".t-cap");
            const activeEl = row.querySelector(".t-active");
            const saveBtn = row.querySelector(".t-save");

            // Guardar solo se habilita cuando hay cambios.
            const initial = { time: timeEl.value, cap: capEl.value, active: activeEl.checked };
            const syncDirty = () => {
                const dirty = timeEl.value !== initial.time || capEl.value !== initial.cap || activeEl.checked !== initial.active;
                row.classList.toggle("is-dirty", dirty);
                saveBtn.disabled = !dirty;
            };
            [timeEl, capEl].forEach((el) => el.addEventListener("input", syncDirty));
            activeEl.addEventListener("change", syncDirty);
            [timeEl, capEl].forEach((el) => el.addEventListener("keydown", (ev) => {
                if (ev.key === "Enter" && !saveBtn.disabled) saveBtn.click();
            }));

            saveBtn?.addEventListener("click", async () => {
                const capValue = Number(capEl.value);
                if (!timeEl.value) { safeNotify("Indica la hora.", {variant:"danger", delay:2300}); return; }
                if (!Number.isInteger(capValue) || capValue < 0 || capValue > TEMPLATE_MAX_CAP) {
                    safeNotify(`El cupo debe ser un entero entre 0 y ${TEMPLATE_MAX_CAP}.`, {variant:"danger", delay:2800});
                    return;
                }

                saveBtn.disabled = true;
                saveBtn.classList.add("is-busy");
                statusText.textContent = "Guardando…";

                const r = await apiPost("/admin/api/templates/update", {
                    id,
                    direction: directionEl.value,
                    depart_time: timeEl.value,
                    capacity_passengers: Number(capEl.value || 0),
                    active: activeEl.checked ? 1 : 0
                });

                saveBtn.classList.remove("is-busy");

                if (!r?.ok){
                    saveBtn.disabled = false;
                    statusText.textContent = "No se guardó";
                    safeNotify(r?.message || "No pude guardar.", {variant:"danger", delay:3500});
                    return;
                }

                statusText.textContent = "Guardado";
                safeNotify(`Horario de las ${hhmm(timeEl.value)} guardado.`, {variant:"success", delay:2200});
                load();
            });

            row.querySelector(".t-delete")?.addEventListener("click", async () => {
                const label = hhmm(initial.time);
                const deleted = await Confirm.ask({
                    title: `Eliminar el horario de las ${label}`,
                    message: "Se borrará el horario base y sus salidas ya creadas. Esta acción no se puede deshacer. Si ya tiene reservas, no se podrá eliminar: desactívalo en su lugar.",
                    confirmText: "Eliminar",
                    tone: "danger",
                    action: async () => {
                        statusText.textContent = "Eliminando…";
                        const r = await apiPost("/admin/api/templates/delete", { id });
                        if (!r?.ok) {
                            statusText.textContent = "No se eliminó";
                            return { ok: false, message: r?.message || "No pude eliminar el horario." };
                        }
                        return { ok: true };
                    }
                });

                if (!deleted) return;
                statusText.textContent = "Eliminado.";
                safeNotify(`Horario de las ${label} eliminado.`, {variant:"success", delay:2200});
                load();
            });
        });
    }

    /* -----------------------------
       Router UI
    ----------------------------- */
    function setActiveTab(tab){
        currentTab = tab || "ops";
        tabsEl?.querySelectorAll(".tabbtn").forEach(btn => {
            const on = btn.dataset.tab === currentTab;
            btn.classList.toggle("is-active", on);
            btn.setAttribute("aria-selected", on ? "true" : "false");
        });
        load();
    }

    async function load(){
        if (currentTab === "ops") return loadOps();
        if (currentTab === "templates") return loadTemplates();
        return loadOps();
    }

    tabsEl?.addEventListener("click", (e) => {
        const btn = e.target.closest(".tabbtn");
        if (!btn) return;
        setActiveTab(btn.dataset.tab);
    });

    // cambio de fecha => refresca ops
    tripDateEl?.addEventListener("change", () => {
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    // dirección solo afecta tabs que la usan
    directionEl?.addEventListener("change", () => {
        if (currentTab !== "ops") load();
    });

    loadBtn?.addEventListener("click", load);

    prevDay?.addEventListener("click", () => {
        const current = tripDateEl.value || todayISO();
        tripDateEl.value = addDaysISO(current, -1);
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    nextDay?.addEventListener("click", () => {
        const current = tripDateEl.value || todayISO();
        tripDateEl.value = addDaysISO(current, 1);
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    document.querySelectorAll("#directionWrap [data-dir]").forEach((btn) => {
        btn.addEventListener("click", () => {
            if (!directionEl) return;
            directionEl.value = btn.dataset.dir;
            syncDirectionChips();
            if (currentTab !== "ops") load();
        });
    });

    if (!tripDateEl.value) tripDateEl.value = todayISO();
    setDateHeading(tripDateEl.value, "Hoy");
    kDir.textContent = "Ambas direcciones";
    syncDirectionChips();

    load();
</script>
</body>
</html>
