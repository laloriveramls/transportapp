<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Admin horarios',
    description: 'Panel para administrar horarios y salidas.',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-horarios">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Horarios', tag: 'Plantillas, cupos y precios' }) %>

<main class="home-main admin-main">
<section class="container">
    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Administración de horarios</h2>
            <div class="home-tabs-tools">
                <%- include('partials/admin-nav', { adminNav: 'horarios' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="horarios-toolbar">
        <div class="horarios-toolbar-top">
            <div class="horarios-date-block">
                <div class="horarios-kicker">
                    <%- include('partials/icon', { name: 'calendar', size: 16 }) %>
                    <span id="kickerText">Horarios</span>
                </div>
                <div class="horarios-date-label" id="kDatePretty">—</div>
                <div class="horarios-date-meta subtle" id="kDir">—</div>
            </div>

            <div class="horarios-toolbar-form">
                <div id="dateWrap" class="horarios-day-nav">
                    <button type="button" class="horarios-day-arrow" id="prevDay" title="Día anterior" aria-label="Ir al día anterior"><%- include('partials/icon', { name: 'arrow-left', size: 16 }) %></button>
                    <span class="horarios-date-input">
                        <span class="horarios-date-fake" id="dateFake" aria-hidden="true">—</span>
                        <input id="trip_date" type="date" class="form-control" aria-label="Fecha">
                    </span>
                    <button type="button" class="horarios-day-arrow" id="nextDay" title="Día siguiente" aria-label="Ir al día siguiente"><%- include('partials/icon', { name: 'arrow-right', size: 16 }) %></button>
                </div>

                <div id="directionWrap" class="horarios-dir" hidden>
                    <select id="direction" class="visually-hidden" aria-label="Dirección">
                        <option value="VIC_TO_LLE">Victoria → Llera</option>
                        <option value="LLE_TO_VIC">Llera → Victoria</option>
                    </select>
                    <button type="button" class="horarios-chip is-on" data-dir="VIC_TO_LLE">Victoria → Llera</button>
                    <button type="button" class="horarios-chip" data-dir="LLE_TO_VIC">Llera → Victoria</button>
                </div>

                <button id="loadBtn" class="btn btn-wine" type="button">Cargar</button>
            </div>
        </div>

        <div class="horarios-tabs-bar">
            <div class="tabs-panel">
                <div class="tabs" id="tabs">
                    <button type="button" class="tabbtn is-active" data-tab="ops" title="Operación por fecha">
                        Operación <span class="badge" id="bOps">—</span>
                    </button>
                    <button type="button" class="tabbtn" data-tab="disabled_day" title="Desactivar salidas por día">
                        Por día <span class="badge" id="bDisabledDay">—</span>
                    </button>
                    <button type="button" class="tabbtn" data-tab="templates" title="Configuración de horarios base">
                        Plantillas <span class="badge" id="bTemplates">—</span>
                    </button>
                    <button type="button" class="tabbtn" data-tab="pricing" title="Precios pasaje y paquetería">
                        Precios <span class="badge" id="bPricing">—</span>
                    </button>
                </div>
            </div>
            <div class="horarios-status">
                <span class="status-pill" id="statusText">—</span>
            </div>
        </div>
    </div>

    <div class="slots-wrap">
        <p class="hint" id="hint">Selecciona pestaña.</p>
        <div id="list"></div>
    </div>

        </div>
    </div>
</section>
</main>

<%- include('partials/toast') %>
<%- include('partials/admin-footer') %>
<%- include('partials/footer') %>

<script>
    const tripDateEl = document.getElementById("trip_date");
    const directionEl = document.getElementById("direction");
    const loadBtn = document.getElementById("loadBtn");
    const listEl = document.getElementById("list");

    const kDatePretty = document.getElementById("kDatePretty");
    const dateFake = document.getElementById("dateFake");
    const kickerText = document.getElementById("kickerText");
    const prevDay = document.getElementById("prevDay");
    const nextDay = document.getElementById("nextDay");
    const kDir = document.getElementById("kDir");
    const hint = document.getElementById("hint");
    const statusText = document.getElementById("statusText");
    const dateWrap = document.getElementById("dateWrap");
    const directionWrap = document.getElementById("directionWrap");

    const tabsEl = document.getElementById("tabs");
    const bOps = document.getElementById("bOps");
    const bDisabledDay = document.getElementById("bDisabledDay");
    const bTemplates = document.getElementById("bTemplates");
    const bPricing = document.getElementById("bPricing");

    let currentTab = "ops";

    function ico(name, size) {
        return (window.Icons && typeof window.Icons.svg === "function")
            ? window.Icons.svg(name, { size: size || 14 })
            : "";
    }

    function todayISO(){
        return new Date().toLocaleDateString("en-CA", { timeZone: "America/Monterrey" });
    }

    function addDaysISO(dateISO, days){
        const d = new Date(`${dateISO}T00:00:00`);
        d.setDate(d.getDate() + Number(days || 0));
        return d.toLocaleDateString("en-CA", { timeZone: "America/Monterrey" });
    }

    function dirLabel(d){
        return d === "VIC_TO_LLE" ? "Victoria → Llera" : "Llera → Victoria";
    }

    function formatPrettyDate(iso){
        const s = String(iso || "").trim();
        if (!s) return "";
        try {
            const d = new Date(`${s}T12:00:00`);
            if (isNaN(d.getTime())) return s;
            const raw = new Intl.DateTimeFormat("es-MX", {
                weekday: "long",
                day: "numeric",
                month: "long",
            }).format(d);
            return raw.charAt(0).toUpperCase() + raw.slice(1);
        } catch {
            return s;
        }
    }

    function formatDateShort(iso){
        const parts = String(iso || "").split("-");
        if (parts.length !== 3) return String(iso || "");
        return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function setDateHeading(iso, kicker){
        const pretty = formatPrettyDate(iso);
        if (kDatePretty) kDatePretty.textContent = pretty || iso || "—";
        if (dateFake) dateFake.textContent = formatDateShort(iso) || "—";
        if (kickerText) kickerText.textContent = kicker || "Horarios";
    }

    function hhmm(t){
        return String(t || "").slice(0, 5);
    }

    function occupancyMeta(used, cap){
        const c = Math.min(6, Math.max(0, Number(cap) || 0));
        const u = Math.min(c, Number(used) || 0);
        const remaining = Math.max(0, c - u);
        const pct = c > 0 ? Math.min(100, Math.round((u / c) * 100)) : 0;
        let tone = "empty";
        if (c > 0 && u >= c) tone = "full";
        else if (u > 0 && remaining <= 2) tone = "tight";
        else if (u > 0) tone = "ok";
        let status = "Vacía";
        if (tone === "full") status = "Llena";
        else if (tone === "tight" || tone === "ok") status = remaining + (remaining === 1 ? " libre" : " libres");
        let seats = "";
        for (let i = 0; i < c; i++) {
            seats += `<span class="slot-seat${i < u ? " is-on" : ""}"></span>`;
        }
        return { c, u, remaining, pct, tone, status, seats };
    }

    function syncDirectionChips(){
        const current = directionEl?.value || "VIC_TO_LLE";
        document.querySelectorAll(".horarios-chip[data-dir]").forEach((btn) => {
            btn.classList.toggle("is-on", btn.dataset.dir === current);
        });
    }

    function tagByAvailability(avail){
        const n = Number(avail || 0);
        if (n <= 0) return "tag-bad";
        if (n <= 2) return "tag-warn";
        return "tag-ok";
    }

    function escapeHtml(s){
        return String(s || "").replace(/[&<>"']/g, m => ({
            "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"
        }[m]));
    }

    async function apiGet(url){
        const res = await fetch(url);
        return res.json();
    }

    async function apiPost(url, body){
        const res = await fetch(url, {
            method: "POST",
            headers: {"Content-Type":"application/json"},
            body: JSON.stringify(body)
        });
        return res.json();
    }

    /* -----------------------------
       OPS (2 columnas)
    ----------------------------- */
    function opsRowTemplate(r) {
        const disabledBecauseTemplate = !r.template_active;
        const tripEnabled = (String(r.trip_status || "OPEN").toUpperCase() === "OPEN");
        const dayCancelledClass = (!tripEnabled && !disabledBecauseTemplate) ? "day-cancelled" : "";
        const occ = occupancyMeta(r.used, r.capacity);
        const time = hhmm(r.depart_time);

        return `
            <div class="slot-row is-${occ.tone} ${disabledBecauseTemplate ? "disabled-row" : ""} ${dayCancelledClass}"
                 data-templateid="${r.template_id}"
                 data-direction="${escapeHtml(r.direction)}"
                 data-depart="${escapeHtml(r.depart_time)}"
                 data-capacity="${Number(r.capacity || 0)}"
                 data-used="${Number(r.used || 0)}">
                <div class="slot-time mono">${escapeHtml(time)}</div>
                <div class="slot-body">
                    <div class="slot-top">
                        <span class="slot-status">${occ.status}</span>
                        <span class="slot-cap mono">${occ.u}/${occ.c}</span>
                    </div>
                    <div class="slot-meter" style="--w:${occ.pct}%"><span></span></div>
                    <span class="slot-seats" aria-hidden="true">${occ.seats}</span>
                </div>
                <div class="slot-actions">
                    <label class="switch" title="Desactivar por completo (horario base)">
                        <span>Base</span>
                        <input class="template-toggle" type="checkbox" ${r.template_active ? "checked" : ""}>
                    </label>
                    <label class="switch" title="Desactivar por día (solo esta fecha)">
                        <span>Día</span>
                        <input class="trip-toggle" type="checkbox"
                               ${tripEnabled ? "checked" : ""}
                               ${disabledBecauseTemplate ? "disabled" : ""}>
                    </label>
                </div>
            </div>
        `;
    }

    function bindOpsRow(rowEl, date) {
        const templateId = Number(rowEl.dataset.templateid);
        const rowDir = String(rowEl.dataset.direction || "");
        const depart = String(rowEl.dataset.depart || "");
        const capacity = Number(rowEl.dataset.capacity || 0);

        const templateToggle = rowEl.querySelector(".template-toggle");
        const tripToggle = rowEl.querySelector(".trip-toggle");

        templateToggle?.addEventListener("change", async () => {
            templateToggle.disabled = true;
            const active = templateToggle.checked;

            statusText.textContent = "Guardando (base)…";

            const r = await apiPost("/admin/api/templates/update", {
                id: templateId,
                direction: rowDir,
                depart_time: depart,
                capacity_passengers: capacity || 6,
                active: active ? 1 : 0
            });

            templateToggle.disabled = false;

            if (!r?.ok) {
                templateToggle.checked = !active;
                statusText.textContent = "—";
                notify("No pude actualizar el horario base.", {variant: "danger", delay: 2200});
                return;
            }

            statusText.textContent = "Actualizado.";
            notify("Horario base actualizado.", {variant: "success", delay: 1400});
            // aquí sí recargamos tab para reflejar locks/disabled
            load();
        });

        // ✅ Mejora 1 + 2: confirmación inteligente + refrescar SOLO fila
        tripToggle?.addEventListener("change", async () => {
            const enabled = tripToggle.checked;

            // confirmación inteligente al DESHABILITAR si hay usados
            if (!enabled) {
                const used = Number(rowEl.dataset.used || 0);
                if (used > 0) {
                    const ok = confirm(`Hay ${used} asiento(s) usados en este horario.\n\n¿Seguro que deseas DESHABILITAR este día?`);
                    if (!ok) {
                        tripToggle.checked = true;
                        return;
                    }
                }
            }

            tripToggle.disabled = true;
            statusText.textContent = enabled ? "Habilitando…" : "Deshabilitando…";

            const resp = await apiPost("/admin/api/horarios/trip", {
                trip_date: date,
                template_id: templateId,
                enabled
            });

            tripToggle.disabled = false;

            if (!resp?.ok) {
                tripToggle.checked = !enabled;
                statusText.textContent = "—";
                notify("No pude actualizar el horario del día.", {variant: "danger", delay: 2200});
                return;
            }

            if (!enabled) {
                const c = Number(resp.cancelledReservations || 0);
                const p = Number(resp.rejectedPayments || 0);
                if (c || p) {
                    notify(`Deshabilitado. Cancelé ${c} reserva(s) y rechacé ${p} pago(s) pendiente(s).`, {
                        variant: "success",
                        delay: 2400
                    });
                } else {
                    notify("Deshabilitado para ese día.", {variant: "success", delay: 1600});
                }
            } else {
                notify("Habilitado para ese día.", {variant: "success", delay: 1600});
            }

            statusText.textContent = "Actualizado.";

            // refresco solo la fila (sin load completo)
            await refreshOpsRow(templateId, date, rowDir);
        });
    }

    async function refreshOpsRow(templateId, date, direction) {
        const data = await apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent(direction)}`);
        if (!data?.ok) return;

        const rowData = (data.rows || []).find(x => Number(x.template_id) === Number(templateId));
        if (!rowData) return;

        const old = listEl.querySelector(`.slot-row[data-templateid="${templateId}"]`);
        if (!old) return;

        const tmp = document.createElement("div");
        tmp.innerHTML = opsRowTemplate(rowData);
        const fresh = tmp.firstElementChild;

        old.replaceWith(fresh);
        bindOpsRow(fresh, date);
    }

    async function loadOps() {
        const date = tripDateEl.value;

        // ops: uso ambas direcciones; oculto selector dirección
        directionWrap.hidden = true;
        dateWrap.hidden = false;

        kDir.textContent = "Ambas direcciones";
        setDateHeading(date, date === todayISO() ? "Hoy" : "Operación");

        if (!date) {
            hint.textContent = "Selecciona una fecha.";
            listEl.innerHTML = "";
            return;
        }

        hint.textContent = "Cargando…";
        statusText.textContent = "";

        const [a, b] = await Promise.all([
            apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent("VIC_TO_LLE")}`),
            apiGet(`/admin/api/horarios?date=${encodeURIComponent(date)}&direction=${encodeURIComponent("LLE_TO_VIC")}`)
        ]);

        if (!a?.ok || !b?.ok) {
            hint.textContent = "Error al cargar.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const left = a.rows || [];
        const right = b.rows || [];

        bOps.textContent = String(left.length + right.length);

        listEl.innerHTML = `
            <div class="ops-grid">
                <section class="ops-col" aria-label="Victoria a Llera">
                    <div class="ops-col-head">
                        <div class="ops-col-route">
                            <span>Victoria</span>
                            <span class="ops-col-mid">${ico("arrow-left-right", 16)}</span>
                            <span>Llera</span>
                        </div>
                        <span class="ops-col-count">${left.length}</span>
                    </div>
                    <div class="ops-list" id="opsLeft">
                        ${left.length ? left.map(opsRowTemplate).join("") : `<div class="horarios-empty-col">Sin horarios en este rumbo.</div>`}
                    </div>
                </section>
                <section class="ops-col" aria-label="Llera a Victoria">
                    <div class="ops-col-head">
                        <div class="ops-col-route">
                            <span>Llera</span>
                            <span class="ops-col-mid">${ico("arrow-left-right", 16)}</span>
                            <span>Victoria</span>
                        </div>
                        <span class="ops-col-count">${right.length}</span>
                    </div>
                    <div class="ops-list" id="opsRight">
                        ${right.length ? right.map(opsRowTemplate).join("") : `<div class="horarios-empty-col">Sin horarios en este rumbo.</div>`}
                    </div>
                </section>
            </div>
        `;

        hint.textContent = "Listo.";
        statusText.textContent = `${left.length + right.length} horario(s)`;

        // bind events
        listEl.querySelectorAll(".slot-row").forEach(row => bindOpsRow(row, date));
    }

    /* -----------------------------
       TAB: Desactivar por día (lista global)
    ----------------------------- */
    function disabledDayRowTemplate(r){
        const occ = occupancyMeta(r.used, r.capacity);
        return `
            <div class="slot-row day-cancelled is-${occ.tone}" data-templateid="${r.template_id}" data-tripdate="${escapeHtml(r.trip_date)}">
                <div class="slot-time mono">${escapeHtml(hhmm(r.depart_time))}</div>
                <div class="slot-body">
                    <div class="slot-top">
                        <span class="slot-status">${escapeHtml(dirLabel(r.direction))}</span>
                        <span class="slot-cap mono">${occ.u}/${occ.c}</span>
                    </div>
                    <div class="slot-meter" style="--w:${occ.pct}%"><span></span></div>
                    <span class="slot-seats" aria-hidden="true">${occ.seats}</span>
                </div>
                <div class="slot-actions">
                    <button class="btn-mini enableBtn" type="button">Habilitar</button>
                </div>
            </div>
        `;
    }

    async function loadDisabledDay(){
        const direction = directionEl.value;

        directionWrap.hidden = false;
        dateWrap.hidden = true;

        const from = todayISO();
        const to = addDaysISO(from, 60);

        kDir.textContent = dirLabel(direction);
        setDateHeading("", "Por día");
        if (kDatePretty) kDatePretty.textContent = "Próximos 60 días";

        hint.textContent = "Cargando cancelados…";
        statusText.textContent = "";

        const data = await apiGet(`/admin/api/horarios/disabled-days?direction=${encodeURIComponent(direction)}&from=${encodeURIComponent(from)}&to=${encodeURIComponent(to)}`);
        if (!data?.ok){
            hint.textContent = "Error al cargar.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const rows = data.rows || [];
        bDisabledDay.textContent = String(rows.length);

        if (!rows.length){
            listEl.innerHTML = `<div class="muted mt-3">No hay horarios desactivados por día en el rango.</div>`;
            hint.textContent = "Listo.";
            statusText.textContent = "0";
            return;
        }

        const map = new Map();
        rows.forEach(r => {
            if (!map.has(r.trip_date)) map.set(r.trip_date, []);
            map.get(r.trip_date).push(r);
        });

        const blocks = [];
        for (const [d, items] of map.entries()){
            blocks.push(`
                <div class="group-date">
                    <div class="group-title">
                        <span class="group-date-label">${escapeHtml(formatPrettyDate(d) || d)}</span>
                        <span class="ops-col-count">${items.length}</span>
                    </div>
                    ${items.map(disabledDayRowTemplate).join("")}
                </div>
            `);
        }

        listEl.innerHTML = blocks.join("");
        hint.textContent = "Listo.";
        statusText.textContent = `${rows.length} cancelado(s)`;

        listEl.querySelectorAll(".slot-row").forEach(row => {
            const templateId = Number(row.dataset.templateid);
            const tripDate = String(row.dataset.tripdate || "");
            const enableBtn = row.querySelector(".enableBtn");

            enableBtn?.addEventListener("click", async () => {
                enableBtn.disabled = true;
                statusText.textContent = "Habilitando…";

                const r = await apiPost("/admin/api/horarios/trip", {
                    trip_date: tripDate,
                    template_id: templateId,
                    enabled: true
                });

                enableBtn.disabled = false;

                if (!r?.ok){
                    statusText.textContent = "—";
                    notify("No pude habilitar.", {variant:"danger", delay:2200});
                    return;
                }

                statusText.textContent = "Actualizado.";
                notify("Horario habilitado.", {variant:"success", delay:1400});
                load();
            });
        });
    }

    /* -----------------------------
       TAB: Horarios base (CRUD)
    ----------------------------- */
    function templateRowTemplate(t){
        const active = Number(t.active) === 1;

        return `
            <div class="slot-row tpl-row ${active ? "" : "disabled-row"}" data-id="${t.id}">
                <div class="slot-time mono">${escapeHtml(hhmm(t.depart_time))}</div>
                <div class="slot-body">
                    <div class="slot-top">
                        <span class="slot-status">Plantilla #${t.id}</span>
                        <span class="slot-cap">${active ? "Activa" : "Inactiva"}</span>
                    </div>
                    <div class="tpl-fields">
                        <label class="tpl-field">
                            <span>Hora</span>
                            <input class="t-time" type="time" value="${escapeHtml(t.depart_time)}">
                        </label>
                        <label class="tpl-field">
                            <span>Capacidad</span>
                            <input class="t-cap" type="number" min="0" max="6" value="${Number(t.capacity_passengers || 0)}">
                        </label>
                    </div>
                </div>
                <div class="slot-actions">
                    <label class="switch" title="Desactivar por completo">
                        <span>Activo</span>
                        <input class="t-active" type="checkbox" ${active ? "checked" : ""}>
                    </label>
                    <button class="btn-mini t-save" type="button">Guardar</button>
                    <button class="btn-mini t-disable" type="button">Desactivar</button>
                </div>
            </div>
        `;
    }

    async function loadTemplates(){
        const direction = directionEl.value;

        directionWrap.hidden = false;
        dateWrap.hidden = true;

        kDir.textContent = dirLabel(direction);
        setDateHeading("", "Plantillas");
        if (kDatePretty) kDatePretty.textContent = "Horarios base";

        hint.textContent = "Cargando horarios base…";
        statusText.textContent = "";

        const data = await apiGet(`/admin/api/templates?direction=${encodeURIComponent(direction)}&includeInactive=1`);
        if (!data?.ok){
            hint.textContent = "Error al cargar.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const rows = data.rows || [];
        bTemplates.textContent = String(rows.length);

        const addForm = `
            <div class="row-form" id="addForm">
                <div class="field">
                    <div class="mini">Dirección</div>
                    <select id="addDirection">
                        <option value="VIC_TO_LLE" ${direction==="VIC_TO_LLE"?"selected":""}>Victoria → Llera</option>
                        <option value="LLE_TO_VIC" ${direction==="LLE_TO_VIC"?"selected":""}>Llera → Victoria</option>
                    </select>
                </div>
                <div class="field">
                    <div class="mini">Hora</div>
                    <input id="addTime" type="time" value="06:30">
                </div>
                <div class="field">
                    <div class="mini">Cap (0–6)</div>
                    <input id="addCap" type="number" min="0" max="6" value="6">
                </div>
                <div class="field">
                    <div class="mini">Activo</div>
                    <select id="addActive">
                        <option value="1" selected>Sí</option>
                        <option value="0">No</option>
                    </select>
                </div>
                <button class="btn btn-wine" type="button" id="addBtn">Agregar</button>
                <div class="muted">Tip: esto crea un horario base nuevo para esa dirección.</div>
            </div>
        `;

        listEl.innerHTML = addForm + (rows.length ? rows.map(templateRowTemplate).join("") : `<div class="muted mt-3">Aún no hay horarios base.</div>`);

        hint.textContent = "Listo.";
        statusText.textContent = `${rows.length} base`;

        const addBtn = document.getElementById("addBtn");
        addBtn?.addEventListener("click", async () => {
            const dir = document.getElementById("addDirection").value;
            const time = document.getElementById("addTime").value;
            const cap = Number(document.getElementById("addCap").value || 0);
            const active = Number(document.getElementById("addActive").value || 1);

            addBtn.disabled = true;
            statusText.textContent = "Agregando…";

            const r = await apiPost("/admin/api/templates/create", {
                direction: dir,
                depart_time: time,
                capacity_passengers: cap,
                active
            });

            addBtn.disabled = false;

            if (!r?.ok){
                statusText.textContent = "—";
                notify(r?.message || "No pude agregar el horario.", {variant:"danger", delay:2300});
                return;
            }

            statusText.textContent = "Agregado.";
            notify("Horario base agregado.", {variant:"success", delay:1500});
            load();
        });

        listEl.querySelectorAll(".slot-row[data-id]").forEach(row => {
            const id = Number(row.dataset.id);
            const timeEl = row.querySelector(".t-time");
            const capEl = row.querySelector(".t-cap");
            const activeEl = row.querySelector(".t-active");
            const saveBtn = row.querySelector(".t-save");
            const disableBtn = row.querySelector(".t-disable");

            saveBtn?.addEventListener("click", async () => {
                saveBtn.disabled = true;
                statusText.textContent = "Guardando…";

                const r = await apiPost("/admin/api/templates/update", {
                    id,
                    direction: directionEl.value,
                    depart_time: timeEl.value,
                    capacity_passengers: Number(capEl.value || 0),
                    active: activeEl.checked ? 1 : 0
                });

                saveBtn.disabled = false;

                if (!r?.ok){
                    statusText.textContent = "—";
                    notify(r?.message || "No pude guardar.", {variant:"danger", delay:2300});
                    return;
                }

                statusText.textContent = "Actualizado.";
                notify("Horario base actualizado.", {variant:"success", delay:1500});
                load();
            });

            disableBtn?.addEventListener("click", async () => {
                disableBtn.disabled = true;
                statusText.textContent = "Desactivando…";

                const r = await apiPost("/admin/api/templates/disable", { id });

                disableBtn.disabled = false;

                if (!r?.ok){
                    statusText.textContent = "—";
                    notify("No pude desactivar.", {variant:"danger", delay:2300});
                    return;
                }

                statusText.textContent = "Desactivado.";
                notify("Horario base desactivado.", {variant:"success", delay:1500});
                load();
            });
        });
    }

    /* -----------------------------
       TAB: Precios
    ----------------------------- */
    async function loadPricing(){
        directionWrap.hidden = false;
        dateWrap.hidden = true;

        kDir.textContent = "Tarifas";
        setDateHeading("", "Precios");
        if (kDatePretty) kDatePretty.textContent = "Pasaje y paquetería";

        hint.textContent = "Cargando precios…";
        statusText.textContent = "";

        const data = await apiGet("/admin/api/pricing");
        if (!data?.ok){
            hint.textContent = "Error al cargar precios.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        bPricing.innerHTML = ico("check", 12);

        const passenger = Number(data.passenger_price_mxn || 0).toFixed(2);
        const pkg = Number(data.package_price_mxn || 0).toFixed(2);
        const child = Number(data.child_price_mxn ?? (Number(data.passenger_price_mxn || 0) / 2)).toFixed(2);
        const updated = data.updated_at ? String(data.updated_at) : "—";

        listEl.innerHTML = `
            <div class="row-form">
                <div class="field">
                    <div class="mini">Precio Pasajero (MXN)</div>
                    <input id="pPassenger" type="number" step="0.01" min="0" value="${passenger}">
                </div>
                <div class="field">
                    <div class="mini">Precio Niño 6-10 (MXN)</div>
                    <input id="pChild" type="number" step="0.01" min="0" value="${child}">
                </div>
                <div class="field">
                    <div class="mini">Precio Paquetería (MXN)</div>
                    <input id="pPackage" type="number" step="0.01" min="0" value="${pkg}">
                </div>

                <button class="btn btn-wine" type="button" id="savePricingBtn">Guardar</button>
                <div class="muted">Última actualización: ${escapeHtml(updated)}</div>
            </div>

        `;

        hint.textContent = "Listo.";
        statusText.textContent = "Precios";

        const btn = document.getElementById("savePricingBtn");
        btn?.addEventListener("click", async () => {
            btn.disabled = true;
            statusText.textContent = "Guardando precios…";

            const passengerPrice = Number(document.getElementById("pPassenger").value || 0);
            const childPrice = Number(document.getElementById("pChild").value || 0);
            const packagePrice = Number(document.getElementById("pPackage").value || 0);

            const r = await apiPost("/admin/api/pricing", {
                passenger_price_mxn: passengerPrice,
                child_price_mxn: childPrice,
                package_price_mxn: packagePrice
            });

            btn.disabled = false;

            if (!r?.ok){
                statusText.textContent = "—";
                notify("No pude guardar precios.", {variant:"danger", delay:2200});
                return;
            }

            statusText.textContent = "Precios guardados.";
            notify("Precios guardados.", {variant:"success", delay:1500});
            load();
        });
    }

    /* -----------------------------
       Router UI
    ----------------------------- */
    function setActiveTab(tab){
        currentTab = tab || "ops";
        tabsEl?.querySelectorAll(".tabbtn").forEach(btn => {
            btn.classList.toggle("is-active", btn.dataset.tab === currentTab);
        });
        load();
    }

    async function load(){
        if (currentTab === "ops") return loadOps();
        if (currentTab === "disabled_day") return loadDisabledDay();
        if (currentTab === "templates") return loadTemplates();
        if (currentTab === "pricing") return loadPricing();
        return loadOps();
    }

    tabsEl?.addEventListener("click", (e) => {
        const btn = e.target.closest(".tabbtn");
        if (!btn) return;
        setActiveTab(btn.dataset.tab);
    });

    // cambio de fecha => refresca ops
    tripDateEl?.addEventListener("change", () => {
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    // dirección solo afecta tabs que la usan
    directionEl?.addEventListener("change", () => {
        if (currentTab !== "ops") load();
    });

    loadBtn?.addEventListener("click", load);

    prevDay?.addEventListener("click", () => {
        const current = tripDateEl.value || todayISO();
        tripDateEl.value = addDaysISO(current, -1);
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    nextDay?.addEventListener("click", () => {
        const current = tripDateEl.value || todayISO();
        tripDateEl.value = addDaysISO(current, 1);
        setDateHeading(tripDateEl.value, tripDateEl.value === todayISO() ? "Hoy" : "Operación");
        if (currentTab === "ops") load();
    });

    document.querySelectorAll(".horarios-chip[data-dir]").forEach((btn) => {
        btn.addEventListener("click", () => {
            if (!directionEl) return;
            directionEl.value = btn.dataset.dir;
            syncDirectionChips();
            if (currentTab !== "ops") load();
        });
    });

    if (!tripDateEl.value) tripDateEl.value = todayISO();
    setDateHeading(tripDateEl.value, "Hoy");
    kDir.textContent = "Ambas direcciones";
    syncDirectionChips();

    load();
</script>
</body>
</html>
