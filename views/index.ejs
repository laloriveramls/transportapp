<!doctype html>
<html lang="es-MX" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Transporte Victoria ↔ Llera | Pasaje y paquetería',
    description: 'Reserva pasaje y paquetería entre Ciudad Victoria y Llera de Canales, Tamaulipas. Horarios diarios, 6 asientos y paradas en ejidos.',
    canonicalUrl: (typeof baseUrl !== 'undefined' ? String(baseUrl).replace(/\/+$/, '') : 'https://serviciodetransportevic.com') + '/'
    }) %>

    <link rel="preload" as="image" href="/assets/logo-hero.png">
    <link rel="preload" as="image" href="/assets/hero-road.jpg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/css/home.css" rel="stylesheet">
</head>

<body class="home-page">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<section class="home-hero" aria-label="Inicio">
    <div class="home-hero-media" role="img" aria-label="Carretera hacia el destino"></div>
    <div class="home-hero-veil" aria-hidden="true"></div>

    <div class="container home-hero-inner">
        <div class="home-brand home-reveal">
            <div class="logo-wrap">
                <img class="home-brand-logo" src="/assets/logo-hero.png" alt="Servicio de Transporte Victoria Llera" width="308" height="348" decoding="async" fetchpriority="high">
                <button type="button" id="adminHotspot" class="admin-hotspot" aria-label="Admin (oculto)"></button>
            </div>
            <div class="home-brand-copy">
                <p class="home-kicker">Victoria - Llera</p>
                <h1 class="home-brand-name">Servicio de Transporte</h1>
                <p class="home-brand-tag">Seis asientos · Pasaje y paquetería · Reserva en minutos</p>
            </div>
        </div>

        <div class="hero-actions home-reveal home-reveal-delay">
            <a class="btn btn-wine home-cta-primary" href="/reserve">
                <span class="btn-ico"><%- include('partials/icon', { name: 'calendar', size: 20 }) %></span>
                Reservar
            </a>
            <a class="btn home-cta-ghost" target="_blank" rel="noopener noreferrer"
               href="https://wa.me/52<%= ('8344756376').replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hola, quiero información del servicio de transporte.') %>">
                <span class="btn-ico"><%- include('partials/icon', { name: 'message-circle', size: 20 }) %></span>
                WhatsApp
            </a>
        </div>
    </div>
</section>

<main class="home-main">
    <section class="home-section container" id="horarios" aria-label="Horarios y ubicación">
        <div class="tabs-card home-tabs">
            <div class="home-tabs-head">
                <h2 id="horarios-heading" class="home-section-title">Horarios y ubicación</h2>
                <div class="home-tabs-tools">
                    <ul class="nav nav-tabs home-seg" id="homeTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="tab-horarios" type="button" role="tab"
                                    data-home-tab="horarios" aria-controls="pane-horarios" aria-selected="true">Horarios</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-mapa" type="button" role="tab"
                                    data-home-tab="mapa" aria-controls="pane-mapa" aria-selected="false">Mapa</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="tab-info" type="button" role="tab"
                                    data-home-tab="info" aria-controls="pane-info" aria-selected="false">Info</button>
                        </li>
                    </ul>
                </div>
                <a class="home-tabs-wa" href="tel:+528344756376" title="Llamar al 834 475 6376">
                    <span class="home-tabs-wa-ico" aria-hidden="true"><%- include('partials/icon', { name: 'phone', size: 16 }) %></span>
                    <span class="home-tabs-wa-phone">834 475 6376</span>
                </a>
            </div>

            <div class="home-tabs-body">
                <div class="home-pane is-active" id="pane-horarios" role="tabpanel" aria-labelledby="tab-horarios">
                    <div class="schedule-board" id="nextCard">
                        <% const v2l = templates.filter(t => t.direction === 'VIC_TO_LLE'); %>
                        <article class="schedule-row">
                            <div class="schedule-row-main">
                                <div class="schedule-route">
                                    <span class="visually-hidden">De Ciudad Victoria hacia Llera</span>
                                    <span class="schedule-route-from" aria-hidden="true">Ciudad Victoria</span>
                                    <span class="schedule-route-mid" aria-hidden="true"><%- include('partials/icon', { name: 'arrow-right', size: 14 }) %></span>
                                    <strong class="schedule-route-to" aria-hidden="true">Llera</strong>
                                </div>
                                <a class="schedule-next-cta is-pending" id="nextV2LPill" href="/reserve" title="Reservar próxima salida">
                                    <span class="schedule-next-label">Próxima</span>
                                    <span class="schedule-next-time">--:--</span>
                                    <span class="schedule-next-when" id="nextV2LWhen"></span>
                                </a>
                            </div>
                            <div class="schedule-times" aria-label="Horarios Victoria a Llera">
                                <% v2l.forEach(t => { const hhmm = String(t.depart_time || '').slice(0, 5); %>
                                <a class="chip-time"
                                   data-dir="VIC_TO_LLE"
                                   data-time="<%= hhmm %>"
                                   href="/reserve?dir=VIC_TO_LLE&time=<%= encodeURIComponent(hhmm) %>"><%= hhmm %></a>
                                <% }) %>
                                <% if (v2l.length === 0) { %>
                                    <div class="subtle">Sin horarios publicados.</div>
                                <% } %>
                            </div>
                        </article>

                        <% const l2v = templates.filter(t => t.direction === 'LLE_TO_VIC'); %>
                        <article class="schedule-row">
                            <div class="schedule-row-main">
                                <div class="schedule-route">
                                    <span class="visually-hidden">De Llera hacia Ciudad Victoria</span>
                                    <span class="schedule-route-from" aria-hidden="true">Llera</span>
                                    <span class="schedule-route-mid" aria-hidden="true"><%- include('partials/icon', { name: 'arrow-right', size: 14 }) %></span>
                                    <strong class="schedule-route-to" aria-hidden="true">Ciudad Victoria</strong>
                                </div>
                                <a class="schedule-next-cta is-pending" id="nextL2VPill" href="/reserve" title="Reservar próxima salida">
                                    <span class="schedule-next-label">Próxima</span>
                                    <span class="schedule-next-time">--:--</span>
                                    <span class="schedule-next-when" id="nextL2VWhen"></span>
                                </a>
                            </div>
                            <div class="schedule-times" aria-label="Horarios Llera a Victoria">
                                <% l2v.forEach(t => { const hhmm = String(t.depart_time || '').slice(0, 5); %>
                                <a class="chip-time"
                                   data-dir="LLE_TO_VIC"
                                   data-time="<%= hhmm %>"
                                   href="/reserve?dir=LLE_TO_VIC&time=<%= encodeURIComponent(hhmm) %>"><%= hhmm %></a>
                                <% }) %>
                                <% if (l2v.length === 0) { %>
                                    <div class="subtle">Sin horarios publicados.</div>
                                <% } %>
                            </div>
                        </article>
                    </div>
                </div>

                <div class="home-pane" id="pane-mapa" role="tabpanel" aria-labelledby="tab-mapa" hidden>
                    <div class="map-grid">
                        <article class="map-card">
                            <header class="map-card-head">
                                <div>
                                    <h3 class="map-title">Ciudad Victoria</h3>
                                    <p class="map-sub">Punto de salida</p>
                                </div>
                                <div class="map-actions">
                                    <a class="btn btn-wine btn-sm" target="_blank" rel="noopener noreferrer"
                                       href="https://www.google.com/maps?q=23.737544,-99.130954">Abrir</a>
                                    <a class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer"
                                       href="https://www.google.com/maps/dir/?api=1&destination=23.737544,-99.130954">Cómo llegar</a>
                                </div>
                            </header>
                            <iframe class="map-frame" loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    title="Mapa de salida en Ciudad Victoria"
                                    src="https://www.google.com/maps?q=23.737544,-99.130954&z=16&output=embed"></iframe>
                        </article>

                        <article class="map-card">
                            <header class="map-card-head">
                                <div>
                                    <h3 class="map-title">Llera</h3>
                                    <p class="map-sub">Punto de salida</p>
                                </div>
                                <div class="map-actions">
                                    <a class="btn btn-wine btn-sm" target="_blank" rel="noopener noreferrer"
                                       href="https://www.google.com/maps?q=23.317522,-99.023979">Abrir</a>
                                    <a class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer"
                                       href="https://www.google.com/maps/dir/?api=1&destination=23.317522,-99.023979">Cómo llegar</a>
                                </div>
                            </header>
                            <iframe class="map-frame" loading="lazy"
                                    referrerpolicy="no-referrer-when-downgrade"
                                    title="Mapa de salida en Llera"
                                    src="https://www.google.com/maps?q=23.317522,-99.023979&z=16&output=embed"></iframe>
                        </article>
                    </div>
                </div>

                <div class="home-pane" id="pane-info" role="tabpanel" aria-labelledby="tab-info" hidden>
                    <%
                    const adultPrice = Number((typeof pricing !== "undefined" && pricing && pricing.passenger_price_mxn) || 120);
                    const childPrice = Number((typeof pricing !== "undefined" && pricing && pricing.child_price_mxn) || 60);
                    const packPrice = Number((typeof pricing !== "undefined" && pricing && pricing.package_price_mxn) || 120);
                    const mxn = (n) => `$${Number(n || 0).toFixed(0)}`;
                    const stops = (typeof vicLocations !== "undefined" && vicLocations) ? vicLocations : [];
                    const faqItems = (typeof faqs !== "undefined" && Array.isArray(faqs) && faqs.length)
                            ? faqs
                            : ((typeof homeFaqs === "function") ? homeFaqs(typeof pricing !== "undefined" ? pricing : null, stops) : []);
                    const stopGroups = [];
                    {
                        const byPrice = new Map();
                        stops.forEach((loc) => {
                            const price = Number(loc.price_mxn);
                            if (!byPrice.has(price)) byPrice.set(price, []);
                            byPrice.get(price).push(loc);
                        });
                        Array.from(byPrice.keys()).sort((a, b) => a - b).forEach((price) => {
                            stopGroups.push({price, items: byPrice.get(price)});
                        });
                    }
                    const minStop = stopGroups.length ? stopGroups[0].price : 50;
                    %>
                    <div class="home-info" id="servicio">
                        <h3 class="visually-hidden">Tarifas y paradas</h3>
                        <div class="home-info-layout">
                            <div class="home-info-main">
                                <ul class="home-info-grid">
                                    <li class="home-info-tile">
                                        <span class="home-info-tile-ico" aria-hidden="true"><%- include('partials/icon', { name: 'users', size: 18 }) %></span>
                                        <span class="home-info-tile-copy">
                                            <strong>Pasaje</strong>
                                            <span class="home-info-tile-hint">Adulto y niño</span>
                                        </span>
                                        <span class="home-info-tile-price">
                                            <b><%= mxn(adultPrice) %></b>
                                            <small><%= mxn(childPrice) %> niño</small>
                                        </span>
                                    </li>
                                    <li class="home-info-tile">
                                        <span class="home-info-tile-ico" aria-hidden="true"><%- include('partials/icon', { name: 'package', size: 18 }) %></span>
                                        <span class="home-info-tile-copy">
                                            <strong>Paquetería</strong>
                                            <span class="home-info-tile-hint">Misma ruta</span>
                                        </span>
                                        <span class="home-info-tile-price">
                                            <b><%= mxn(packPrice) %></b>
                                            <small>por envío</small>
                                        </span>
                                    </li>
                                    <li class="home-info-tile">
                                        <span class="home-info-tile-ico" aria-hidden="true"><%- include('partials/icon', { name: 'map-pin', size: 18 }) %></span>
                                        <span class="home-info-tile-copy">
                                            <strong>Paradas</strong>
                                            <span class="home-info-tile-hint">Según abordaje</span>
                                        </span>
                                        <span class="home-info-tile-price">
                                            <b><%= mxn(minStop) %></b>
                                            <small>desde</small>
                                        </span>
                                    </li>
                                </ul>

                                <% if (stopGroups.length) { %>
                                    <div class="home-info-stops">
                                        <p class="home-info-label">Paradas en el tramo Victoria</p>
                                        <div class="home-stop-groups">
                                            <% stopGroups.forEach((group) => { %>
                                                <div class="home-stop-group">
                                                    <span class="home-stop-group-price"><%= mxn(group.price) %></span>
                                                    <ul class="home-stop-list">
                                                        <% group.items.forEach((loc) => { %>
                                                            <li>
                                                                <a class="home-stop-chip"
                                                                   href="/reserve?from=<%= encodeURIComponent(loc.code) %>&to=LLE"
                                                                   title="Reservar desde <%= loc.label %>">
                                                                    <%= loc.label %>
                                                                </a>
                                                            </li>
                                                        <% }) %>
                                                    </ul>
                                                </div>
                                            <% }) %>
                                        </div>
                                    </div>
                                <% } %>
                            </div>

                            <aside class="home-faq" id="preguntas">
                                <p class="home-info-label">Preguntas frecuentes</p>
                                <% faqItems.forEach((item) => { %>
                                    <details class="home-faq-item">
                                        <summary><%= item.question %></summary>
                                        <p><%= item.answer %></p>
                                    </details>
                                <% }) %>
                            </aside>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<%- include('partials/site-footer') %>

<script src="/js/theme.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    /* ===== Admin login oculto: mantener presionado 1.25s o dar 3 clics sobre el LOGO ===== */
    (function () {
        const hotspot = document.getElementById("adminHotspot");
        const trigger = hotspot ? (hotspot.closest(".logo-wrap") || hotspot) : null;
        if (!trigger) return;

        const HOLD_MS = 1250;
        const MULTI_CLICK_WINDOW_MS = 900;
        const REQUIRED_CLICKS = 3;

        function go() {
            window.location.href = "/admin/login";
        }

        let holdTimer = null;
        let clickCount = 0;
        let clickTimer = null;

        function startHold(e) {
            if (e.cancelable) e.preventDefault();
            if (holdTimer) return;
            holdTimer = setTimeout(() => {
                holdTimer = null;
                go();
            }, HOLD_MS);
        }

        function cancelHold() {
            if (!holdTimer) return;
            clearTimeout(holdTimer);
            holdTimer = null;
        }

        function handleMultiClick() {
            clickCount += 1;
            if (clickTimer) clearTimeout(clickTimer);

            if (clickCount >= REQUIRED_CLICKS) {
                clickCount = 0;
                clickTimer = null;
                go();
                return;
            }

            clickTimer = setTimeout(() => {
                clickCount = 0;
                clickTimer = null;
            }, MULTI_CLICK_WINDOW_MS);
        }

        trigger.addEventListener("mousedown", startHold);
        trigger.addEventListener("mouseup", cancelHold);
        trigger.addEventListener("mouseleave", cancelHold);
        trigger.addEventListener("click", handleMultiClick);

        trigger.addEventListener("touchstart", startHold, { passive: false });
        trigger.addEventListener("touchend", cancelHold);
        trigger.addEventListener("touchcancel", cancelHold);
        trigger.addEventListener("touchmove", cancelHold);

        trigger.addEventListener("contextmenu", (e) => e.preventDefault());
    })();

    /* ===== Próximas salidas ===== */
    (function () {
        const elV2LPill = document.getElementById("nextV2LPill");
        const elV2LWhen = document.getElementById("nextV2LWhen");
        const elL2VPill = document.getElementById("nextL2VPill");
        const elL2VWhen = document.getElementById("nextL2VWhen");

        if (!elV2LPill || !elL2VPill) return;

        function todayISO_MTY() {
            return new Date().toLocaleDateString("en-CA", {timeZone: "America/Monterrey"});
        }

        function addDaysISO(baseISO, days) {
            const [y, m, d] = String(baseISO).split("-").map(Number);
            const dt = new Date(Date.UTC(y, (m || 1) - 1, d || 1));
            dt.setUTCDate(dt.getUTCDate() + Number(days || 0));
            const yy = dt.getUTCFullYear();
            const mm = String(dt.getUTCMonth() + 1).padStart(2, "0");
            const dd = String(dt.getUTCDate()).padStart(2, "0");
            return `${yy}-${mm}-${dd}`;
        }

        function toHHMM(t) {
            const s = String(t || "").trim();
            if (/^\d{2}:\d{2}$/.test(s)) return s;
            if (/^\d{2}:\d{2}:\d{2}$/.test(s)) return s.slice(0, 5);
            const parts = s.split(":");
            if (parts.length >= 2) {
                return `${String(parts[0]).padStart(2, "0")}:${String(parts[1]).slice(0, 2).padStart(2, "0")}`;
            }
            return s;
        }

        async function fetchAvailability(dateISO, dir, seats) {
            const url =
                `/availability?date=${encodeURIComponent(dateISO)}` +
                `&direction=${encodeURIComponent(dir)}` +
                `&seats=${encodeURIComponent(seats)}`;
            const res = await fetch(url, {headers: {Accept: "application/json"}});
            const data = await res.json();
            return Array.isArray(data?.results) ? data.results : [];
        }

        async function findNext(dir, seats) {
            const base = todayISO_MTY();
            for (let offset = 0; offset <= 7; offset++) {
                const dateISO = addDaysISO(base, offset);
                let results = [];
                try {
                    results = await fetchAvailability(dateISO, dir, seats);
                } catch {
                    results = [];
                }
                const slots = results
                    .map(r => ({
                        hhmm: toHHMM(r.time ?? r.depart_time ?? ""),
                        available: Number(r.available ?? 0),
                    }))
                    .filter(x => x.hhmm)
                    .sort((a, b) => a.hhmm.localeCompare(b.hhmm));
                if (slots.length) {
                    const when = offset === 0 ? "hoy" : offset === 1 ? "mañana" : dateISO;
                    return {dateISO, when, hhmm: slots[0].hhmm, available: slots[0].available};
                }
            }
            return null;
        }

        function fillNext(pill, whenEl, real, ok, dir) {
            if (!real || !pill) return;
            const timeEl = pill.querySelector(".schedule-next-time");
            const full = Number(real.available || 0) <= 0;
            const target = full && ok ? ok : real;

            if (timeEl) timeEl.textContent = target.hhmm;
            pill.classList.remove("is-pending");
            pill.href = `/reserve?dir=${dir}&time=${encodeURIComponent(target.hhmm)}&date=${encodeURIComponent(target.dateISO)}`;

            if (whenEl) {
                whenEl.textContent = full
                    ? (ok ? `${real.when} · lleno` : `${real.when} · lleno`)
                    : real.when;
            }
        }

        Promise.all([
            findNext("VIC_TO_LLE", 0),
            findNext("LLE_TO_VIC", 0),
            findNext("VIC_TO_LLE", 1),
            findNext("LLE_TO_VIC", 1),
        ]).then(([nextV2LReal, nextL2VReal, nextV2LOk, nextL2VOk]) => {
            fillNext(elV2LPill, elV2LWhen, nextV2LReal, nextV2LOk, "VIC_TO_LLE");
            fillNext(elL2VPill, elL2VWhen, nextL2VReal, nextL2VOk, "LLE_TO_VIC");
        }).catch(() => {});
    })();

    /* ===== Tabs Horarios / Mapa / Info (sin Bootstrap, evita huecos) ===== */
    (function () {
        const storageKey = "homeTab";
        const tabs = Array.from(document.querySelectorAll("[data-home-tab]"));
        const panes = {
            horarios: document.getElementById("pane-horarios"),
            mapa: document.getElementById("pane-mapa"),
            info: document.getElementById("pane-info"),
        };
        if (!tabs.length || !panes.horarios || !panes.mapa || !panes.info) return;

        function showTab(name) {
            const key = panes[name] ? name : "horarios";
            Object.entries(panes).forEach(([id, el]) => {
                const on = id === key;
                el.classList.toggle("is-active", on);
                el.hidden = !on;
            });

            tabs.forEach((btn) => {
                const on = btn.getAttribute("data-home-tab") === key;
                btn.classList.toggle("active", on);
                btn.setAttribute("aria-selected", on ? "true" : "false");
            });

            sessionStorage.setItem(storageKey, key);
        }

        function tabFromLocation() {
            const hash = String(location.hash || "").replace("#", "");
            if (hash === "mapa") return "mapa";
            if (hash === "servicio" || hash === "preguntas") return "info";
            const stored = sessionStorage.getItem(storageKey);
            return panes[stored] ? stored : "horarios";
        }

        tabs.forEach((btn) => {
            btn.addEventListener("click", () => showTab(btn.getAttribute("data-home-tab") || "horarios"));
        });

        showTab(tabFromLocation());
    })();
</script>

</body>
</html>
