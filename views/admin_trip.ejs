<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Salida',
    description: 'Administración de salida (reservas y cupo).',
    canonicalUrl: 'https://serviciodetransportevic.com/admin/trip',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-trip">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Salida', tag: 'Reservas, cupo y tickets' }) %>

<main class="home-main admin-main">
<section class="container">
    <%
    const isActive = (x) => x.status !== 'CANCELLED';

    const countPassengers = (x) => {
        const byCount = Number(x.passenger_count || 0);
        const seats = Number(x.seats || 0);
        return byCount || seats || 1;
    };

    const usedRaw = (reservations || [])
            .filter(x => x.type === 'PASSENGER' && isActive(x))
            .reduce((acc, x) => acc + countPassengers(x), 0);

    const capRaw = Number(trip.capacity_passengers || 0);
    const cap = Math.min(6, Math.max(0, capRaw));
    const used = Math.min(usedRaw, cap);
    const pct = cap > 0 ? Math.min(100, Math.round((used / cap) * 100)) : 0;
    const libres = Math.max(0, cap - used);

    const mandados = (reservations || [])
            .filter(x => x.type === 'PACKAGE' && isActive(x))
            .reduce((acc, x) => acc + (Number(x.seats || 0) || 1), 0);

    function pmLabelOf(v) {
        const pm = String(v || '').toUpperCase();
        if (pm === 'ONLINE') return { icon: 'credit-card', text: 'Online' };
        if (pm === 'TRANSFERENCIA') return { icon: 'landmark', text: 'Transfer' };
        if (pm === 'TAQUILLA') return { icon: 'banknote', text: 'Taquilla' };
        return { icon: '', text: (v || '—') };
    }

    function toISODate(v) {
        if (!v) return '';
        if (typeof v === 'string') return v.slice(0, 10);
        try {
            return new Date(v).toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' });
        } catch {
            return String(v);
        }
    }

    function formatTripDate(iso) {
        const s = toISODate(iso);
        if (!s) return '';
        try {
            const d = new Date(s + 'T12:00:00');
            if (isNaN(d.getTime())) return s;
            const raw = new Intl.DateTimeFormat('es-MX', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
            }).format(d);
            return raw.charAt(0).toUpperCase() + raw.slice(1);
        } catch {
            return s;
        }
    }

    const tripDateISO = toISODate(trip.trip_date);
    const todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' });
    const isToday = tripDateISO === todayISO;
    const datePretty = formatTripDate(tripDateISO);
    const hhmm = String(trip.depart_time || '').slice(0, 5);
    const dir = String(trip.direction || '');
    const fromLabel = dir === 'LLE_TO_VIC' ? 'Llera' : 'Victoria';
    const toLabel = dir === 'LLE_TO_VIC' ? 'Victoria' : 'Llera';

    let tone = 'empty';
    if (cap > 0 && used >= cap) tone = 'full';
    else if (used > 0 && libres <= 2) tone = 'tight';
    else if (used > 0) tone = 'ok';

    let status = 'Vacía';
    if (tone === 'full') status = 'Llena';
    else if (tone === 'tight' || tone === 'ok') status = libres + (libres === 1 ? ' libre' : ' libres');
    if (mandados > 0 && used === 0) status = 'Solo paquetería';

    const rows = reservations || [];
    const pendingCount = rows.filter((x) => {
        const st = String(x.status || '').toUpperCase();
        return st === 'PENDING_PAYMENT' || st === 'PAY_AT_BOARDING';
    }).length;

    function statusInfo(stU) {
        if (stU === 'PAID') return { cls: 'badge-paid', icon: 'check', label: 'Pagado', tone: 'paid' };
        if (stU === 'CANCELLED') return { cls: 'badge-cancel', icon: 'ban', label: 'Cancelado', tone: 'cancel' };
        if (stU === 'PENDING_PAYMENT') return { cls: 'badge-pending', icon: 'hourglass', label: 'Pendiente', tone: 'pending' };
        if (stU === 'PAY_AT_BOARDING') return { cls: 'b-board', icon: 'banknote', label: 'Taquilla', tone: 'board' };
        return { cls: '', icon: '', label: stU || '—', tone: 'other' };
    }
    %>

    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Salida</h2>
            <div class="home-tabs-tools">
                <a class="btn btn-ghost btn-sm" href="/admin/agenda?date=<%= encodeURIComponent(tripDateISO) %>">
                    <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %>
                    Agenda
                </a>
                <%- include('partials/admin-nav', { adminNav: 'trip' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="trip-head is-<%= tone %>">
        <div class="trip-head-top">
            <div class="trip-head-copy">
                <p class="trip-date-label">
                    <% if (isToday) { %><span class="trip-today-dot">Hoy</span><% } %>
                    <%= datePretty %>
                </p>
                <div class="trip-route">
                    <span><%= fromLabel %></span>
                    <span class="trip-route-mid" aria-hidden="true"><%- include('partials/icon', { name: 'arrow-right', size: 14 }) %></span>
                    <span><%= toLabel %></span>
                    <span class="trip-head-time mono"><%= hhmm %></span>
                </div>
            </div>
            <div class="trip-head-tools">
                <div class="admin-filter-seg" role="group" aria-label="Filtro de reservas">
                    <% if (onlyPending) { %>
                        <a href="/admin/trip/<%= trip.trip_id %>">Todas</a>
                        <a class="is-on" href="/admin/trip/<%= trip.trip_id %>?onlyPending=1" aria-current="true">Pendientes</a>
                    <% } else { %>
                        <a class="is-on" href="/admin/trip/<%= trip.trip_id %>" aria-current="true">Todas</a>
                        <a href="/admin/trip/<%= trip.trip_id %>?onlyPending=1">Pendientes</a>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="trip-head-stats" role="group" aria-label="Resumen de la salida">
            <div class="trip-stat">
                <span class="trip-stat-value mono"><%= used %><span class="trip-stat-sep">/</span><%= cap %></span>
                <span class="trip-stat-label">Cupo</span>
                <span class="trip-seats" aria-hidden="true">
                    <% for (let i = 0; i < cap; i++) { %>
                        <span class="trip-seat <%= i < used ? 'is-on' : '' %>"></span>
                    <% } %>
                </span>
            </div>
            <div class="trip-stat">
                <span class="trip-stat-value mono"><%= mandados %></span>
                <span class="trip-stat-label">Paquetería</span>
            </div>
            <div class="trip-stat is-quiet">
                <span class="trip-stat-value"><%= status %></span>
                <span class="trip-stat-label">Estado</span>
            </div>
        </div>
    </div>

    <div class="trip-list-head">
        <h3 class="trip-list-title">Reservaciones</h3>
        <span class="trip-list-count"><%= rows.length %> reserva<%= rows.length === 1 ? '' : 's' %><% if (!onlyPending && pendingCount) { %> · <%= pendingCount %> pendiente<%= pendingCount === 1 ? '' : 's' %><% } %><% if (onlyPending) { %> pendiente<%= rows.length === 1 ? '' : 's' %><% } %></span>
    </div>

    <% if (!rows.length) { %>
        <div class="trip-empty">
            <div class="trip-empty-ico" aria-hidden="true"><%- include('partials/icon', { name: 'ticket', size: 22 }) %></div>
            <div class="h6 mb-1"><%= onlyPending ? 'Sin pendientes' : 'Sin reservaciones' %></div>
            <div class="subtle"><%= onlyPending
                ? 'No hay pagos pendientes ni taquilla en esta salida.'
                : 'Aún no hay registros para esta salida.' %></div>
            <% if (onlyPending) { %>
                <a class="trip-chip" href="/admin/trip/<%= trip.trip_id %>">Ver todas</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="trip-res-list">
            <% rows.forEach((r) => {
                const shown = (Number(r.passenger_count || 0) || Number(r.seats || 0) || 1);
                const rawNames = String(r.passenger_names || '').trim();
                const displayNames = rawNames ? rawNames : Array.from({ length: shown }, (_, i) => `Pasajero ${i + 1}`).join(', ');
                const digits = (r.phone || '').replace(/\D/g, '');
                const stU = String(r.status || '').toUpperCase();
                const pmU = String(r.payment_method || '').toUpperCase();
                const isPaid = stU === 'PAID';
                const isPaidOnline = isPaid && pmU === 'ONLINE';
                const st = statusInfo(stU);
                const pm = pmLabelOf(r.payment_method);
                const returnTo = encodeURIComponent('/admin/trip/' + trip.trip_id);
            %>
            <article class="trip-res is-<%= st.tone %>">
                <div class="trip-res-top">
                    <div class="trip-res-who">
                        <div class="trip-res-name"><%= r.customer_name %></div>
                        <div class="trip-res-meta">
                            <% if (r.phone) { %><span><%= r.phone %></span><% } %>
                            <% if (r.from_stop && r.to_stop && typeof stopLabel === 'function') { %>
                                <span><%- include('partials/icon', { name: 'map-pin', size: 12 }) %> <%= stopLabel(r.from_stop) %> → <%= stopLabel(r.to_stop) %></span>
                            <% } else if (r.vic_location) { %>
                                <span><%= resolveVicLocationLabel(r.vic_location) %></span>
                            <% } %>
                        </div>
                    </div>
                    <span class="badge-soft <%= st.cls %>">
                        <% if (st.icon) { %><%- include('partials/icon', { name: st.icon, size: 14 }) %><% } %>
                        <%= st.label %>
                    </span>
                </div>

                <div class="trip-res-tags">
                    <span class="trip-tag">
                        <%- include('partials/icon', { name: r.type === 'PASSENGER' ? 'user' : 'package', size: 14 }) %>
                        <%= r.type === 'PASSENGER' ? (shown + (shown === 1 ? ' pasajero' : ' pasajeros')) : 'Paquetería' %>
                    </span>
                    <span class="trip-tag">
                        <% if (pm.icon) { %><%- include('partials/icon', { name: pm.icon, size: 14 }) %><% } %>
                        <%= pm.text %>
                    </span>
                    <% if (r.ticket_code) { %>
                        <a class="trip-ticket" href="/ticket/<%= r.ticket_code %>?return=<%= returnTo %>" target="_blank"><%= r.ticket_code %></a>
                    <% } %>
                </div>

                <div class="trip-res-detail">
                    <% if (r.type === 'PASSENGER') { %>
                        <%= displayNames %>
                    <% } else { %>
                        <%= r.package_details || '—' %>
                    <% } %>
                </div>

                <div class="trip-res-actions">
                    <% if (!r.ticket_code && stU !== 'CANCELLED') { %>
                        <form method="POST" action="/admin/reservation/<%= r.id %>/mark-paid" class="m-0">
                            <input type="hidden" name="method" value="CASH">
                            <button class="btn btn-wine btn-xs" type="submit"><%- include('partials/icon', { name: 'banknote', size: 14 }) %> Efectivo</button>
                        </form>
                        <form method="POST" action="/admin/reservation/<%= r.id %>/mark-paid" class="m-0">
                            <input type="hidden" name="method" value="TRANSFER">
                            <button class="btn btn-ghost btn-xs" type="submit"><%- include('partials/icon', { name: 'landmark', size: 14 }) %> Transfer</button>
                        </form>
                    <% } %>

                    <% if (r.ticket_code) { %>
                        <a class="btn btn-ghost btn-xs" href="/ticket/<%= r.ticket_code %>?return=<%= returnTo %>" target="_blank"><%- include('partials/icon', { name: 'eye', size: 14 }) %> Ver</a>
                        <a class="btn btn-pdf btn-xs" href="/ticket/<%= r.ticket_code %>/pdf/view?return=<%= returnTo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'file-text', size: 14 }) %> PDF</a>
                        <% if (digits.length >= 10) { %>
                            <a class="btn btn-wa btn-xs" target="_blank"
                               href="https://wa.me/52<%= digits %>?text=<%= encodeURIComponent(
                                       'Tu ticket está listo\n' + (baseUrl || 'http://localhost:3000') + '/ticket/' + r.ticket_code
                               ) %>"><%- include('partials/icon', { name: 'message-circle', size: 14 }) %> WhatsApp</a>
                        <% } %>
                    <% } %>

                    <% if (stU !== 'CANCELLED' && isPaidOnline) { %>
                        <form method="POST" action="/admin/reservation/<%= r.id %>/cancel"
                              class="m-0"
                              onsubmit="return confirm('Esta reserva fue pagada en línea. Te llevaré a Stripe para reembolsar. Después regresa y presiona “Ya reembolsé”. ¿Continuar?')">
                            <button class="btn btn-outline-danger btn-xs" type="submit"><%- include('partials/icon', { name: 'ban', size: 14 }) %> Cancelar</button>
                        </form>
                        <a class="btn btn-outline-danger btn-xs"
                           href="/admin/reservation/<%= r.id %>/stripe-refund"
                           target="_blank" rel="noopener">
                            <%- include('partials/icon', { name: 'undo-2', size: 14 }) %> Stripe
                        </a>
                        <form method="POST" action="/admin/reservation/<%= r.id %>/refund-done"
                              class="m-0"
                              onsubmit="return confirm('¿Confirmas que YA hiciste el reembolso en Stripe? Esto marcará la reserva como CANCELLED y libera cupo.')">
                            <button class="btn btn-ghost btn-xs" type="submit"><%- include('partials/icon', { name: 'check', size: 14 }) %> Ya reembolsé</button>
                        </form>
                    <% } else if (stU !== 'CANCELLED' && !isPaid) { %>
                        <form method="POST" action="/admin/reservation/<%= r.id %>/cancel" class="m-0"
                              onsubmit="return confirm('¿Cancelar esta reserva? Esto libera cupo.')">
                            <button class="btn btn-outline-danger btn-xs" type="submit"><%- include('partials/icon', { name: 'ban', size: 14 }) %> Cancelar</button>
                        </form>
                    <% } %>
                </div>
            </article>
            <% }) %>
        </div>
    <% } %>

        </div>
    </div>
</section>
</main>

<%- include('partials/admin-footer') %>
<script src="/js/theme.js"></script>
</body>
</html>
