<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: (() => { try { return (trip.direction === 'LLE_TO_VIC' ? 'Llera → Victoria' : 'Victoria → Llera') + ' ' + String(trip.depart_time || '').slice(0, 5) + ', ' + new Intl.DateTimeFormat('es-MX', { weekday: 'short', day: 'numeric', month: 'short' }).format(new Date((trip.trip_date instanceof Date ? trip.trip_date.toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' }) : String(trip.trip_date).slice(0, 10)) + 'T12:00:00')).replace(' de ', ' ').replace('.', '') + ' | Admin'; } catch (e) { return 'Salida | Admin'; } })(),
    description: 'Administración de salida (reservas y cupo).',
    canonicalUrl: 'https://serviciodetransportevic.com/admin/trip',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-trip">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Salida', tag: 'Reservas, cupo y tickets' }) %>

<main class="home-main admin-main">
<section class="container">
    <%
    const isActive = (x) => x.status !== 'CANCELLED';

    const countPassengers = (x) => {
        const byCount = Number(x.passenger_count || 0);
        const seats = Number(x.seats || 0);
        return byCount || seats || 1;
    };

    const usedRaw = (reservations || [])
            .filter(x => x.type === 'PASSENGER' && isActive(x))
            .reduce((acc, x) => acc + countPassengers(x), 0);

    const capRaw = Number(trip.capacity_passengers || 0);
    const cap = Math.max(0, capRaw);
    const used = Math.min(usedRaw, cap);
    const pct = cap > 0 ? Math.min(100, Math.round((used / cap) * 100)) : 0;
    const libres = Math.max(0, cap - used);

    const mandados = (reservations || [])
            .filter(x => x.type === 'PACKAGE' && isActive(x))
            .reduce((acc, x) => acc + (Number(x.seats || 0) || 1), 0);

    function pmLabelOf(v) {
        const pm = String(v || '').toUpperCase();
        if (pm === 'ONLINE') return { icon: 'credit-card', text: 'Online' };
        if (pm === 'TRANSFERENCIA') return { icon: 'landmark', text: 'Transfer' };
        if (pm === 'TAQUILLA') return { icon: 'banknote', text: 'Taquilla' };
        return { icon: '', text: (v || '—') };
    }

    function toISODate(v) {
        if (!v) return '';
        if (typeof v === 'string') return v.slice(0, 10);
        try {
            return new Date(v).toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' });
        } catch {
            return String(v);
        }
    }

    function formatTripDate(iso) {
        const s = toISODate(iso);
        if (!s) return '';
        try {
            const d = new Date(s + 'T12:00:00');
            if (isNaN(d.getTime())) return s;
            const raw = new Intl.DateTimeFormat('es-MX', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
            }).format(d);
            return raw.charAt(0).toUpperCase() + raw.slice(1);
        } catch {
            return s;
        }
    }

    const tripDateISO = toISODate(trip.trip_date);
    const todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' });
    const isToday = tripDateISO === todayISO;
    const datePretty = formatTripDate(tripDateISO);
    const hhmm = String(trip.depart_time || '').slice(0, 5);
    const dir = String(trip.direction || '');
    const fromLabel = dir === 'LLE_TO_VIC' ? 'Llera' : 'Victoria';
    const toLabel = dir === 'LLE_TO_VIC' ? 'Victoria' : 'Llera';

    let tone = 'empty';
    if (cap > 0 && used >= cap) tone = 'full';
    else if (used > 0 && libres <= 2) tone = 'tight';
    else if (used > 0) tone = 'ok';

    let status = 'Vacía';
    if (tone === 'full') status = 'Llena';
    else if (tone === 'tight' || tone === 'ok') status = libres + (libres === 1 ? ' libre' : ' libres');
    if (mandados > 0 && used === 0) status = 'Solo paquetería';

    const rows = reservations || [];
    const pendingCount = rows.filter((x) => {
        const st = String(x.status || '').toUpperCase();
        return st === 'PENDING_PAYMENT' || st === 'PAY_AT_BOARDING';
    }).length;

    const mxn = (n) => Number(n || 0).toLocaleString('es-MX', {
        style: 'currency', currency: 'MXN', minimumFractionDigits: 0, maximumFractionDigits: 2,
    });
    const paidTrip = Number(typeof tripPaidMxn !== 'undefined' ? tripPaidMxn : 0);
    const pendingTrip = Number(typeof tripPendingMxn !== 'undefined' ? tripPendingMxn : 0);
    const totalTrip = paidTrip + pendingTrip;
    const paidPct = totalTrip > 0 ? Math.round((paidTrip / totalTrip) * 100) : 0;

    function statusInfo(stU) {
        if (stU === 'PAID') return { cls: 'badge-paid', icon: 'check', label: 'Pagado', tone: 'paid' };
        if (stU === 'CANCELLED') return { cls: 'badge-cancel', icon: 'ban', label: 'Cancelado', tone: 'cancel' };
        if (stU === 'PENDING_PAYMENT') return { cls: 'badge-pending', icon: 'hourglass', label: 'Pendiente', tone: 'pending' };
        if (stU === 'PAY_AT_BOARDING') return { cls: 'b-board', icon: 'banknote', label: 'Taquilla', tone: 'board' };
        return { cls: '', icon: '', label: stU || '—', tone: 'other' };
    }

    // Conteos para los filtros y datos para la lista de abordaje.
    const up = (x) => String(x.status || '').toUpperCase();
    const isDue = (x) => up(x) === 'PENDING_PAYMENT' || up(x) === 'PAY_AT_BOARDING';
    const counts = {
        active: rows.filter((x) => up(x) !== 'CANCELLED').length,
        paid: rows.filter((x) => up(x) === 'PAID').length,
        due: rows.filter(isDue).length,
        package: rows.filter((x) => x.type === 'PACKAGE' && up(x) !== 'CANCELLED').length,
        cancel: rows.filter((x) => up(x) === 'CANCELLED').length,
        all: rows.length,
    };
    const passengerRows = rows.filter((x) => x.type === 'PASSENGER' && up(x) !== 'CANCELLED');
    const packageRows = rows.filter((x) => x.type === 'PACKAGE' && up(x) !== 'CANCELLED');
    const namesOf = (x) => {
        const n = countPassengers(x);
        const raw = String(x.passenger_names || '').trim();
        if (raw) return raw;
        // Sin nombres capturados: el primer lugar usa el nombre de contacto de la reserva.
        const contact = String(x.customer_name || '').trim();
        return Array.from({ length: n }, (_, i) => (i === 0 && contact) ? contact : 'Pasajero ' + (i + 1)).join(', ');
    };
    const payShort = (x) => {
        if (up(x) === 'PAID') return 'PAGADO';
        return 'COBRAR ' + mxn(x.amount_total_mxn);
    };
    const manifestText = [
        (fromLabel + ' > ' + toLabel + ' ' + hhmm + ', ' + datePretty),
        used + ' de ' + cap + ' lugares ocupados',
        '',
        'PASAJEROS',
        ...passengerRows.map((x) => '- ' + namesOf(x) + ' (' + countPassengers(x) + ')' + (x.phone ? ', ' + x.phone : '') + ', ' + payShort(x)),
        ...(packageRows.length ? ['', 'PAQUETERIA', ...packageRows.map((x) => '- ' + (x.customer_name || '') + ': ' + (x.package_details || '') + ', ' + payShort(x))] : []),
    ].join('\n');
    %>

    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <%- include('partials/admin-title', { title: 'Salida', icon: 'bus', subtitle: 'Reservas, cupo y cobros' }) %>
            <div class="home-tabs-tools">
                <a class="btn btn-ghost btn-sm" href="/admin/agenda?date=<%= encodeURIComponent(tripDateISO) %>">
                    <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %>
                    Agenda
                </a>
                <%- include('partials/admin-nav', { adminNav: 'trip' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="trip-head is-<%= tone %>">
        <div class="trip-head-top">
            <div class="trip-head-copy">
                <p class="trip-date-label">
                    <% if (isToday) { %><span class="trip-today-dot">Hoy</span><% } %>
                    <%= datePretty %>
                </p>
                <div class="trip-route">
                    <span><%= fromLabel %></span>
                    <span class="trip-route-mid" aria-hidden="true"><%- include('partials/icon', { name: 'arrow-right', size: 14 }) %></span>
                    <span><%= toLabel %></span>
                    <span class="trip-head-time mono"><%= hhmm %></span>
                </div>
                <% if (trip.special_title) { %>
                    <div class="trip-special-note">
                        <%- include('partials/icon', { name: trip.special_icon || 'ferris-wheel', size: 14 }) %>
                        <%= trip.special_title %><% if (trip.special_return_time) { %> (viaje redondo, regreso <%= String(trip.special_return_time).slice(0, 5) %>)<% } %>
                    </div>
                <% } %>
            </div>
            <div class="trip-head-tools">
                <button type="button" class="trip-chip" id="tripCopyList" data-copy="<%= manifestText %>">
                    <%- include('partials/icon', { name: 'clipboard-list', size: 15 }) %> Copiar lista
                </button>
                <button type="button" class="trip-chip" id="tripPrint">
                    <%- include('partials/icon', { name: 'printer', size: 15 }) %> Imprimir
                </button>
            </div>
        </div>

        <div class="trip-summary">
        <div class="trip-head-stats" role="group" aria-label="Resumen de la salida">
            <div class="trip-stat">
                <span class="trip-stat-value mono"><%= used %><span class="trip-stat-sep">/</span><%= cap %></span>
                <span class="trip-stat-label">Cupo</span>
                <span class="trip-seats" aria-hidden="true">
                    <% for (let i = 0; i < cap; i++) { %>
                        <span class="trip-seat <%= i < used ? 'is-on' : '' %>"></span>
                    <% } %>
                </span>
            </div>
            <div class="trip-stat">
                <span class="trip-stat-value mono"><%= mandados %></span>
                <span class="trip-stat-label">Paquetería</span>
            </div>
            <div class="trip-stat is-quiet">
                <span class="trip-stat-value"><%= status %></span>
                <span class="trip-stat-label">Estado</span>
            </div>
        </div>

        <div class="trip-revenue" role="group" aria-label="Ingresos de la salida">
            <div class="trip-revenue-top">
                <div class="trip-revenue-main">
                    <span class="trip-revenue-label">Ingresos de la salida</span>
                    <span class="trip-revenue-value"><%= mxn(totalTrip) %></span>
                </div>
                <span class="trip-revenue-pct" title="Porcentaje ya cobrado"><%= paidPct %>% cobrado</span>
            </div>
            <div class="trip-revenue-bar" role="img" aria-label="<%= paidPct %>% cobrado"><span style="width: <%= paidPct %>%"></span></div>
            <div class="trip-revenue-split">
                <div class="trip-revenue-item is-paid">
                    <span class="trip-revenue-dot" aria-hidden="true"></span>
                    <span class="trip-revenue-item-label">Cobrado</span>
                    <span class="trip-revenue-item-value"><%= mxn(paidTrip) %></span>
                </div>
                <div class="trip-revenue-item is-pending">
                    <span class="trip-revenue-dot" aria-hidden="true"></span>
                    <span class="trip-revenue-item-label">Por cobrar</span>
                    <span class="trip-revenue-item-value"><%= mxn(pendingTrip) %></span>
                </div>
            </div>
        </div>
    </div>
    </div>

    <div class="trip-list-head">
        <h3 class="trip-list-title">Reservaciones</h3>
        <span class="trip-list-count" id="tripListCount" aria-live="polite"></span>
    </div>

    <% if (rows.length) { %>
    <div class="trip-toolbar">
        <label class="trip-search">
            <%- include('partials/icon', { name: 'search', size: 16 }) %>
            <input type="search" id="tripSearch" placeholder="Buscar por nombre, teléfono o boleto" autocomplete="off" aria-label="Buscar reservaciones">
        </label>
        <div class="trip-filters" role="group" aria-label="Filtrar reservaciones">
            <button type="button" class="trip-fchip is-on" data-filter="active" aria-pressed="true">Activas <b><%= counts.active %></b></button>
            <button type="button" class="trip-fchip" data-filter="paid" aria-pressed="false">Pagadas <b><%= counts.paid %></b></button>
            <button type="button" class="trip-fchip" data-filter="due" aria-pressed="false">Por cobrar <b><%= counts.due %></b></button>
            <button type="button" class="trip-fchip" data-filter="package" aria-pressed="false">Paquetería <b><%= counts.package %></b></button>
            <button type="button" class="trip-fchip" data-filter="cancel" aria-pressed="false">Canceladas <b><%= counts.cancel %></b></button>
            <button type="button" class="trip-fchip" data-filter="all" aria-pressed="false">Todas <b><%= counts.all %></b></button>
        </div>
    </div>
    <% } %>

    <div class="trip-nomatch" id="tripNoMatch" hidden>
        <div class="h6 mb-1">Sin resultados</div>
        <div class="subtle">Cambia el filtro o borra la búsqueda.</div>
    </div>

    <% if (!rows.length) { %>
        <div class="trip-empty">
            <div class="trip-empty-ico" aria-hidden="true"><%- include('partials/icon', { name: 'ticket', size: 22 }) %></div>
            <div class="h6 mb-1"><%= onlyPending ? 'Sin pendientes' : 'Sin reservaciones' %></div>
            <div class="subtle"><%= onlyPending
                ? 'No hay pagos pendientes ni taquilla en esta salida.'
                : 'Aún no hay registros para esta salida.' %></div>
            <% if (onlyPending) { %>
                <a class="trip-chip" href="/admin/trip/<%= trip.trip_id %>">Ver todas</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="trip-res-list">
            <% rows.forEach((r) => {
                const shown = (Number(r.passenger_count || 0) || Number(r.seats || 0) || 1);
                const rawNames = String(r.passenger_names || '').trim();
                const contactName = String(r.customer_name || '').trim();
                const displayNames = rawNames ? rawNames : Array.from({ length: shown }, (_, i) => (i === 0 && contactName) ? contactName : `Pasajero ${i + 1}`).join(', ');
                const digits = (r.phone || '').replace(/\D/g, '');
                const stU = String(r.status || '').toUpperCase();
                const pmU = String(r.payment_method || '').toUpperCase();
                const isPaid = stU === 'PAID';
                const isPaidOnline = isPaid && pmU === 'ONLINE';
                const st = statusInfo(stU);
                const pm = pmLabelOf(r.payment_method);
                const returnTo = encodeURIComponent('/admin/trip/' + trip.trip_id);
            %>
            <article class="trip-res is-<%= st.tone %>"
                     data-status="<%= st.tone %>"
                     data-type="<%= r.type === 'PASSENGER' ? 'passenger' : 'package' %>"
                     data-search="<%= [r.customer_name, r.phone, digits, r.ticket_code, rawNames, r.package_details].join(' ').toLowerCase() %>">
                <div class="trip-res-top">
                    <div class="trip-res-who">
                        <div class="trip-res-name"><%= r.customer_name %></div>
                        <div class="trip-res-meta">
                            <% if (r.phone) { %><% if (digits.length >= 10) { %><a class="trip-res-phone" href="tel:+52<%= digits %>"><%- include('partials/icon', { name: 'phone', size: 12 }) %> <%= r.phone %></a><% } else { %><span><%= r.phone %></span><% } %><% } %>
                            <% if (r.from_stop && r.to_stop && typeof stopLabel === 'function') { %>
                                <span><%- include('partials/icon', { name: 'map-pin', size: 12 }) %> <%= stopLabel(r.from_stop) %> → <%= stopLabel(r.to_stop) %></span>
                            <% } else if (r.vic_location) { %>
                                <span><%= resolveVicLocationLabel(r.vic_location) %></span>
                            <% } %>
                        </div>
                    </div>
                    <div class="trip-res-side">
                        <% if (r.amount_total_mxn != null && r.amount_total_mxn !== '') { %>
                            <span class="trip-res-amount mono is-<%= st.tone %>"><%= mxn(r.amount_total_mxn) %></span>
                        <% } %>
                        <span class="badge-soft <%= st.cls %>">
                            <% if (st.icon) { %><%- include('partials/icon', { name: st.icon, size: 14 }) %><% } %>
                            <%= st.label %>
                        </span>
                    </div>
                </div>

                <div class="trip-res-tags">
                    <span class="trip-tag">
                        <%- include('partials/icon', { name: r.type === 'PASSENGER' ? 'user' : 'package', size: 14 }) %>
                        <%= r.type === 'PASSENGER' ? (shown + (shown === 1 ? ' pasajero' : ' pasajeros')) : 'Paquetería' %>
                    </span>
                    <span class="trip-tag">
                        <% if (pm.icon) { %><%- include('partials/icon', { name: pm.icon, size: 14 }) %><% } %>
                        <%= pm.text %>
                    </span>
                    <% if (r.ticket_code) { %>
                        <a class="trip-ticket" href="/ticket/<%= r.ticket_code %>?return=<%= returnTo %>" target="_blank"><%= r.ticket_code %></a>
                    <% } %>
                </div>

                <div class="trip-res-detail">
                    <span class="trip-res-detail-ico" aria-hidden="true"><%- include('partials/icon', { name: r.type === 'PASSENGER' ? 'users' : 'package', size: 14 }) %></span>
                    <span>
                    <% if (r.type === 'PASSENGER') { %>
                        <%= displayNames %>
                    <% } else { %>
                        <%= r.package_details || '—' %>
                    <% } %>
                    </span>
                </div>

                <%
                const canPay = !r.ticket_code && stU !== 'CANCELLED';
                const showRefund = stU !== 'CANCELLED' && isPaidOnline;
                const showCancel = stU !== 'CANCELLED' && !isPaidOnline;
                const cancelAmount = Number(r.amount_total_mxn || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
                const canRemind = canPay && digits.length >= 10;
                const canNotifyCancel = stU === 'CANCELLED' && digits.length >= 10;
                const routeTxt = fromLabel + ' > ' + toLabel + ' ' + hhmm + ', ' + datePretty;
                const remindMsg = 'Hola ' + (r.customer_name || '') + ', te escribimos por tu reserva de ' + routeTxt + '. Tienes un pago pendiente de ' + cancelAmount + '. ¿Nos confirmas tu pago para emitir tu boleto?';
                const cancelMsg = 'Hola ' + (r.customer_name || '') + ', tu reserva de ' + routeTxt + ' fue cancelada.' + (pmU === 'ONLINE' ? ' Tu reembolso de ' + cancelAmount + ' se procesa en tu método de pago original.' : '');
                const hasActions = canPay || !!r.ticket_code || showRefund || showCancel || canNotifyCancel;
                %>
                <% if (hasActions) { %>
                <div class="trip-res-actions">
                    <% if (canPay) { %>
                        <div class="trip-res-pay">
                            <form method="POST" action="/admin/reservation/<%= r.id %>/mark-paid" class="m-0"
                                  data-confirm="Se registrará el pago en efectivo de <%= r.customer_name || 'este cliente' %> por <%= Number(r.amount_total_mxn || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' }) %> y se emitirá su boleto."
                                  data-confirm-title="Marcar como pagada en efectivo"
                                  data-confirm-ok="Sí, ya pagó">
                                <input type="hidden" name="method" value="CASH">
                                <button class="btn btn-wine btn-xs" type="submit"><%- include('partials/icon', { name: 'banknote', size: 14 }) %> Cobrar en efectivo</button>
                            </form>
                            <form method="POST" action="/admin/reservation/<%= r.id %>/mark-paid" class="m-0"
                                  data-confirm="Se registrará la transferencia de <%= r.customer_name || 'este cliente' %> por <%= Number(r.amount_total_mxn || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' }) %> y se emitirá su boleto. Confirma que ya la recibiste."
                                  data-confirm-title="Marcar como pagada por transferencia"
                                  data-confirm-ok="Sí, la recibí">
                                <input type="hidden" name="method" value="TRANSFER">
                                <button class="btn btn-ghost btn-xs" type="submit"><%- include('partials/icon', { name: 'landmark', size: 14 }) %> Transferencia</button>
                            </form>
                            <% if (canRemind) { %>
                                <a class="btn btn-wa btn-xs" target="_blank" rel="noopener"
                                   href="https://wa.me/52<%= digits %>?text=<%= encodeURIComponent(remindMsg) %>"><%- include('partials/icon', { name: 'message-circle', size: 14 }) %> Recordar pago</a>
                            <% } %>
                        </div>
                    <% } %>

                    <% if (canNotifyCancel) { %>
                        <a class="btn btn-wa btn-xs" target="_blank" rel="noopener"
                           href="https://wa.me/52<%= digits %>?text=<%= encodeURIComponent(cancelMsg) %>"><%- include('partials/icon', { name: 'message-circle', size: 14 }) %> Avisar cancelación</a>
                    <% } %>

                    <% if (r.ticket_code) { %>
                        <div class="trip-btn-group" role="group" aria-label="Boleto de <%= r.customer_name || 'la reserva' %>">
                            <a class="btn btn-xs" href="/ticket/<%= r.ticket_code %>?return=<%= returnTo %>" target="_blank"><%- include('partials/icon', { name: 'eye', size: 14 }) %> Ver</a>
                            <a class="btn btn-pdf btn-xs" href="/ticket/<%= r.ticket_code %>/pdf/view?return=<%= returnTo %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'file-text', size: 14 }) %> PDF</a>
                            <% if (digits.length >= 10) { %>
                                <a class="btn btn-wa btn-xs" target="_blank" rel="noopener"
                                   href="https://wa.me/52<%= digits %>?text=<%= encodeURIComponent(
                                           'Tu ticket está listo\n' + (baseUrl || 'http://localhost:3000') + '/ticket/' + r.ticket_code
                                   ) %>"><%- include('partials/icon', { name: 'message-circle', size: 14 }) %> WhatsApp</a>
                            <% } %>
                        </div>
                    <% } %>

                    <% if (showRefund || showCancel) { %>
                        <details class="trip-res-more">
                            <summary>
                                <%- include('partials/icon', { name: 'ellipsis', size: 14 }) %>
                                <span><%= showRefund ? 'Reembolsar y cancelar' : (isPaid ? 'Cancelar reserva pagada' : 'Cancelar') %></span>
                                <span class="trip-res-more-chev" aria-hidden="true"><%- include('partials/icon', { name: 'chevron-down', size: 14 }) %></span>
                            </summary>
                            <div class="trip-res-more-menu">
                            <% if (showRefund) { %>
                                <a class="btn btn-outline-danger btn-xs"
                                   href="/admin/reservation/<%= r.id %>/stripe-refund"
                                   target="_blank" rel="noopener">
                                    <%- include('partials/icon', { name: 'undo-2', size: 14 }) %> 1. Reembolsar en Stripe
                                </a>
                                <form method="POST" action="/admin/reservation/<%= r.id %>/refund-done"
                                      class="m-0"
                                      data-confirm="Se cancelará la reserva de <%= r.customer_name || 'este cliente' %> y se liberará el cupo. Su boleto quedará como cancelado. Confírmalo solo si ya hiciste el reembolso de <%= cancelAmount %> en Stripe."
                                      data-confirm-title="¿Ya reembolsaste en Stripe?"
                                      data-confirm-ok="Sí, ya reembolsé"
                                      data-confirm-tone="danger">
                                    <button class="btn btn-ghost btn-xs" type="submit"><%- include('partials/icon', { name: 'check', size: 14 }) %> 2. Ya reembolsé y cancelar</button>
                                </form>
                            <% } else if (isPaid) { %>
                                <form method="POST" action="/admin/reservation/<%= r.id %>/cancel" class="m-0"
                                      data-confirm="Esta reserva ya estaba pagada (<%= pm.text %>, <%= cancelAmount %>). Se cancelará, se liberará el cupo y su boleto quedará como cancelado. Devuelve el dinero a <%= r.customer_name || 'el cliente' %> por tu cuenta."
                                      data-confirm-title="Cancelar reserva pagada"
                                      data-confirm-ok="Sí, cancelar y devolver"
                                      data-confirm-tone="danger">
                                    <button class="btn btn-outline-danger btn-xs" type="submit"><%- include('partials/icon', { name: 'ban', size: 14 }) %> Cancelar reserva pagada</button>
                                </form>
                            <% } else { %>
                                <form method="POST" action="/admin/reservation/<%= r.id %>/cancel" class="m-0"
                                      data-confirm="Se cancelará la reserva y se liberará el cupo."
                                      data-confirm-title="Cancelar reserva"
                                      data-confirm-ok="Cancelar reserva"
                                      data-confirm-tone="danger">
                                    <button class="btn btn-outline-danger btn-xs" type="submit"><%- include('partials/icon', { name: 'ban', size: 14 }) %> Cancelar reserva</button>
                                </form>
                            <% } %>
                            </div>
                        </details>
                    <% } %>
                </div>
                <% } %>
            </article>
            <% }) %>
        </div>
    <% } %>

        </div>
    </div>
</section>
</main>

<section class="trip-manifest" aria-hidden="true">
    <h1><%= fromLabel %> a <%= toLabel %>, <%= hhmm %></h1>
    <p><%= datePretty %>. <%= used %> de <%= cap %> lugares ocupados.</p>
    <h2>Pasajeros</h2>
    <% if (!passengerRows.length) { %><p>Sin pasajeros.</p><% } else { %>
    <table>
        <thead><tr><th>Abordó</th><th>Nombre</th><th>Lugares</th><th>Teléfono</th><th>Pago</th></tr></thead>
        <tbody>
        <% passengerRows.forEach((x) => { %>
            <tr>
                <td><span class="trip-manifest-box"></span></td>
                <td><%= namesOf(x) %></td>
                <td><%= countPassengers(x) %></td>
                <td><%= x.phone || '' %></td>
                <td><%= payShort(x) %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
    <% if (packageRows.length) { %>
    <h2>Paquetería</h2>
    <table>
        <thead><tr><th>Entregado</th><th>Cliente</th><th>Detalle</th><th>Teléfono</th><th>Pago</th></tr></thead>
        <tbody>
        <% packageRows.forEach((x) => { %>
            <tr>
                <td><span class="trip-manifest-box"></span></td>
                <td><%= x.customer_name || '' %></td>
                <td><%= x.package_details || '' %></td>
                <td><%= x.phone || '' %></td>
                <td><%= payShort(x) %></td>
            </tr>
        <% }) %>
        </tbody>
    </table>
    <% } %>
</section>

<div class="trip-toast" id="tripToast" role="status" aria-live="polite" hidden></div>

<%- include('partials/admin-footer') %>
<script src="/js/copy.js"></script>
<script>
(function () {
    var cards = Array.prototype.slice.call(document.querySelectorAll('.trip-res'));
    var chips = Array.prototype.slice.call(document.querySelectorAll('.trip-fchip'));
    var search = document.getElementById('tripSearch');
    var countEl = document.getElementById('tripListCount');
    var noMatch = document.getElementById('tripNoMatch');
    var toast = document.getElementById('tripToast');
    var filter = 'active';
    var KEY = 'trip-filter';
    try { var saved = sessionStorage.getItem(KEY); if (saved && document.querySelector('.trip-fchip[data-filter="' + saved + '"]')) filter = saved; } catch (e) {}

    function matches(c) {
        var s = c.dataset.status, t = c.dataset.type;
        if (filter === 'active') return s !== 'cancel';
        if (filter === 'paid') return s === 'paid';
        if (filter === 'due') return s === 'pending' || s === 'board';
        if (filter === 'package') return t === 'package' && s !== 'cancel';
        if (filter === 'cancel') return s === 'cancel';
        return true;
    }

    function apply() {
        var q = (search ? search.value : '').trim().toLowerCase();
        var shown = 0;
        cards.forEach(function (c) {
            var ok = matches(c) && (!q || c.dataset.search.indexOf(q) !== -1);
            c.hidden = !ok;
            if (ok) shown++;
        });
        chips.forEach(function (b) {
            var on = b.dataset.filter === filter;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
        if (countEl) countEl.textContent = shown + ' de ' + cards.length + ' reserva' + (cards.length === 1 ? '' : 's');
        if (noMatch) noMatch.hidden = shown > 0 || !cards.length;
    }

    chips.forEach(function (b) {
        b.addEventListener('click', function () {
            filter = b.dataset.filter;
            try { sessionStorage.setItem(KEY, filter); } catch (e) {}
            apply();
        });
    });
    if (search) search.addEventListener('input', apply);

    function say(msg, bad) {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.toggle('is-error', !!bad);
        toast.hidden = false;
        clearTimeout(say.t);
        say.t = setTimeout(function () { toast.hidden = true; }, 2200);
    }

    var copyBtn = document.getElementById('tripCopyList');
    if (copyBtn) copyBtn.addEventListener('click', function () {
        window.copyText(copyBtn.dataset.copy, {}).then(function (ok) {
            say(ok ? 'Lista copiada' : 'No se pudo copiar la lista', !ok);
        });
    });

    var printBtn = document.getElementById('tripPrint');
    if (printBtn) printBtn.addEventListener('click', function () { window.print(); });

    apply();
})();
</script>
<script src="/js/theme.js"></script>
</body>
</html>
