<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Pago en línea | Servicio de Transporte',
    description: 'Completa tu pago en línea de forma segura con Stripe.',
    canonicalUrl: 'https://serviciodetransportevic.com/checkout',
    noindex: true
    }) %>

    <!-- Stripe (must be in <head> or before use) -->
    <script src="https://js.stripe.com/v3/"></script>
</head>

<body class="page-checkout">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<main class="container py-4 page-wrap">
    <%
    const type = String(r.type || "").toUpperCase();
    const isPassenger = type === "PASSENGER";
    const isPackage = type === "PACKAGE";

    const payment = String(r.payment_method || "ONLINE").toUpperCase();
    const status = String(r.status || "").toUpperCase();

    const seats = Number(r.seats || 0);
    const totalSafe = (total != null && total !== "") ? Number(total) : Number(r.amount_total_mxn || 0);

    function fmtMXN(n){
        const v = Number(n || 0);
        return `$${v.toFixed(2)} MXN`;
    }
    function typeLabel(){
        return isPassenger ? "Pasaje" : "Paquetería";
    }

    const isOnline = payment === "ONLINE";
    const canPay = isOnline && (status === "PENDING_PAYMENT" || !status);
    const isPaid = status === "PAID";
    const canMount = (canPay && !isPaid && isOnline);

    const token = publicToken || "";
    const payUrl = `/pay/t/${encodeURIComponent(token)}`;
    %>

    <section class="hero">
        <div class="hero-inner d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="d-flex gap-2 flex-wrap align-items-center">
                    <span class="pill">Pago seguro</span>
                    <span class="pill">Stripe</span>
                </div>

                <h1 class="h3 hero-title mt-2">Confirmar pago</h1>
                <div class="hero-sub">
                    Revisa tu reserva. Al pagar, tu ticket queda confirmado automáticamente.
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-solid btn-xs" href="<%= payUrl %>">Volver</a>
                <a class="btn btn-solid btn-xs" href="/">Inicio</a>
            </div>
        </div>

        <div class="steps">
            <div class="step">
                <span class="dot">1</span>
                <span>Reserva</span>
            </div>
            <span class="chev">›</span>
            <div class="step active">
                <span class="dot">2</span>
                <span>Pago</span>
            </div>
            <span class="chev">›</span>
            <div class="step">
                <span class="dot">3</span>
                <span>Ticket</span>
            </div>
        </div>
    </section>

    <div class="grid">
        <!-- LEFT: RESUMEN -->
        <section class="card-soft">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Resumen</h2>
                    <p class="card-sub">Verifica ruta, fecha y datos de contacto.</p>
                </div>
                <div class="pill"><%= typeLabel() %></div>
            </div>

            <div class="card-body">
                <% if (!isOnline) { %>
                    <div class="note danger mb-3">
                        Esta reserva no está configurada como <strong>Pago en línea</strong>.
                    </div>
                <% } %>

                <% if (isPaid) { %>
                    <div class="note mb-3">
                        ✅ Este pago ya aparece como <strong>Pagado</strong>.
                    </div>
                <% } %>

                <ul class="kv mb-3">
                    <li><span class="k">Folio</span><span class="v mono"><%= folio %></span></li>
                    <li><span class="k">Ruta</span><span class="v"><%= directionLabel(r.direction) %></span></li>
                    <% if (typeof vicLocationLabel !== "undefined" && vicLocationLabel) { %>
                        <li><span class="k">Ubicación</span><span class="v"><%= vicLocationLabel %></span></li>
                    <% } %>
                    <li><span class="k">Fecha</span><span class="v"><%= r.trip_date %></span></li>
                    <li><span class="k">Hora</span><span class="v"><%= r.depart_time %></span></li>

                    <% if (isPassenger) { %>
                        <li><span class="k">Pasajeros</span><span
                                    class="v"><%= Math.max(1, Number(seats || 1)) %></span></li>
                    <% } %>

                    <% if (isPackage) { %>
                        <li><span class="k">Detalle</span><span class="v"><%= (r.package_details || "-") %></span></li>
                    <% } %>

                    <li><span class="k">Contacto</span><span class="v"><%= (r.customer_name || "-") %></span></li>
                    <li><span class="k">Teléfono</span><span class="v"><%= (r.phone || "-") %></span></li>
                </ul>

                <div class="note">
                    <strong>Importante:</strong> tus datos de tarjeta no se almacenan en este sitio.
                    El pago se procesa directamente en Stripe.
                </div>
            </div>
        </section>

        <!-- RIGHT: PAGO CTA -->
        <aside class="card-soft">
            <div class="card-head">
                <div>
                    <h2 class="card-title">Pago</h2>
                    <p class="card-sub">Abre el panel y paga en línea.</p>
                </div>
                <div class="pill">MXN</div>
            </div>

            <div class="card-body">
                <div class="pay-cta">
                    <div class="total-box">
                        <div class="rowline">
                            <span>Subtotal</span>
                            <span><strong><%= fmtMXN(totalSafe) %></strong></span>
                        </div>
                        <div class="rowline">
                            <span>Comisión</span>
                            <span><strong>$0.00 MXN</strong></span>
                        </div>
                        <div class="rowline big">
                            <span>Total</span>
                            <span><%= fmtMXN(totalSafe) %></span>
                        </div>
                    </div>

                    <% if (!isOnline) { %>
                        <div class="note danger">
                            Selecciona <strong>Pago en línea</strong> para poder pagar con tarjeta.
                        </div>
                    <% } else if (isPaid) { %>
                        <div class="note">
                            ✅ Este pago ya está <strong>pagado</strong>. Puedes ver tu ticket en el resumen.
                        </div>
                    <% } else { %>
                        <button
                                id="openPayDrawer"
                                class="btn btn-primary btn-xs"
                                type="button"
                                <% if (!canMount) { %>disabled
                                <% } %>
                        >
                            🔒 Pagar ahora
                        </button>

                        <p class="hint m-0">
                            Se abre un panel con Stripe. Si ya pagaste y aparece pendiente, espera unos segundos y
                            recarga.
                        </p>
                    <% } %>
                </div>
            </div>
        </aside>
    </div>

    <div class="actions">
        <a class="btn btn-solid btn-xs" href="<%= payUrl %>">Ver resumen</a>
        <a class="btn btn-solid btn-xs" href="/reserve">Nueva reserva</a>
    </div>
</main>

<!-- Drawer -->
<div
        id="payDrawer"
        class="drawer"
        aria-hidden="true"
        data-can-mount="<%= canMount ? '1' : '0' %>"
        data-pk="<%= stripePublishableKey %>"
        data-token="<%= publicToken %>"
>
    <div class="backdrop" data-close-drawer="1"></div>

    <div class="panel" role="dialog" aria-modal="true" aria-label="Pago en línea">
        <div class="drawer-head">
            <div>
                <div class="pill">Pago en línea</div>
                <h3 class="drawer-title mt-2">Completa tu pago</h3>
                <p class="drawer-sub">Total: <strong><%= fmtMXN(totalSafe) %></strong></p>
            </div>

            <button id="drawerClose" class="close-btn" type="button" data-close-drawer="1" aria-label="Cerrar">
                ✕
            </button>
        </div>

        <div class="drawer-body">
            <div class="note">
                <strong>Seguro:</strong> el formulario pertenece a Stripe. Este sitio no guarda tu tarjeta.
            </div>

            <div class="embed-shell">
                <!-- Loading overlay (NOT inside mount) -->
                <div id="embedLoading" class="embed-loading">
                    <span class="mini-spinner"></span>
                    <span>Cargando formulario…</span>
                </div>

                <!-- MUST be EMPTY -->
                <div id="embedded-checkout" class="embed-mount"></div>
            </div>

            <div class="note">
                Si al finalizar no regresa solo, cierra el panel y vuelve al resumen.
            </div>
        </div>
    </div>
</div>

<script src="/js/theme.js"></script>

<script>
    (() => {
        const drawer = document.getElementById("payDrawer");
        const openBtn = document.getElementById("openPayDrawer");
        const mountEl = document.getElementById("embedded-checkout");
        const loadingEl = document.getElementById("embedLoading");

        if (!drawer || !mountEl) return;

        const canMount = drawer.dataset.canMount === "1";
        const publishableKey = drawer.dataset.pk || "";
        const publicToken = (drawer.dataset.token || "").trim();

        let sessionId = null;

        // I must keep ONLY one EmbeddedCheckout instance per page.
        let stripe = null;
        let checkout = null;
        let checkoutInitPromise = null;

        let mounting = false;
        let mountedOnce = false;

        function setLoading(on) {
            if (!loadingEl) return;
            loadingEl.style.display = on ? "flex" : "none";
        }

        function openDrawer() {
            drawer.classList.add("open");
            drawer.setAttribute("aria-hidden", "false");
            document.body.classList.add("drawer-open");

            // If iframe already exists, I hide the loader immediately.
            if (mountEl.querySelector("iframe")) setLoading(false);
        }

        function closeDrawer() {
            drawer.classList.remove("open");
            drawer.setAttribute("aria-hidden", "true");
            document.body.classList.remove("drawer-open");

            // ✅ I DO NOT unmount. I keep Stripe alive and mounted.
            if (mountEl.querySelector("iframe")) setLoading(false);
            else setLoading(true);
        }

        function safeTokenOrThrow() {
            if (!publicToken) throw new Error("Falta token público de reserva.");
            return publicToken;
        }

        async function fetchClientSecret() {
            const tok = encodeURIComponent(safeTokenOrThrow());

            const res = await fetch(`/checkout/t/${tok}/create-session`, {
                method: "POST",
                headers: {"Content-Type": "application/json"},
            });

            if (!res.ok) {
                const txt = await res.text().catch(() => "");
                throw new Error(txt || "No se pudo iniciar el pago.");
            }

            const data = await res.json();
            sessionId = data.sessionId;
            return data.clientSecret;
        }

        function watchIframeAndHideLoading() {
            if (mountEl.querySelector("iframe")) {
                setLoading(false);
                return;
            }

            const obs = new MutationObserver(() => {
                if (mountEl.querySelector("iframe")) {
                    setLoading(false);
                    try {
                        obs.disconnect();
                    } catch {
                    }
                }
            });
            obs.observe(mountEl, {childList: true, subtree: true});

            let ticks = 0;
            const timer = setInterval(() => {
                ticks++;
                if (mountEl.querySelector("iframe")) {
                    setLoading(false);
                    clearInterval(timer);
                    try {
                        obs.disconnect();
                    } catch {
                    }
                    return;
                }
                if (ticks >= 100) { // ~12s
                    clearInterval(timer);
                    try {
                        obs.disconnect();
                    } catch {
                    }
                    setLoading(false);
                    mountEl.classList.add("danger");
                    mountEl.textContent = "No se pudo cargar el formulario. Cierra y vuelve a intentar.";
                }
            }, 120);
        }

        async function ensureCheckoutInitialized() {
            if (checkout) return checkout;

            if (!publishableKey) {
                setLoading(false);
                mountEl.classList.add("danger");
                mountEl.textContent = "Falta STRIPE_PUBLISHABLE_KEY.";
                throw new Error("Missing STRIPE_PUBLISHABLE_KEY");
            }

            if (!stripe) stripe = Stripe(publishableKey);

            // I init only once (promise cache).
            if (!checkoutInitPromise) {
                checkoutInitPromise = stripe.initEmbeddedCheckout({
                    fetchClientSecret,
                    onComplete: () => {
                        const tok = encodeURIComponent(publicToken || "");
                        const sid = encodeURIComponent(sessionId || "");
                        window.location.href = `/pay/t/${tok}${sid ? `?session_id=${sid}` : ""}`;
                    },
                });
            }

            checkout = await checkoutInitPromise;
            return checkout;
        }

        async function ensureMountedOnce() {
            if (!canMount) return;
            if (mountedOnce) return;        // ✅ no remount
            if (mounting) return;
            mounting = true;

            try {
                mountEl.classList.remove("danger");
                if (mountEl.textContent) mountEl.textContent = "";

                // Stripe wants the mount empty the first time.
                try {
                    mountEl.replaceChildren();
                } catch {
                }

                setLoading(true);
                watchIframeAndHideLoading();

                const c = await ensureCheckoutInitialized();
                c.mount("#embedded-checkout");

                mountedOnce = true;
            } catch (e) {
                setLoading(false);
                mountEl.classList.add("danger");
                mountEl.textContent = `Error al cargar pago: ${String(e.message || e)}`;
            } finally {
                mounting = false;
            }
        }

        openBtn?.addEventListener("click", async () => {
            openDrawer();
            await ensureMountedOnce();
        });

        drawer.addEventListener("click", (ev) => {
            const t = ev.target;
            if (t && t.closest && t.closest("[data-close-drawer='1']")) closeDrawer();
        });

        document.addEventListener("keydown", (ev) => {
            if (ev.key === "Escape" && drawer.classList.contains("open")) closeDrawer();
        });
    })();
</script>

</body>
</html>
