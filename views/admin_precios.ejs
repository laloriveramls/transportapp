<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Admin precios',
    description: 'Tarifas base, ciudades y paradas.',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-horarios page-precios">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Precios', tag: 'Tarifas base, ciudades y paradas' }) %>

<main class="home-main admin-main">
<section class="container">
    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Precios y paradas</h2>
            <div class="home-tabs-tools">
                <%- include('partials/admin-nav', { adminNav: 'precios' }) %>
            </div>
        </div>
        <div class="home-tabs-body">
            <div class="horarios-toolbar">
                <div class="horarios-tabs-bar">
                    <div class="horarios-date-block">
                        <p class="horarios-date-label">Tarifas base, ciudades y paradas</p>
                        <p class="horarios-date-meta">Catálogo</p>
                    </div>
                    <div class="horarios-status">
                        <span class="status-pill" id="statusText">—</span>
                    </div>
                </div>
            </div>

            <div class="slots-wrap">
                <p class="hint visually-hidden" id="hint">Cargando…</p>
                <div id="list"></div>
            </div>
        </div>
    </div>
</section>
</main>

<%- include('partials/toast') %>
<%- include('partials/admin-footer') %>

<script>
    const listEl = document.getElementById("list");
    const hint = document.getElementById("hint");
    const statusText = document.getElementById("statusText");

    function ico(name, size) {
        return (window.Icons && typeof window.Icons.svg === "function")
            ? window.Icons.svg(name, { size: size || 14 })
            : "";
    }

    function escapeHtml(s){
        return String(s || "").replace(/[&<>"']/g, m => ({
            "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#039;"
        }[m]));
    }

    // Nunca lanza: devuelve {ok:false, message} si falla la red, la sesión expiró o la respuesta no es JSON.
    async function parseResponse(res){
        const type = String(res.headers.get("content-type") || "");
        if (res.redirected && /\/login/.test(res.url)) {
            return {ok: false, error: "Tu sesión expiró. Vuelve a iniciar sesión.", message: "Tu sesión expiró. Vuelve a iniciar sesión."};
        }
        if (!type.includes("application/json")) {
            const msg = res.status === 401 || res.status === 403
                ? "Tu sesión expiró. Vuelve a iniciar sesión."
                : `Respuesta inesperada del servidor (${res.status}).`;
            return {ok: false, error: msg, message: msg};
        }
        try {
            return await res.json();
        } catch {
            return {ok: false, error: "No pude leer la respuesta del servidor.", message: "No pude leer la respuesta del servidor."};
        }
    }

    async function apiGet(url){
        try {
            return await parseResponse(await fetch(url, {credentials: "same-origin"}));
        } catch {
            return {ok: false, error: "Sin conexión con el servidor.", message: "Sin conexión con el servidor."};
        }
    }

    async function apiPost(url, body){
        try {
            return await parseResponse(await fetch(url, {
                method: "POST",
                credentials: "same-origin",
                headers: {"Content-Type":"application/json"},
                body: JSON.stringify(body)
            }));
        } catch {
            return {ok: false, error: "Sin conexión con el servidor.", message: "Sin conexión con el servidor."};
        }
    }

    /* -----------------------------
       TAB: Precios
    ----------------------------- */
    async function loadPricing(){

        hint.textContent = "Cargando catálogo…";
        statusText.textContent = "";

        const data = await apiGet("/admin/api/pricing");
        if (!data?.ok){
            hint.textContent = "Error al cargar precios y lugares.";
            statusText.textContent = "—";
            listEl.innerHTML = "";
            return;
        }

        const locations = Array.isArray(data.locations) ? data.locations : [];

        const priceValue = (n) => String(Math.round(Number(n || 0) * 100) / 100);
        const passenger = priceValue(data.passenger_price_mxn);
        const pkg = priceValue(data.package_price_mxn);
        const child = priceValue(data.child_price_mxn ?? (Number(data.passenger_price_mxn || 0) / 2));
        const updated = data.updated_at ? String(data.updated_at) : "—";
        const vicLabel = escapeHtml(data.vic_label || data.city_labels?.VIC || "Ciudad Victoria");
        const lleLabel = escapeHtml(data.lle_label || data.city_labels?.LLE || "Llera");

        const moneyIco = ico("dollar-sign", 14);
        const mapIco = ico("map", 14);
        const userIco = ico("user", 14);
        const childIco = ico("users", 14);
        const pkgIco = ico("package", 14);
        const listIco = ico("list", 14);
        const pricePrefix = `<span class="price-input-prefix" aria-hidden="true">$</span>`;

        const locationRows = locations.map((loc) => {
            const active = Number(loc.active) !== 0;
            const code = escapeHtml(loc.code || "");
            return `
            <article class="loc-card ${active ? "" : "is-disabled"}" data-code="${code}">
                <div class="loc-card-head">
                    <div class="loc-card-id">
                        <span class="loc-code mono">${code}</span>
                        <label class="switch loc-switch" title="Visible en reserva">
                            <input class="l-active" type="checkbox" ${active ? "checked" : ""}>
                            <span class="switch-text">Activa</span>
                        </label>
                    </div>
                    <div class="loc-card-actions">
                        <button type="button" class="btn-mini btn-mini-primary l-save">${ico("check", 14)} Guardar</button>
                        <button type="button" class="btn-mini btn-mini-ghost l-disable" ${active ? "" : "disabled"}>${ico("ban", 14)} Desactivar</button>
                    </div>
                </div>
                <div class="loc-card-grid">
                    <label class="loc-field loc-field-name">
                        <span class="loc-field-label">${mapIco} Nombre</span>
                        <input class="l-label" type="text" maxlength="120" value="${escapeHtml(loc.label || "")}">
                    </label>
                    <label class="loc-field loc-field-price">
                        <span class="loc-field-label">→ Victoria</span>
                        <span class="price-input">
                            ${pricePrefix}
                            <input class="l-price-vic" type="number" min="0" step="any" inputmode="decimal" value="${priceValue(loc.price_to_victoria_mxn)}">
                        </span>
                    </label>
                    <label class="loc-field loc-field-price">
                        <span class="loc-field-label">→ Llera</span>
                        <span class="price-input">
                            ${pricePrefix}
                            <input class="l-price-lle" type="number" min="0" step="any" inputmode="decimal" value="${priceValue(loc.price_to_llera_mxn)}">
                        </span>
                    </label>
                    <label class="loc-field loc-field-order">
                        <span class="loc-field-label">${listIco} Orden</span>
                        <input class="l-order" type="number" min="0" step="1" inputmode="numeric" value="${Number(loc.sort_order || 0)}">
                    </label>
                </div>
            </article>`;
        }).join("");

        listEl.innerHTML = `
            <div class="pricing-desk">
                <section class="pricing-panel">
                    <div class="pricing-panel-head">
                        <div>
                            <h3 class="pricing-panel-title">${moneyIco} Tarifas base</h3>
                            <p class="pricing-panel-sub">Pasaje ciudad ↔ ciudad y nombres de origen/destino.</p>
                        </div>
                        <span class="pricing-updated">${updated !== "—" ? "Actualizado " + escapeHtml(updated) : "Sin fecha de actualización"}</span>
                    </div>

                    <div class="pricing-base-grid">
                        <label class="pricing-field pricing-field-price">
                            <span class="pricing-field-label">${userIco} Adulto</span>
                            <span class="price-input">
                                ${pricePrefix}
                                <input id="pPassenger" type="number" step="any" min="0" inputmode="decimal" value="${passenger}">
                            </span>
                        </label>
                        <label class="pricing-field pricing-field-price">
                            <span class="pricing-field-label">${childIco} Niño 6–10</span>
                            <span class="price-input">
                                ${pricePrefix}
                                <input id="pChild" type="number" step="any" min="0" inputmode="decimal" value="${child}">
                            </span>
                        </label>
                        <label class="pricing-field pricing-field-price">
                            <span class="pricing-field-label">${pkgIco} Paquete</span>
                            <span class="price-input">
                                ${pricePrefix}
                                <input id="pPackage" type="number" step="any" min="0" inputmode="decimal" value="${pkg}">
                            </span>
                        </label>
                        <label class="pricing-field">
                            <span class="pricing-field-label">${mapIco} Origen (Victoria)</span>
                            <input id="pVicLabel" type="text" maxlength="80" value="${vicLabel}">
                        </label>
                        <label class="pricing-field">
                            <span class="pricing-field-label">${mapIco} Destino (Llera)</span>
                            <input id="pLleLabel" type="text" maxlength="80" value="${lleLabel}">
                        </label>
                        <div class="pricing-base-actions">
                            <button class="btn btn-wine" type="button" id="savePricingBtn">${ico("check", 16)} Guardar tarifas</button>
                        </div>
                    </div>
                </section>

                <section class="pricing-panel">
                    <div class="pricing-panel-head">
                        <div>
                            <h3 class="pricing-panel-title">${mapIco} Paradas y ejidos</h3>
                            <p class="pricing-panel-sub">Tarifa del niño = mitad del ejido. Visible al reservar.</p>
                        </div>
                    </div>

                    <div class="loc-add-card" id="addLocationForm">
                        <div class="loc-add-title">${ico("plus", 14)} Nueva parada</div>
                        <div class="loc-add-grid">
                            <label class="loc-field">
                                <span class="loc-field-label">Código</span>
                                <input id="addLocCode" type="text" maxlength="40" placeholder="EJ_NUEVO" autocomplete="off">
                            </label>
                            <label class="loc-field loc-field-name">
                                <span class="loc-field-label">${mapIco} Nombre</span>
                                <input id="addLocLabel" type="text" maxlength="120" placeholder="Ej. Nueva parada">
                            </label>
                            <label class="loc-field loc-field-price">
                                <span class="loc-field-label">→ Victoria</span>
                                <span class="price-input">
                                    ${pricePrefix}
                                    <input id="addLocVic" type="number" min="0" step="any" inputmode="decimal" value="60">
                                </span>
                            </label>
                            <label class="loc-field loc-field-price">
                                <span class="loc-field-label">→ Llera</span>
                                <span class="price-input">
                                    ${pricePrefix}
                                    <input id="addLocLle" type="number" min="0" step="any" inputmode="decimal" value="60">
                                </span>
                            </label>
                            <label class="loc-field loc-field-order">
                                <span class="loc-field-label">${listIco} Orden</span>
                                <input id="addLocOrder" type="number" min="0" step="1" inputmode="numeric" value="${(locations.length + 1) * 10}">
                            </label>
                            <div class="loc-add-actions">
                                <button class="btn btn-wine" type="button" id="addLocBtn">${ico("plus", 14)} Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="loc-list">
                        ${locationRows || `<div class="pricing-empty muted">Aún no hay paradas configuradas.</div>`}
                    </div>
                </section>
            </div>
        `;

        hint.textContent = "Listo.";
        statusText.textContent = `${locations.length} lugares`;

        document.getElementById("savePricingBtn")?.addEventListener("click", async (ev) => {
            const btn = ev.currentTarget;
            btn.disabled = true;
            statusText.textContent = "Guardando tarifas…";

            const r = await apiPost("/admin/api/pricing", {
                passenger_price_mxn: Number(document.getElementById("pPassenger").value || 0),
                child_price_mxn: Number(document.getElementById("pChild").value || 0),
                package_price_mxn: Number(document.getElementById("pPackage").value || 0),
                vic_label: document.getElementById("pVicLabel").value || "",
                lle_label: document.getElementById("pLleLabel").value || "",
            });

            btn.disabled = false;
            if (!r?.ok){
                statusText.textContent = "—";
                notify(r?.message || r?.error || "No pude guardar tarifas.", {variant:"danger", delay:3500});
                return;
            }

            statusText.textContent = "Tarifas guardadas.";
            notify("Tarifas y nombres de ciudad guardados.", {variant:"success", delay:1600});
            load();
        });

        document.getElementById("addLocBtn")?.addEventListener("click", async (ev) => {
            const btn = ev.currentTarget;
            btn.disabled = true;
            statusText.textContent = "Agregando parada…";

            const r = await apiPost("/admin/api/locations/upsert", {
                code: document.getElementById("addLocCode").value || "",
                label: document.getElementById("addLocLabel").value || "",
                price_to_victoria_mxn: Number(document.getElementById("addLocVic").value || 0),
                price_to_llera_mxn: Number(document.getElementById("addLocLle").value || 0),
                sort_order: Number(document.getElementById("addLocOrder").value || 0),
                active: 1,
            });

            btn.disabled = false;
            if (!r?.ok){
                statusText.textContent = "—";
                notify(r?.error || "No pude agregar la parada.", {variant:"danger", delay:2200});
                return;
            }

            notify("Parada agregada.", {variant:"success", delay:1500});
            load();
        });

        listEl.querySelectorAll(".loc-card[data-code]").forEach((row) => {
            const code = row.dataset.code;
            const saveBtn = row.querySelector(".l-save");
            const disableBtn = row.querySelector(".l-disable");

            saveBtn?.addEventListener("click", async () => {
                saveBtn.disabled = true;
                statusText.textContent = "Guardando parada…";
                const r = await apiPost("/admin/api/locations/upsert", {
                    code,
                    label: row.querySelector(".l-label").value || "",
                    price_to_victoria_mxn: Number(row.querySelector(".l-price-vic").value || 0),
                    price_to_llera_mxn: Number(row.querySelector(".l-price-lle").value || 0),
                    sort_order: Number(row.querySelector(".l-order").value || 0),
                    active: row.querySelector(".l-active").checked ? 1 : 0,
                });
                saveBtn.disabled = false;
                if (!r?.ok){
                    statusText.textContent = "—";
                    notify(r?.error || "No pude guardar la parada.", {variant:"danger", delay:2200});
                    return;
                }
                statusText.textContent = "Parada actualizada.";
                notify("Parada guardada.", {variant:"success", delay:1400});
                load();
            });

            disableBtn?.addEventListener("click", async () => {
                const name = row.querySelector(".l-label")?.value || code;
                const ok = await Confirm.ask({
                    title: `Desactivar "${name}"`,
                    message: "Dejará de aparecer al reservar. Las reservas existentes no se modifican y puedes volver a activarla cuando quieras.",
                    confirmText: "Desactivar",
                    tone: "danger"
                });
                if (!ok) return;

                disableBtn.disabled = true;
                statusText.textContent = "Desactivando…";
                const r = await apiPost("/admin/api/locations/disable", { code });
                disableBtn.disabled = false;
                if (!r?.ok){
                    statusText.textContent = "—";
                    notify("No pude desactivar la parada.", {variant:"danger", delay:2200});
                    return;
                }
                notify("Parada desactivada.", {variant:"success", delay:1400});
                load();
            });
        });
    }


    const load = loadPricing;
    load();
</script>
</body>
</html>
