<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Reserva creada | Servicio de Transporte',
    description: 'Confirmación de reserva y folio. Envía tu folio por WhatsApp para confirmar rápidamente.',
    canonicalUrl: 'https://serviciodetransportevic.com/pay',
    noindex: true
    }) %>
</head>

<body class="page-pay">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<main class="container py-4">

    <%
    const type = (r.type || "").toUpperCase();
    const isPassenger = type === "PASSENGER";
    const isPackage = type === "PACKAGE";

    const payment = (r.payment_method || "TAQUILLA").toUpperCase();
    const status = (r.status || "").toUpperCase();

    const isOnline = payment === "ONLINE";
    const isPendingOnline = isOnline && (status === "PENDING_PAYMENT" || !status);
    const isPaid = status === "PAID";

    // I read the ticket code coming from transporte_tickets (passed by backend).
    const tkCode = (ticketCode || "").trim();
    const hasTicket = !!tkCode;

    const unit = Number(r.unit_price_mxn || 120);
    const seats = Number(r.seats || 0);

    const total =
            (r.amount_total_mxn != null && r.amount_total_mxn !== "")
                    ? Number(r.amount_total_mxn)
                    : (isPassenger ? unit * Math.max(1, seats) : unit);

    function fmtMXN(n){
        const v = Number(n || 0);
        return v.toLocaleString("es-MX", {style: "currency", currency: "MXN"});
    }

    function typeLabel(){
        return isPassenger ? "Pasaje" : "Paquetería";
    }

    function paymentLabel(){
        if (payment === "TAQUILLA") return "Taquilla";
        if (payment === "TRANSFERENCIA") return "Transferencia";
        if (payment === "ONLINE") return "Pago en línea";
        return payment;
    }

    function statusText(){
        if (!status) return "Pendiente de confirmación";
        if (status === "PAY_AT_BOARDING") return "Pago en taquilla";
        if (status === "PENDING_PAYMENT") return "Pendiente de pago";
        if (status === "PAID") return "Pagado";
        if (status === "CANCELLED") return "Cancelado";
        return status;
    }

    function statusClass() {
        if (status === "PAID") return "pill--ok";
        if (status === "CANCELLED") return "pill--bad";
        if (status === "PENDING_PAYMENT" || status === "PAY_AT_BOARDING" || !status) return "pill--warn";
        return "";
    }

    function headerMeta() {
        if (payment === "ONLINE") {
            if (status === "PAID") return "Tu pago fue confirmado. Guarda tu folio y comparte el resumen si lo necesitas.";
            return "Guarda tu folio. Si tu pago está pendiente, puedes completarlo aquí o escribirnos por WhatsApp.";
        }
        if (payment === "TRANSFERENCIA") {
            return "Guarda tu folio. Envía tu comprobante y folio por WhatsApp para confirmar más rápido.";
        }
        return "Guarda tu folio. Si necesitas confirmar rápido, envíalo por WhatsApp.";
    }

    function noteText(){
        if (payment === "TAQUILLA"){
            return "Tu reserva quedó registrada. El pago se realiza en taquilla. Puedes enviar el folio por WhatsApp para agilizar.";
        }
        if (payment === "TRANSFERENCIA"){
            return "Tu reserva quedó registrada. Envía el comprobante de transferencia junto con tu folio por WhatsApp para confirmar más rápido.";
        }
        if (payment === "ONLINE"){
            if (status === "PAID") return "Tu pago en línea fue confirmado. Conserva tu folio para cualquier aclaración.";
            return "Para confirmar tu reserva, completa el pago en línea. Si lo prefieres, también puedes escribirnos por WhatsApp.";
        }
        return "Tu reserva quedó registrada. Puedes enviar el folio por WhatsApp para agilizar.";
    }
    %>

    <div class="card-soft">
        <div class="top">
            <div class="header-row">
                <div class="header-left">
                    <div class="pills">
                        <div class="pill <%= statusClass() %>"><%- include('partials/icon', { name: 'check', size: 16 }) %> Reserva creada</div>
                        <div class="pill"><%- include('partials/icon', { name: 'receipt', size: 16 }) %> <%= statusText() %></div>
                        <div class="pill"><%- include('partials/icon', { name: 'credit-card', size: 16 }) %> <%= paymentLabel() %></div>
                    </div>

                    <h1 class="h3 title mt-2">Listo</h1>
                    <div class="meta mt-1"><%= headerMeta() %></div>
                </div>

                <div class="btn-group-top">
                    <% if (isPaid && hasTicket) { %>
                        <a class="btn btn-ghost btn-xs" href="/ticket/<%= tkCode %>" target="_blank" rel="noopener">
                            <%- include('partials/icon', { name: 'ticket', size: 16 }) %> Ver ticket
                        </a>
                        <a class="btn btn-pdf btn-xs" href="/ticket/<%= tkCode %>/pdf" target="_blank" rel="noopener">
                            <%- include('partials/icon', { name: 'pdf', size: 16 }) %> PDF
                        </a>
                    <% } %>

                        <a class="btn btn-wa btn-xs" id="waBtn" target="_blank" rel="noopener" href="#"><%- include('partials/icon', { name: 'whatsapp-light', size: 16 }) %> WhatsApp</a>
                </div>
            </div>

            <div class="folio-wrap">
                <div class="folio-box">
                    <div class="folio-left">
                        <div class="folio-label">Tu folio</div>
                        <div class="mono" id="folioText"><%= folio %></div>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                        <button type="button" class="btn btn-ghost btn-xs" id="copyBtn"><%- include('partials/icon', { name: 'copy', size: 16 }) %> Copiar</button>
                        <span class="copy-toast" id="copyToast"><img src="/assets/icons/check.svg" alt="" class="ico" width="14" height="14" aria-hidden="true"> Copiado</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="body">

            <div class="summary">
                <% if (isPendingOnline) { %>
                    <div class="note-strong">
                        <div class="note-title"><%- include('partials/icon', { name: 'credit-card', size: 16 }) %> Pago en línea pendiente</div>
                        <div class="mt-1" style="color: var(--muted);">
                            Total a pagar:
                            <span style="color: var(--text); font-weight: 650;"><%= fmtMXN(total) %></span>
                        </div>

                        <div class="sub-actions">
                            <a class="btn btn-wine btn-xs"
                               href="/checkout/t/<%= encodeURIComponent(publicToken || "") %>">
                                <%- include('partials/icon', { name: 'lock', size: 16 }) %> Pagar ahora
                            </a>
                            <button type="button" class="btn btn-ghost btn-xs" id="refreshStatusBtn"><%- include('partials/icon', { name: 'refresh', size: 16 }) %> Actualizar
                            </button>
                            <a class="btn btn-ghost btn-xs" href="/reserve"><%- include('partials/icon', { name: 'plus', size: 16 }) %> Nueva reserva</a>
                        </div>
                    </div>
                <% } %>

                <% if (isPaid && !hasTicket) { %>
                    <div class="note-strong">
                        <div class="note-title"><%- include('partials/icon', { name: 'check', size: 16 }) %> Pago confirmado</div>
                        <div class="mt-1" style="color: var(--muted);">
                            Estamos generando tu ticket. Si no aparece todavía, presiona Actualizar.
                        </div>
                        <div class="sub-actions">
                            <button type="button" class="btn btn-ghost btn-xs" id="refreshStatusBtn2"><%- include('partials/icon', { name: 'refresh', size: 16 }) %> Actualizar
                            </button>
                        </div>
                    </div>
                <% } %>

                <% if (isPaid && hasTicket) { %>
                    <div class="note-strong">
                        <div class="note-title"><%- include('partials/icon', { name: 'ticket', size: 16 }) %> Ticket listo</div>
                        <div class="mt-1" style="color: var(--muted);">
                            Ya puedes abrir tu ticket o descargar el PDF.
                        </div>
                        <div class="sub-actions">
                            <a class="btn btn-ghost btn-xs" href="/ticket/<%= tkCode %>" target="_blank" rel="noopener"><%- include('partials/icon', { name: 'ticket', size: 16 }) %>
                                Ver ticket</a>
                            <a class="btn btn-pdf btn-xs" href="/ticket/<%= tkCode %>/pdf" target="_blank"
                               rel="noopener"><%- include('partials/icon', { name: 'pdf', size: 16 }) %> PDF</a>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="details-card mb-3">
                <p class="details-title">Detalles de la reserva</p>

                <ul class="kv">
                    <li><span class="k">Tipo</span><span class="v"><%= typeLabel() %></span></li>

                    <% if (isPassenger) { %>
                        <li><span class="k">Pasajeros</span><span
                                    class="v"><%= Math.max(1, Number(r.seats || 1)) %></span></li>
                    <% } %>

                    <% if (isPackage) { %>
                        <li><span class="k">Detalle</span><span class="v"><%= (r.package_details || "-") %></span></li>
                    <% } %>

                    <li><span class="k">Ruta</span><span
                                class="v"><%= typeof routeLabel !== "undefined" ? routeLabel : (r.direction === "VIC_TO_LLE" ? "Victoria - Llera" : "Llera - Victoria") %></span>
                    </li>
                    <li><span class="k">Fecha</span><span class="v"><%= r.trip_date %></span></li>
                    <li><span class="k">Hora</span><span class="v"><%= r.depart_time %></span></li>

                    <li><span class="k">Contacto</span><span class="v"><%= r.customer_name %></span></li>
                    <li><span class="k">Teléfono</span><span class="v" id="phoneText"><%= r.phone %></span></li>

                    <li><span class="k">Método de pago</span><span class="v"><%= paymentLabel() %></span></li>

                    <% if (payment === "TRANSFERENCIA" && r.transfer_ref) { %>
                        <li><span class="k">Referencia</span><span class="v"><%= r.transfer_ref %></span></li>
                    <% } %>

                    <li><span class="k">Precio</span><span class="v"><%= fmtMXN(unit) %></span></li>
                    <li><span class="k">Total</span><span class="v"><%= fmtMXN(total) %></span></li>

                    <li><span class="k">Estado</span><span class="v"><%= statusText() %></span></li>

                    <% if (isPaid && hasTicket) { %>
                        <li><span class="k">Ticket</span><span class="v"><%= tkCode %></span></li>
                    <% } %>
                </ul>
            </div>

            <div class="note">
                <%= noteText() %>
            </div>

            <div class="mt-3 bottom-actions">
                <a class="btn btn-ghost btn-xs" href="/reserve"><%- include('partials/icon', { name: 'plus', size: 16 }) %> Nueva reserva</a>
                <a class="btn btn-ghost btn-xs" href="/"><%- include('partials/icon', { name: 'home', size: 16 }) %> Volver al inicio</a>
            </div>
        </div>
    </div>

</main>

<script src="/js/theme.js"></script>

<script type="application/json" id="reservationData">
<%- JSON.stringify({
        folio,
        public_token: (publicToken || ""),
        direction: r.direction,
        route_label: (typeof routeLabel !== "undefined" ? routeLabel : ""),
        trip_date: r.trip_date,
        depart_time: r.depart_time,
        customer_name: r.customer_name,
        phone: r.phone,

        type: r.type || "",
        seats: r.seats || 0,
        package_details: r.package_details || "",

        payment_method: r.payment_method || "TAQUILLA",
        transfer_ref: r.transfer_ref || null,
        status: r.status || "",

        ticket_code: (ticketCode || ""),

        unit_price_mxn: r.unit_price_mxn || 120,
        amount_total_mxn: r.amount_total_mxn || null
    }) %>
</script>

<script>
    // I build a friendly WhatsApp message with the reservation details.
    const copyBtn = document.getElementById("copyBtn");
    const copyToast = document.getElementById("copyToast");
    const waBtn = document.getElementById("waBtn");

    const adminWa = "8344756376";

    function digitsOnly(s){ return String(s || "").replace(/\D/g, ""); }

    let data = {};
    try {
        const raw = document.getElementById("reservationData")?.textContent || "{}";
        data = JSON.parse(raw);
    } catch {
        data = {};
    }

    function niceRoute(dir){
        if (data.route_label) return String(data.route_label).replace(" → ", " a ");
        return dir === "VIC_TO_LLE" ? "Victoria a Llera" : "Llera a Victoria";
    }

    function niceType(t){
        const x = String(t || "").toUpperCase();
        if (x === "PACKAGE") return "Paquetería";
        if (x === "PASSENGER") return "Pasaje";
        return t ? t : "No especificado";
    }

    function nicePayment(m){
        const x = String(m || "TAQUILLA").toUpperCase();
        if (x === "TAQUILLA") return "Taquilla";
        if (x === "TRANSFERENCIA") return "Transferencia";
        if (x === "ONLINE") return "Pago en línea";
        return x;
    }

    function niceStatus(st){
        const x = String(st || "").toUpperCase();
        if (!x) return "Pendiente de confirmación";
        if (x === "PAY_AT_BOARDING") return "Pago en taquilla";
        if (x === "PENDING_PAYMENT") return "Pendiente de pago";
        if (x === "PAID") return "Pagado";
        if (x === "CANCELLED") return "Cancelado";
        return x;
    }

    function formatMXN(n){
        const v = Number(n || 0);
        return v.toLocaleString("es-MX", {style: "currency", currency: "MXN"});
    }

    const typeLabel = niceType(data.type);
    const isPassenger = String(data.type || "").toUpperCase() === "PASSENGER";
    const isPackage = String(data.type || "").toUpperCase() === "PACKAGE";

    const seats = Number(data.seats || 0);
    const unit = Number(data.unit_price_mxn || 120);

    const total =
        (data.amount_total_mxn != null && data.amount_total_mxn !== "")
            ? Number(data.amount_total_mxn)
            : (isPassenger ? unit * Math.max(1, seats) : unit);

    const payLabel = nicePayment(data.payment_method);
    const transferRef = data.transfer_ref ? String(data.transfer_ref) : "";
    const statusLabel = niceStatus(data.status);

    const lines = [
        "Hola, acabo de realizar una reserva y me gustaría que me ayuden a confirmarla.",
        "",
        "Datos de la reserva",
        "-------------------",
        `Folio: ${data.folio || "-"}`,
        `Nombre: ${data.customer_name || "-"}`,
        `Teléfono: ${data.phone || "-"}`,
        `Tipo: ${typeLabel}`,
        isPassenger ? `Pasajeros: ${Math.max(1, Number(seats || 1))}` : null,
        `Ruta: ${niceRoute(data.direction)}`,
        `Fecha: ${data.trip_date || "-"}`,
        `Hora: ${data.depart_time || "-"}`,
        `Método de pago: ${payLabel}`,
        (String(data.payment_method || "").toUpperCase() === "TRANSFERENCIA" && transferRef)
            ? `Referencia: ${transferRef}`
            : null,
        `Total a pagar: ${formatMXN(total)}`,
        `Estado: ${statusLabel}`,
        isPackage ? "" : null,
        isPackage ? "Detalles de paquetería" : null,
        isPackage ? "---------------------" : null,
        isPackage ? (data.package_details ? String(data.package_details) : "-") : null
    ].filter(Boolean);

    const msg = lines.join("\n");

    const adminDigits = digitsOnly(adminWa);
    if (adminDigits.length >= 10) {
        waBtn.href = `https://wa.me/52${adminDigits}?text=${encodeURIComponent(msg)}`;
    } else {
        waBtn.classList.add("disabled");
        waBtn.setAttribute("aria-disabled","true");
        waBtn.href = "#";
    }

    copyBtn?.addEventListener("click", async () => {
        try{
            await navigator.clipboard.writeText(String(data.folio || ""));
            copyToast.style.display = "inline";
            clearTimeout(window.__copyToastTimer);
            window.__copyToastTimer = setTimeout(() => copyToast.style.display = "none", 1200);
        } catch {
            alert("No pude copiar. Selecciona el folio manualmente.");
        }
    });

    const refreshBtn = document.getElementById("refreshStatusBtn");
    refreshBtn?.addEventListener("click", () => location.reload());

    const refreshBtn2 = document.getElementById("refreshStatusBtn2");
    refreshBtn2?.addEventListener("click", () => location.reload());

    (function autoRefreshAfterStripe() {
        const params = new URLSearchParams(window.location.search);
        const sid = params.get("session_id");
        if (!sid) return;

        const st = String(data.status || "").toUpperCase();
        if (st === "PAID") return;

        let tries = 0;
        const maxTries = 5;

        const timer = setInterval(() => {
            tries++;
            if (tries > maxTries) return clearInterval(timer);
            location.reload();
        }, 2500);
    })();
</script>
</body>
</html>
