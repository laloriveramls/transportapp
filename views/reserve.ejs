<!doctype html>
<html lang="es-MX" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Reservar viaje Victoria ↔ Llera | Servicio de Transporte',
    description: 'Reserva pasaje o paquetería entre Ciudad Victoria y Llera. Elige ruta, fecha y horario con cupo. Paga en taquilla, transferencia o en línea.',
    canonicalUrl: (typeof baseUrl !== 'undefined' ? String(baseUrl).replace(/\/+$/, '') : 'https://serviciodetransportevic.com') + '/reserve'
    }) %>

    <!-- ✅ Inyecto pricing sin romper el JS del editor -->
    <script id="pricingJson" type="application/json"><%- JSON.stringify(
                (typeof pricing !== "undefined" && pricing) ? pricing : {
                    passenger_price_mxn: 120,
                    package_price_mxn: 120,
                    child_price_mxn: 60
                }
        ) %></script>
    <script id="vicLocationsJson" type="application/json"><%- JSON.stringify(
                (typeof vicLocations !== "undefined" && vicLocations) ? vicLocations : []
        ) %></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/css/home.css" rel="stylesheet">
    <link href="/css/reserve.css" rel="stylesheet">
</head>

<body class="page-reserve home-page">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<section class="home-hero" aria-label="Reservar">
    <div class="home-hero-media" role="img" aria-label="Carretera hacia el destino"></div>
    <div class="home-hero-veil" aria-hidden="true"></div>

    <div class="container home-hero-inner">
        <div class="home-brand home-reveal">
            <div class="logo-wrap">
                <a href="/" aria-label="Ir al inicio">
                    <img class="home-brand-logo home-brand-logo-wide" src="/assets/logo-wide.png" alt="Servicio de Transporte Victoria ↔ Llera" width="960" height="360" decoding="async">
                </a>
            </div>
            <div class="home-brand-copy visually-hidden">
                <p class="home-kicker">Victoria - Llera</p>
                <h1 class="home-brand-name">Reservar viaje Victoria ↔ Llera</h1>
                <p class="home-brand-tag">Pasaje y paquetería entre Ciudad Victoria y Llera de Canales. Ruta, fecha y horario con cupo.</p>
            </div>
        </div>

        <div class="hero-actions home-reveal home-reveal-delay">
            <a class="btn home-cta-ghost" href="/">
                <span class="btn-ico"><%- include('partials/icon', { name: 'house', size: 18 }) %></span>
                Inicio
            </a>
            <a class="btn btn-wine home-cta-primary" target="_blank" rel="noopener noreferrer"
               href="https://wa.me/52<%= ('8344756376').replace(/\D/g, '') %>?text=<%= encodeURIComponent('Hola, quiero reservar un viaje.') %>">
                <span class="btn-ico"><%- include('partials/icon', { name: 'message-circle', size: 18 }) %></span>
                WhatsApp
            </a>
        </div>
    </div>
</section>

<main class="home-main reserve-main">
    <section class="container" aria-label="Formulario de reserva">
        <% if (error) { %>
            <div class="reserve-alert" role="alert"><%= error %></div>
        <% } %>

        <form id="reserveForm" method="POST" action="/reserve" class="reserve-form" novalidate>
            <div class="tabs-card home-tabs reserve-shell">
                <div class="home-tabs-head">
                    <h2 class="home-section-title">Tu reserva</h2>
                    <div class="home-tabs-tools">
                        <div class="nav nav-tabs home-seg wizard-steps" role="tablist" aria-label="Progreso de la reserva">
                            <button type="button" class="nav-link wizard-step is-active active" data-step-target="1">
                                <span class="wizard-ico wizard-ico-now" aria-hidden="true"><%- include('partials/icon', { name: 'map', size: 14 }) %></span>
                                <span class="wizard-ico wizard-ico-done" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 14 }) %></span>
                                <span class="wizard-lbl">Viaje</span>
                            </button>
                            <button type="button" class="nav-link wizard-step" data-step-target="2">
                                <span class="wizard-ico wizard-ico-now" aria-hidden="true"><%- include('partials/icon', { name: 'user', size: 14 }) %></span>
                                <span class="wizard-ico wizard-ico-done" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 14 }) %></span>
                                <span class="wizard-lbl">Datos</span>
                            </button>
                            <button type="button" class="nav-link wizard-step" data-step-target="3">
                                <span class="wizard-ico wizard-ico-now" aria-hidden="true"><%- include('partials/icon', { name: 'credit-card', size: 14 }) %></span>
                                <span class="wizard-ico wizard-ico-done" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 14 }) %></span>
                                <span class="wizard-lbl">Pago</span>
                            </button>
                            <button type="button" class="nav-link wizard-step" data-step-target="4">
                                <span class="wizard-ico wizard-ico-now" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 14 }) %></span>
                                <span class="wizard-ico wizard-ico-done" aria-hidden="true"><%- include('partials/icon', { name: 'check', size: 14 }) %></span>
                                <span class="wizard-lbl">Listo</span>
                            </button>
                        </div>
                        <a class="home-tabs-wa" href="tel:+528344756376" title="Llamar al 834 475 6376">
                            <span class="home-tabs-wa-ico" aria-hidden="true"><%- include('partials/icon', { name: 'phone', size: 16 }) %></span>
                            <span class="home-tabs-wa-phone">834 475 6376</span>
                        </a>
                    </div>
                </div>

                <div class="home-tabs-body">
                <div class="form-step is-active" data-step="1">
                    <div class="step-card trip-step">
                        <div class="trip-layout">
                            <section class="trip-section trip-section-route">
                                <h3 class="trip-section-title">Ruta</h3>
                                <div class="route-grid">
                                    <div>
                                        <label class="form-label" for="from_city">Origen</label>
                                        <select id="from_city" name="from_stop" class="form-select" required>
                                            <%- include('partials/stop-options', { selected: 'VIC' }) %>
                                        </select>
                                    </div>

                                    <button type="button" class="route-swap" id="swapRouteBtn" aria-label="Intercambiar origen y destino">
                                        <%- include('partials/icon', { name: 'arrow-left-right', size: 18 }) %>
                                    </button>

                                    <div>
                                        <label class="form-label" for="to_city">Destino</label>
                                        <select id="to_city" name="to_stop" class="form-select" required>
                                            <%- include('partials/stop-options', { selected: 'LLE' }) %>
                                        </select>
                                    </div>
                                </div>
                                <input type="hidden" id="direction" name="direction" value="VIC_TO_LLE">
                                <input type="hidden" id="vic_location" name="vic_location" value="">
                            </section>

                            <section class="trip-section trip-section-details">
                                <h3 class="trip-section-title">Fecha y viajeros</h3>
                                <div class="trip-details-grid">
                                    <div>
                                        <label class="form-label" for="trip_date">Fecha</label>
                                        <div class="field-ico-wrap">
                                            <span class="field-ico" aria-hidden="true"><%- include('partials/icon', { name: 'calendar', size: 16 }) %></span>
                                            <input id="trip_date" name="trip_date" type="date" class="form-control" required>
                                        </div>
                                    </div>
                                    <div>
                                        <span class="form-label">Servicio</span>
                                        <select id="type" name="type" class="visually-hidden" required tabindex="-1">
                                            <option value="PASSENGER" selected>Pasaje</option>
                                            <option value="PACKAGE">Paquetería</option>
                                        </select>
                                        <div class="seg-pills" role="group" aria-label="Tipo de servicio">
                                            <button type="button" class="seg-pill is-on" data-set-type="PASSENGER">
                                                <%- include('partials/icon', { name: 'users', size: 14 }) %>
                                                Pasaje
                                            </button>
                                            <button type="button" class="seg-pill" data-set-type="PACKAGE">
                                                <%- include('partials/icon', { name: 'package', size: 14 }) %>
                                                Paquetería
                                            </button>
                                        </div>
                                    </div>

                                    <div class="trip-pax" id="passengerGroup">
                                        <div class="traveler-grid">
                                            <div class="stepper-field" id="seatsWrap">
                                                <label class="form-label">Adultos</label>
                                                <div class="stepper">
                                                    <button id="minusBtn" type="button" class="btn-step" aria-label="Disminuir adultos"><%- include('partials/icon', { name: 'minus', size: 16 }) %></button>
                                                    <div class="count"><span id="seatsText">1</span></div>
                                                    <button id="plusBtn" type="button" class="btn-step" aria-label="Aumentar adultos"><%- include('partials/icon', { name: 'plus', size: 16 }) %></button>
                                                    <select id="seats" name="seats" class="d-none">
                                                        <option value="0">0</option>
                                                        <option value="1" selected>1</option>
                                                        <option value="2">2</option>
                                                        <option value="3">3</option>
                                                        <option value="4">4</option>
                                                        <option value="5">5</option>
                                                        <option value="6">6</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="stepper-field" id="childSeatsWrap">
                                                <label class="form-label">Niños 6-10 años</label>
                                                <div class="stepper">
                                                    <button id="childMinusBtn" type="button" class="btn-step" aria-label="Disminuir niños"><%- include('partials/icon', { name: 'minus', size: 16 }) %></button>
                                                    <div class="count"><span id="childSeatsText">0</span></div>
                                                    <button id="childPlusBtn" type="button" class="btn-step" aria-label="Aumentar niños"><%- include('partials/icon', { name: 'plus', size: 16 }) %></button>
                                                    <select id="child_seats" name="child_seats" class="d-none">
                                                        <option value="0" selected>0</option>
                                                        <option value="1">1</option>
                                                        <option value="2">2</option>
                                                        <option value="3">3</option>
                                                        <option value="4">4</option>
                                                        <option value="5">5</option>
                                                        <option value="6">6</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="trip-note" id="passengerCapHint">
                                            <span aria-hidden="true"><%- include('partials/icon', { name: 'info', size: 14 }) %></span>
                                            <span>La disponibilidad se calcula con adultos + niños.</span>
                                        </div>
                                    </div>

                                    <div class="trip-pkg" id="packageWrap">
                                        <label class="form-label" for="package_details">Detalle paquetería</label>
                                        <input id="package_details" name="package_details" class="form-control"
                                               placeholder="Ej: sobre, refacciones, etc.">
                                    </div>
                                </div>
                            </section>

                            <aside class="trip-quote" aria-live="polite">
                                <p class="trip-quote-k">Estimado</p>
                                <p class="trip-quote-total" id="tripQuoteTotal">$0</p>
                                <p class="trip-quote-route" id="tripQuoteRoute">Ciudad Victoria → Llera</p>
                                <div class="trip-quote-breakdown" id="tripQuoteBreakdown"></div>
                            </aside>

                            <section class="trip-section trip-section-slots">
                                <h3 class="trip-section-title">Horario</h3>
                                <input type="hidden" id="depart_time" name="depart_time" value="">
                                <div class="slots-wrap schedule-wrap is-featured">
                                    <div id="slotsLoading" class="help slots-loading"></div>
                                    <div id="sections" class="d-none">
                                        <div class="slot-section" id="morningSection">
                                            <div class="section-label"><%- include('partials/icon', { name: 'sunrise', size: 16 }) %> Mañana</div>
                                            <div id="morningSlots" class="slots"></div>
                                        </div>
                                        <div class="slot-section" id="afternoonSection">
                                            <div class="section-label"><%- include('partials/icon', { name: 'sunset', size: 16 }) %> Tarde</div>
                                            <div id="afternoonSlots" class="slots"></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="departTimeError" class="step-inline-error d-none"></div>
                            </section>
                        </div>

                        <div class="step-actions">
                            <button type="button" class="btn btn-wine" data-next-step>
                                Siguiente <%- include('partials/icon', { name: 'arrow-right', size: 16 }) %>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-step" data-step="2">
                    <div class="step-card">
                        <h2 class="step-title">Datos de contacto</h2>
                        <div class="reserve-panel">
                            <div class="choice-grid">
                                <div id="contactNameWrap">
                                    <label class="form-label" for="customer_name">Nombre de contacto</label>
                                    <input id="customer_name" name="customer_name" class="form-control" required
                                           placeholder="Ej: Juan Martínez">
                                </div>
                                <div>
                                    <label class="form-label" for="phone">Teléfono</label>
                                    <input id="phone" name="phone" class="form-control" required
                                           inputmode="numeric" pattern="[0-9]{10}" placeholder="Ej: 8344756376">
                                    <div class="invalid-feedback">Ingresa un teléfono válido (10 dígitos).</div>
                                </div>
                            </div>
                        </div>

                        <div class="reserve-panel" id="passengerNamesWrap">
                            <div class="form-check form-switch m-0 names-toggle" id="namesToggleWrap">
                                <input class="form-check-input" type="checkbox" id="namesToggle">
                                <label class="form-check-label" for="namesToggle">Capturar nombres de pasajeros</label>
                            </div>
                            <div class="form-text mt-1">Puedes omitir los nombres y solo usar el contacto.</div>
                            <div id="passengerNamesBox" class="mt-2 d-none">
                                <div id="passengerNames" class="row g-2"></div>
                                <div class="form-text">Si activas esta opción, capturamos un nombre por asiento.</div>
                            </div>
                        </div>

                        <div class="step-actions">
                            <button type="button" class="btn btn-ghost" data-prev-step>
                                <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %> Anterior
                            </button>
                            <button type="button" class="btn btn-wine" data-next-step>
                                Siguiente <%- include('partials/icon', { name: 'arrow-right', size: 16 }) %>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-step" data-step="3">
                    <div class="step-card">
                        <h2 class="step-title">Pago</h2>
                        <div class="reserve-panel">
                            <span class="form-label">Método de pago</span>
                            <select id="payment_method" name="payment_method" class="visually-hidden" required tabindex="-1">
                                <option value="TAQUILLA" selected>Taquilla</option>
                                <option value="TRANSFERENCIA">Transferencia</option>
                                <option value="ONLINE">Pago en línea</option>
                            </select>
                            <div class="pay-pills" role="group" aria-label="Método de pago">
                                <button type="button" class="pay-pill is-on" data-set-pay="TAQUILLA">
                                    <span class="pay-pill-ico" aria-hidden="true"><%- include('partials/icon', { name: 'banknote', size: 18 }) %></span>
                                    <span class="pay-pill-copy">
                                        <span class="pay-pill-title">Taquilla</span>
                                        <span class="pay-pill-sub">Pagar en oficina Llera</span>
                                    </span>
                                </button>
                                <button type="button" class="pay-pill" data-set-pay="TRANSFERENCIA">
                                    <span class="pay-pill-ico" aria-hidden="true"><%- include('partials/icon', { name: 'landmark', size: 18 }) %></span>
                                    <span class="pay-pill-copy">
                                        <span class="pay-pill-title">Transferencia</span>
                                        <span class="pay-pill-sub">SPEI o depósito</span>
                                    </span>
                                </button>
                                <button type="button" class="pay-pill" data-set-pay="ONLINE">
                                    <span class="pay-pill-ico" aria-hidden="true"><%- include('partials/icon', { name: 'credit-card', size: 18 }) %></span>
                                    <span class="pay-pill-copy">
                                        <span class="pay-pill-title">En línea</span>
                                        <span class="pay-pill-sub">Pago con tarjeta</span>
                                    </span>
                                </button>
                            </div>
                        </div>

                        <div class="reserve-panel">
                            <div class="slots-wrap price-wrap">
                                <div class="slots-head">
                                    <p class="slots-title mb-0">Total a pagar</p>
                                    <div class="slots-sub" id="priceHint">Cargando precio…</div>
                                </div>
                                <div class="price-summary">
                                    <div class="price-total-row">
                                        <span class="pill"><%- include('partials/icon', { name: 'dollar-sign', size: 16 }) %> <span id="priceTotal">$0</span></span>
                                    </div>
                                    <div class="price-breakdown" id="priceBreakdown"></div>
                                </div>
                            </div>
                        </div>

                        <div class="d-none" id="transferWrap">
                            <div class="reserve-panel">
                                <div class="slots-head">
                                    <p class="slots-title mb-0">Datos para transferencia</p>
                                    <div class="slots-sub">Transfiere y comparte el comprobante por WhatsApp.</div>
                                </div>
                                <div class="transfer-grid" aria-label="Datos bancarios">
                                    <div class="transfer-item">
                                        <span class="transfer-key">Banco</span>
                                        <span class="transfer-value" id="bankName">BBVA</span>
                                    </div>
                                    <div class="transfer-item">
                                        <span class="transfer-key">Beneficiario</span>
                                        <span class="transfer-value" id="bankOwner">Gary Treviño</span>
                                    </div>
                                    <div class="transfer-item">
                                        <span class="transfer-key">Numero de tarjeta</span>
                                        <span class="transfer-value mono" id="bankClabe">4152 3142 8477 3416</span>
                                    </div>
                                </div>
                                <div class="transfer-actions">
                                    <button type="button" class="tbtn" id="copyClabeBtn" aria-label="Copiar número de tarjeta">
                                        <span class="tbtn-ic" aria-hidden="true">
                                            <%- include('partials/icon', { name: 'copy', size: 14 }) %>
                                        </span>
                                        <span class="tbtn-txt">Copiar tarjeta</span>
                                    </button>
                                    <button type="button" class="tbtn" id="copyTransferMsgBtn" aria-label="Copiar mensaje de transferencia">
                                        <span class="tbtn-ic" aria-hidden="true">
                                            <%- include('partials/icon', { name: 'receipt', size: 14 }) %>
                                        </span>
                                        <span class="tbtn-txt">Copiar mensaje</span>
                                    </button>
                                </div>
                                <div class="transfer-tip">
                                    <strong>Concepto sugerido:</strong> “Servicio de transporte”
                                    <span class="subtle">(tu folio se genera al finalizar)</span>.
                                    <br>
                                    Después, envíanos el comprobante por WhatsApp para confirmar.
                                </div>
                                <div class="transfer-ref d-none">
                                    <label class="form-label" for="transfer_ref">Referencia / folio de transferencia (opcional)</label>
                                    <input id="transfer_ref" name="transfer_ref" class="form-control"
                                           placeholder="Ej: 123456 / SPEI / concepto">
                                    <div class="form-text">Si ya hiciste la transferencia, pega aquí la referencia.</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-none" id="onlineWrap">
                            <div class="alert alert-info mb-0">
                                <strong>Pago en línea:</strong> al confirmar la reserva te llevaremos al pago del pasaje.
                            </div>
                        </div>

                        <div class="step-actions">
                            <button type="button" class="btn btn-ghost" data-prev-step>
                                <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %> Anterior
                            </button>
                            <button type="button" class="btn btn-wine" data-next-step>
                                Siguiente <%- include('partials/icon', { name: 'arrow-right', size: 16 }) %>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-step" data-step="4">
                    <div class="step-card">
                        <div class="confirm-head">
                            <h2 class="step-title mb-0">Confirmación</h2>
                            <span class="confirm-pill">Revisa antes de enviar</span>
                        </div>
                        <div class="reserve-panel">
                            <div class="confirm-grid">
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'map', size: 14 }) %> Ruta</span>
                                    <span class="confirm-v" id="sumRoute">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'calendar', size: 14 }) %> Fecha</span>
                                    <span class="confirm-v" id="sumDate">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'clock', size: 14 }) %> Hora</span>
                                    <span class="confirm-v" id="sumTime">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'ticket', size: 14 }) %> Tipo</span>
                                    <span class="confirm-v" id="sumType">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'users', size: 14 }) %> Pasajeros</span>
                                    <span class="confirm-v" id="sumSeats">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'credit-card', size: 14 }) %> Pago</span>
                                    <span class="confirm-v" id="sumPayment">-</span>
                                </div>
                                <div class="confirm-item total-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'dollar-sign', size: 14 }) %> Total</span>
                                    <span class="confirm-v total-value" id="sumTotal">-</span>
                                </div>
                                <div class="confirm-item">
                                    <span class="confirm-k"><%- include('partials/icon', { name: 'user', size: 14 }) %> Contacto</span>
                                    <span class="confirm-v" id="sumContact">-</span>
                                </div>
                            </div>
                        </div>

                        <div class="cancel-policy">
                            <p class="cancel-title"><%- include('partials/icon', { name: 'info', size: 14 }) %> Política de cancelación</p>
                            <p class="cancel-text">Envía tu ticket con al menos 1 hora de anticipación para solicitar devolución.</p>
                        </div>

                        <div class="step-actions reserve-actions">
                            <button type="button" class="btn btn-ghost" data-prev-step>
                                <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %> Anterior
                            </button>
                            <button class="btn btn-wine reserve-submit">
                                <%- include('partials/icon', { name: 'check', size: 16 }) %> Confirmar reserva
                            </button>
                            <a class="btn btn-ghost reserve-cancel" href="/">
                                <%- include('partials/icon', { name: 'x', size: 16 }) %> Cancelar
                            </a>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        </form>
    </section>
</main>

<%- include('partials/site-footer') %>

<%- include('partials/toast') %>
<%- include('partials/footer') %>

<script>
    const tripDate = document.getElementById("trip_date");

    const fromCity = document.getElementById("from_city");
    const toCity = document.getElementById("to_city");
    const directionInput = document.getElementById("direction");
    const vicLocationHidden = document.getElementById("vic_location");

    const typeSel = document.getElementById("type");

    const seatsWrap = document.getElementById("seatsWrap");
    const childSeatsWrap = document.getElementById("childSeatsWrap");
    const passengerCapHint = document.getElementById("passengerCapHint");
    const passengerGroup = document.getElementById("passengerGroup");
    const seatsSel = document.getElementById("seats");
    const seatsText = document.getElementById("seatsText");
