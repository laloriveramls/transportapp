    function paymentLabel(v) {
        if (v === "TAQUILLA") return "Taquilla";
        if (v === "TRANSFERENCIA") return "Transferencia";
        if (v === "ONLINE") return "Pago en linea";
        return "-";
    }

    function updateStepOnePreview() {
        const routeEl = document.getElementById("tripPreviewRoute");
        const dateEl = document.getElementById("tripPreviewDate");
        const paxEl = document.getElementById("tripPreviewPax");
        if (!routeEl || !dateEl || !paxEl) return;

        routeEl.textContent = routeLabel(directionInput.value || "");

        if (tripDate.value) {
            dateEl.textContent = tripDate.value === todayISO() ? "Hoy" : tripDate.value;
