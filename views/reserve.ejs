    const minusBtn = document.getElementById("minusBtn");
    const childSeatsSel = document.getElementById("child_seats");
    const childSeatsText = document.getElementById("childSeatsText");
    const childPlusBtn = document.getElementById("childPlusBtn");
    const childMinusBtn = document.getElementById("childMinusBtn");
    const childPriceHint = document.getElementById("childPriceHint");
