<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Acceso admin | Servicio de Transporte',
    description: 'Acceso al panel de administración.',
    noindex: true
    }) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/css/home.css" rel="stylesheet">
    <link href="/css/login.css" rel="stylesheet">
</head>

<body class="home-page page-login">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<main class="home-hero login-stage">
    <div class="home-hero-media" role="img" aria-label="Carretera hacia el destino"></div>
    <div class="home-hero-veil" aria-hidden="true"></div>

    <div class="container login-stage-inner">
        <section class="login-shell home-reveal" aria-labelledby="admin-login-title">
            <a class="login-logo" href="/" aria-label="Ir al inicio">
                <img class="login-logo-img" src="/assets/logo-hero.png" alt="Servicio de Transporte" width="308" height="348" decoding="async">
            </a>

            <div class="login-card">
                <header class="login-card-head">
                    <h1 id="admin-login-title" class="login-title">Iniciar sesión</h1>
                    <p class="login-lead">Acceso al panel de administración.</p>
                </header>

                <% if (error) { %>
                    <div class="login-alert" role="alert">
                        <span class="login-alert-ico" aria-hidden="true"><%- include('partials/icon', { name: 'triangle-alert', size: 18 }) %></span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form method="POST" action="/admin/login" class="login-form" autocomplete="on">
                    <div class="login-field">
                        <label for="user" class="form-label">Usuario</label>
                        <div class="field-ico-wrap">
                            <span class="field-ico" aria-hidden="true"><%- include('partials/icon', { name: 'user', size: 18 }) %></span>
                            <input
                                    id="user"
                                    name="user"
                                    class="form-control"
                                    placeholder="Usuario"
                                    required
                                    autofocus
                                    autocomplete="username"
                                    inputmode="text"
                                    autocapitalize="none"
                                    spellcheck="false"
                            />
                        </div>
                    </div>

                    <div class="login-field">
                        <label for="pass" class="form-label">Contraseña</label>
                        <div class="field-ico-wrap">
                            <span class="field-ico" aria-hidden="true"><%- include('partials/icon', { name: 'lock', size: 18 }) %></span>
                            <input
                                    id="pass"
                                    name="pass"
                                    type="password"
                                    class="form-control has-toggle"
                                    placeholder="Contraseña"
                                    required
                                    autocomplete="current-password"
                            />
                            <button type="button" class="pass-toggle" id="togglePass" aria-label="Mostrar contraseña"
                                    aria-pressed="false">
                                <%- include('partials/icon', { name: 'eye', size: 18, iconId: 'eyeOn' }) %>
                                <%- include('partials/icon', { name: 'eye-off', size: 18, iconId: 'eyeOff' }) %>
                            </button>
                        </div>
                    </div>

                    <button class="btn btn-wine login-submit" type="submit">
                        <span class="btn-ico"><%- include('partials/icon', { name: 'log-in', size: 18 }) %></span>
                        Entrar
                    </button>
                </form>

                <p class="login-back">
                    <a href="/">Volver al inicio</a>
                </p>
            </div>
        </section>

        <footer class="home-footer login-footer">
            <div class="home-footer-inner">
                <p class="home-footer-brand">Servicio de Transporte</p>
                <p class="home-footer-meta">Victoria - Llera · <a href="tel:+528344756376">834 475 6376</a></p>
            </div>
        </footer>
    </div>
</main>

<script src="/js/theme.js"></script>
<script>
    (function () {
        const pass = document.getElementById("pass");
        const btn = document.getElementById("togglePass");
        const eyeOn = document.getElementById("eyeOn");
        const eyeOff = document.getElementById("eyeOff");
        if (!pass || !btn) return;

        btn.addEventListener("click", function () {
            const show = pass.type === "password";
            pass.type = show ? "text" : "password";
            btn.setAttribute("aria-pressed", show ? "true" : "false");
            btn.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
            if (eyeOn && eyeOff) {
                eyeOn.style.display = show ? "none" : "";
                eyeOff.style.display = show ? "" : "none";
            }
        });
    })();
</script>
</body>
</html>
