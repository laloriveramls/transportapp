<%
const selectedStop = String(typeof selected !== 'undefined' ? selected : '').trim().toUpperCase();
const labels = (typeof cityLabels !== 'undefined' && cityLabels) ? cityLabels : {};
const vicName = labels.VIC || 'Ciudad Victoria';
const lleName = labels.LLE || 'Llera';
%>
<optgroup label="Ciudades">
    <option value="VIC" <%= selectedStop === 'VIC' ? 'selected' : '' %>><%= vicName %></option>
    <option value="LLE" <%= selectedStop === 'LLE' ? 'selected' : '' %>><%= lleName %></option>
</optgroup>
<optgroup label="Paradas">
    <% (vicLocations || []).forEach(function(loc) { %>
        <option value="<%= loc.code %>" <%= selectedStop === loc.code ? 'selected' : '' %>><%= loc.label %></option>
    <% }) %>
</optgroup>
