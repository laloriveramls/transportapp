<!-- partials/toast.ejs -->
<!-- Position owned by theme.css (.app-toast-host) — avoid Bootstrap top-0/end-0 (they use !important and break mobile). -->
<div class="toast-container app-toast-host" aria-live="polite" aria-relevant="additions text">
    <div id="appToast"
         class="toast app-toast"
         role="alert"
         aria-live="polite"
         aria-atomic="true"
         data-variant="dark">

        <div class="app-toast-inner">
            <div class="app-toast-icon" id="appToastIcon" aria-hidden="true">
                <%- include('icon', { name: 'check', size: 18, icoClass: 'ico-toast' }) %>
            </div>

            <div class="app-toast-content">
                <div class="app-toast-title" id="appToastTitle">Listo</div>
                <div class="app-toast-body" id="appToastMsg">Listo</div>
            </div>

            <button type="button"
                    class="btn-close app-toast-close"
                    data-bs-dismiss="toast"
                    aria-label="Cerrar"></button>
        </div>

        <div class="app-toast-progress" aria-hidden="true"></div>
    </div>
</div>
