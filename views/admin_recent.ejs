<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Últimos registros',
    description: 'Admin: últimos registros de reservas.',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-recent">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Registros', tag: 'Folios, pagos y tickets' }) %>

<main class="home-main admin-main">
<section class="container">

    <%
    const _pm = String(pm || '').toUpperCase();
    const _q = String(q || '').trim();
    const _ps = Number(pageSize || 25);
    const _page = Number(page || 1);
    const _pages = Number(pages || 1);
    const rows = recentRows || [];

    const qsBase = [];
    if (_q) qsBase.push('q=' + encodeURIComponent(_q));
    if (_pm) qsBase.push('pm=' + encodeURIComponent(_pm));
    if (_ps) qsBase.push('pageSize=' + encodeURIComponent(_ps));

    const linkAll = '/admin/recent?' + [...(qsBase.filter(x => !x.startsWith('pm='))), 'page=1'].join('&');
    const linkPm = (v) => '/admin/recent?' + [...(qsBase.filter(x => !x.startsWith('pm='))), 'pm=' + encodeURIComponent(v), 'page=1'].join('&');

    const buildUrl = (p) => {
        const parts = [];
        if (_q) parts.push('q=' + encodeURIComponent(_q));
        if (_pm) parts.push('pm=' + encodeURIComponent(_pm));
        parts.push('page=' + encodeURIComponent(p));
        parts.push('pageSize=' + encodeURIComponent(_ps));
        return '/admin/recent?' + parts.join('&');
    };

    const money = (n) => {
        const v = Number(n || 0);
        try {
            return v.toLocaleString('es-MX', {style: 'currency', currency: 'MXN'});
        } catch {
            return '$' + (Math.round(v * 100) / 100);
        }
    };

    const payChip = (method) => {
        const p = String(method || '').toUpperCase();
        if (p === 'TAQUILLA') return { html: renderIcon('banknote', { size: 14 }) + ' Taquilla', cls: 'recent-tag' };
        if (p === 'TRANSFERENCIA' || p === 'TRANSFER') return { html: renderIcon('landmark', { size: 14 }) + ' Transfer', cls: 'recent-tag' };
        if (p === 'ONLINE') return { html: renderIcon('credit-card', { size: 14 }) + ' Online', cls: 'recent-tag' };
        return { html: (p || '—'), cls: 'recent-tag' };
    };

    const statusMeta = (status) => {
        const st = String(status || '');
        if (st === 'PAID') return { label: 'Pagado', cls: 'is-paid', badge: 'b-paid', icon: 'check' };
        if (st === 'CANCELLED') return { label: 'Cancelado', cls: 'is-cancel', badge: 'b-cancel', icon: 'ban' };
        if (st === 'PENDING_PAYMENT') return { label: 'Pendiente', cls: 'is-pending', badge: 'b-pending', icon: 'hourglass' };
        if (st === 'PAY_AT_BOARDING') return { label: 'Taquilla', cls: 'is-board', badge: 'b-board', icon: 'banknote' };
        return { label: st || '—', cls: '', badge: '', icon: 'info' };
    };

    const fmtMty = (mysqlStr) => {
        try {
            const s = String(mysqlStr || '').trim();
            if (!s) return '';
            const d = new Date(s.replace(' ', 'T') + 'Z');
            if (isNaN(d.getTime())) return s;
            return new Intl.DateTimeFormat('es-MX', {
                timeZone: 'America/Monterrey',
                dateStyle: 'medium',
                timeStyle: 'short',
            }).format(d);
        } catch {
            return String(mysqlStr || '');
        }
    };

    const formatTripWhen = (dateVal, timeStr) => {
        const hhmm = String(timeStr || '').slice(0, 5);
        let raw = String(dateVal || '').trim();
        if (raw.length > 10) raw = raw.slice(0, 10);
        let day = raw;
        try {
            const d = new Date(raw + 'T12:00:00');
            if (!isNaN(d.getTime())) {
                day = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'short' }).format(d);
            }
        } catch {}
        return hhmm ? (day + ' · ' + hhmm) : day;
    };

    const countsFromRoute = (typeof statusCounts === 'undefined') ? null : statusCounts;
    const counts = Object.assign({
        PAID: 0,
        PENDING_PAYMENT: 0,
        PAY_AT_BOARDING: 0,
        CANCELLED: 0,
    }, countsFromRoute || {});
    if (!countsFromRoute) {
        counts.PAID = rows.filter(x => x.status === 'PAID').length;
        counts.PENDING_PAYMENT = rows.filter(x => x.status === 'PENDING_PAYMENT').length;
        counts.PAY_AT_BOARDING = rows.filter(x => x.status === 'PAY_AT_BOARDING').length;
        counts.CANCELLED = rows.filter(x => x.status === 'CANCELLED').length;
    }

    const windowPages = [];
    if (_pages <= 7) {
        for (let i = 1; i <= _pages; i++) windowPages.push(i);
    } else {
        windowPages.push(1);
        const start = Math.max(2, _page - 1);
        const end = Math.min(_pages - 1, _page + 1);
        if (start > 2) windowPages.push('...');
        for (let i = start; i <= end; i++) windowPages.push(i);
        if (end < _pages - 1) windowPages.push('...');
        windowPages.push(_pages);
    }

    const hasFilters = !!(_q || _pm);
    const clearHref = '/admin/recent?page=1&pageSize=' + encodeURIComponent(_ps);
    const totalN = Number(total || 0);
    %>

    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Últimos registros</h2>
            <div class="home-tabs-tools">
                <%- include('partials/admin-nav', { adminNav: 'recent' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="recent-toolbar">
        <div class="recent-intro">
            <p class="recent-title"><%= totalN %> resultado<%= totalN === 1 ? '' : 's' %></p>
            <p class="recent-meta">
                <% if (totalN === 0) { %>
                    Sin coincidencias
                <% } else { %>
                    <%= from || 0 %>–<%= to || 0 %> · Pág. <%= _page %>/<%= _pages %>
                <% } %>
            </p>
        </div>

        <form class="recent-toolbar-form" method="GET" action="/admin/recent" id="filterForm">
            <input type="hidden" name="page" value="1">
            <input type="hidden" name="pm" value="<%= _pm %>">

            <label class="recent-search">
                <span class="recent-search-ico"><%- include('partials/icon', { name: 'search', size: 16 }) %></span>
                <span class="visually-hidden">Buscar folio, ticket o teléfono</span>
                <input class="form-control" name="q" value="<%= _q %>"
                       placeholder="Folio, ticket o teléfono"
                       autocomplete="off">
            </label>

            <div class="admin-filter-seg recent-pay-seg" role="group" aria-label="Método de pago">
                <a class="<%= !_pm ? 'is-on' : '' %>" href="<%= linkAll %>" <%= !_pm ? 'aria-current="true"' : '' %>>Todos</a>
                <a class="<%= _pm === 'TAQUILLA' ? 'is-on' : '' %>" href="<%= linkPm('TAQUILLA') %>" <%= _pm === 'TAQUILLA' ? 'aria-current="true"' : '' %>>Taquilla</a>
                <a class="<%= _pm === 'TRANSFERENCIA' ? 'is-on' : '' %>" href="<%= linkPm('TRANSFERENCIA') %>" <%= _pm === 'TRANSFERENCIA' ? 'aria-current="true"' : '' %>>Transfer</a>
                <a class="<%= _pm === 'ONLINE' ? 'is-on' : '' %>" href="<%= linkPm('ONLINE') %>" <%= _pm === 'ONLINE' ? 'aria-current="true"' : '' %>>Online</a>
            </div>

            <div class="recent-form-actions">
                <label class="recent-pagesize">
                    <span class="visually-hidden">Resultados por página</span>
                    <select class="form-select" name="pageSize" id="pageSizeSelect" aria-label="Resultados por página">
                        <option value="25" <%= _ps === 25 ? 'selected' : '' %>>25 / pág.</option>
                        <option value="50" <%= _ps === 50 ? 'selected' : '' %>>50 / pág.</option>
                        <option value="100" <%= _ps === 100 ? 'selected' : '' %>>100 / pág.</option>
                    </select>
                </label>
                <button class="btn btn-wine recent-apply" type="submit">Buscar</button>
                <% if (hasFilters) { %>
                    <a class="btn btn-ghost recent-clear" href="<%= clearHref %>">Limpiar</a>
                <% } %>
            </div>
        </form>
    </div>

    <div class="recent-kpis" role="group" aria-label="Resumen de estados">
        <div class="recent-kpi">
            <span class="recent-kpi-value"><%= Number(counts.PAID || 0) %></span>
            <span class="recent-kpi-label">Pagados</span>
        </div>
        <div class="recent-kpi">
            <span class="recent-kpi-value"><%= Number(counts.PENDING_PAYMENT || 0) %></span>
            <span class="recent-kpi-label">Pendientes</span>
        </div>
        <div class="recent-kpi">
            <span class="recent-kpi-value"><%= Number(counts.PAY_AT_BOARDING || 0) %></span>
            <span class="recent-kpi-label">Taquilla</span>
        </div>
        <div class="recent-kpi is-quiet">
            <span class="recent-kpi-value"><%= Number(counts.CANCELLED || 0) %></span>
            <span class="recent-kpi-label">Cancelados</span>
        </div>
    </div>

    <% if (!rows.length) { %>
        <div class="recent-empty">
            <div class="recent-empty-ico" aria-hidden="true"><%- include('partials/icon', { name: 'receipt', size: 22 }) %></div>
            <div class="h6 mb-1">Sin registros</div>
            <div class="subtle"><%= hasFilters ? 'Prueba otro folio, teléfono o método de pago.' : 'Cuando haya reservas aparecerán aquí.' %></div>
            <% if (hasFilters) { %>
                <a class="recent-chip" href="<%= clearHref %>">Quitar filtros</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="recent-table-card">
            <div class="recent-table-scroll">
                <table class="recent-table">
                    <thead>
                    <tr>
                        <th class="col-reserva">Reserva</th>
                        <th class="col-status">Estado</th>
                        <th class="col-trip">Viaje</th>
                        <th class="col-type">Tipo</th>
                        <th class="col-pay">Pago</th>
                        <th class="col-ticket">Ticket</th>
                        <th class="col-actions">Acciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    <% rows.forEach(r => {
                        const qs = [];
                        if (_q) qs.push('q=' + encodeURIComponent(_q));
                        if (_pm) qs.push('pm=' + encodeURIComponent(_pm));
                        if (_ps) qs.push('pageSize=' + encodeURIComponent(_ps));
                        if (_page) qs.push('page=' + encodeURIComponent(_page));
                        const returnBack = '/admin/recent' + (qs.length ? ('?' + qs.join('&')) : '');

                        const pay = payChip(r.payment_method);
                        const st = statusMeta(r.status);
                        const paxShown = Number(r.passenger_count || 0) || Number(r.seats || 0) || 0;
                        const isPassenger = r.type === 'PASSENGER';
                        const hasNames = String(r.passenger_names || '').trim();
                        const detailValue = isPassenger ? (hasNames ? r.passenger_names : (r.customer_name || '—')) : (r.package_details || '—');
                        const created = r.created_at ? fmtMty(r.created_at) : '';
                        const totalRow = (r.amount_total_mxn != null && r.amount_total_mxn !== '') ? Number(r.amount_total_mxn) : null;
                        const phone = String(r.phone || '').trim();
                        const phoneDigits = phone.replace(/\D/g, '');
                        const transferRef = String(r.transfer_ref || '').trim();
                        const ticketHref = r.ticket_code
                            ? ('/ticket/' + encodeURIComponent(r.ticket_code) + '?return=' + encodeURIComponent(returnBack))
                            : '';
                    %>
                    <tr class="<%= st.cls %>">
                        <td class="col-reserva" data-label="Reserva">
                            <div class="recent-folio mono" title="<%= created || r.folio %>"><%= r.folio %></div>
                            <div class="recent-who">
                                <span class="recent-name"><%= r.customer_name || '—' %></span>
                                <% if (phoneDigits.length >= 8) { %>
                                    <a class="recent-phone mono" href="tel:<%= phoneDigits %>"><%= phone || '—' %></a>
                                <% } else { %>
                                    <span class="recent-phone mono"><%= phone || '—' %></span>
                                <% } %>
                            </div>
                        </td>
                        <td class="col-status" data-label="Estado">
                            <span class="badge-soft <%= st.badge %> recent-status">
                                <%- include('partials/icon', { name: st.icon, size: 14 }) %>
                                <%= st.label %>
                            </span>
                        </td>
                        <td class="col-trip" data-label="Viaje">
                            <div class="recent-trip-line">
                                <span class="recent-tag recent-tag--route"><%= directionLabel(r.direction) %></span>
                                <span class="recent-when mono"><%= formatTripWhen(r.trip_date, r.depart_time) %></span>
                            </div>
                        </td>
                        <td class="col-type" data-label="Tipo">
                            <span class="recent-tag">
                                <%- include('partials/icon', { name: isPassenger ? 'user' : 'package', size: 14 }) %>
                                <%= isPassenger ? ('Pasajero' + (paxShown > 1 ? 's · ' + paxShown : '')) : 'Paquete' %>
                            </span>
                            <div class="recent-type-extra" title="<%= detailValue %>"><%= detailValue %></div>
                        </td>
                        <td class="col-pay" data-label="Pago">
                            <div class="recent-pay-line">
                                <span class="recent-amount mono"><%= totalRow != null ? money(totalRow) : '—' %></span>
                                <span class="<%= pay.cls %>"><%- pay.html %></span>
                            </div>
                            <% if (transferRef) { %>
                                <div class="recent-ref mono" title="<%= transferRef %>"><%= transferRef %></div>
                            <% } %>
                        </td>
                        <td class="col-ticket" data-label="Ticket">
                            <% if (ticketHref) { %>
                                <a class="recent-ticket mono" href="<%= ticketHref %>"><%= r.ticket_code %></a>
                            <% } else { %>
                                <span class="subtle">—</span>
                            <% } %>
                        </td>
                        <td class="col-actions" data-label="Acciones">
                            <div class="recent-row-cta">
                                <a class="btn btn-ghost recent-cta-btn" href="/admin/trip/<%= r.trip_id %>">Salida</a>
                                <% if (ticketHref) { %>
                                    <a class="btn btn-wine recent-cta-btn" href="<%= ticketHref %>">Ticket</a>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    </tbody>
                </table>
            </div>

        <nav class="recent-pager" aria-label="Paginación">
            <div class="recent-pager-meta subtle">
                <%= from || 0 %>–<%= to || 0 %> de <%= totalN %>
            </div>
            <div class="recent-pager-pages">
                <a class="recent-page <%= _page <= 1 ? 'is-disabled' : '' %>"
                   href="<%= buildUrl(Math.max(1, _page - 1)) %>"
                   aria-label="Página anterior"
                   <%= _page <= 1 ? 'aria-disabled="true" tabindex="-1"' : '' %>>
                    <%- include('partials/icon', { name: 'arrow-left', size: 16 }) %>
                </a>
                <% windowPages.forEach(p => { %>
                    <% if (p === '...') { %>
                        <span class="recent-page-dots">…</span>
                    <% } else { %>
                        <a class="recent-page <%= Number(p) === _page ? 'is-on' : '' %>"
                           href="<%= buildUrl(p) %>"
                           <%= Number(p) === _page ? 'aria-current="page"' : '' %>><%= p %></a>
                    <% } %>
                <% }) %>
                <a class="recent-page <%= _page >= _pages ? 'is-disabled' : '' %>"
                   href="<%= buildUrl(Math.min(_pages, _page + 1)) %>"
                   aria-label="Página siguiente"
                   <%= _page >= _pages ? 'aria-disabled="true" tabindex="-1"' : '' %>>
                    <%- include('partials/icon', { name: 'arrow-right', size: 16 }) %>
                </a>
            </div>
        </nav>
        </div>
    <% } %>

        </div>
    </div>
</section>
</main>

<%- include('partials/admin-footer') %>
<script src="/js/theme.js"></script>
<script>
    (function () {
        const ps = document.getElementById('pageSizeSelect');
        const form = document.getElementById('filterForm');
        if (ps && form) {
            ps.addEventListener('change', () => form.requestSubmit());
        }
    })();
</script>
</body>
</html>
