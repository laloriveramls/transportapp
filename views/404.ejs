<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: title || '404 · Página no encontrada',
    description: 'Página no encontrada. Regresa al inicio.',
    noindex: true
    }) %>

    <style>
        .page404 {
            min-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .page404-inner {
            width: min(420px, 100%);
            text-align: center;
        }

        .page404-code {
            font-size: 4rem;
            font-weight: 600;
            letter-spacing: -0.04em;
            line-height: 1;
            color: var(--muted);
            margin: 0;
        }

        .page404-title {
            margin: 0.75rem 0 0;
            font-weight: 600;
            font-size: 1.25rem;
            letter-spacing: -0.02em;
        }

        .page404-sub {
            margin: 0.5rem 0 0;
            color: var(--muted);
            font-size: 0.875rem;
            line-height: 1.5;
        }

        .page404-actions {
            margin-top: 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            align-items: center;
        }

        .page404-detail {
            margin-top: 1rem;
            font-size: 0.8125rem;
            color: var(--muted);
        }

        .page404-detail summary {
            cursor: pointer;
            user-select: none;
        }

        .page404-detail .mono {
            display: block;
            margin-top: 0.35rem;
            word-break: break-all;
        }
    </style>
</head>

<body>
<main class="page404">
    <div class="page404-inner">
        <p class="page404-code">404</p>
        <h1 class="page404-title">Página no encontrada</h1>
        <p class="page404-sub">El enlace puede estar incorrecto o la página ya no existe.</p>

        <div class="page404-actions">
            <a class="btn btn-wine" href="/">Volver al inicio</a>
        </div>

        <details class="page404-detail">
            <summary>Ver ruta solicitada</summary>
            <span class="mono"><%= path %></span>
        </details>
    </div>
</main>
<script src="/js/theme.js"></script>
</body>
</html>
