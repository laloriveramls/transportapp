<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: 'Agenda',
    description: 'Agenda administrativa de salidas y reservas.',
    noindex: true
    }) %>

    <%- include('partials/admin-assets') %>
</head>

<body class="home-page admin-app page-agenda">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>
<%- include('partials/admin-hero', { heading: 'Agenda', tag: 'Salidas, cupo y tickets' }) %>

<main class="home-main admin-main">
<section class="container">
    <%
    const owtQ = onlyWithTrip ? '&onlyWithTrip=1' : '';
    const todayISO = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Monterrey' });
    const isToday = String(date || '') === todayISO;

    function formatAgendaDate(iso) {
        const s = String(iso || '').trim();
        if (!s) return '';
        try {
            const d = new Date(s + 'T12:00:00');
            if (isNaN(d.getTime())) return s;
            const raw = new Intl.DateTimeFormat('es-MX', {
                weekday: 'long',
                day: 'numeric',
                month: 'long',
            }).format(d);
            return raw.charAt(0).toUpperCase() + raw.slice(1);
        } catch {
            return s;
        }
    }

    const datePretty = formatAgendaDate(date);
    const dateShort = (() => {
        const parts = String(date || '').split('-');
        if (parts.length !== 3) return String(date || '');
        return `${parts[2]}/${parts[1]}`;
    })();

    function hasActivity(t) {
        return Number(t.used_seats || 0) > 0 || Number(t.packages || 0) > 0;
    }

    const allTrips = trips || [];
    const shownTrips = onlyWithTrip ? allTrips.filter(hasActivity) : allTrips;
    const groups = [
        {
            key: 'VIC_TO_LLE',
            from: 'Victoria',
            to: 'Llera',
            items: shownTrips.filter((t) => t.direction === 'VIC_TO_LLE'),
        },
        {
            key: 'LLE_TO_VIC',
            from: 'Llera',
            to: 'Victoria',
            items: shownTrips.filter((t) => t.direction === 'LLE_TO_VIC'),
        },
    ];
    %>
    <div class="tabs-card home-tabs admin-shell">
        <div class="home-tabs-head">
            <h2 class="home-section-title">Salidas del día</h2>
            <div class="home-tabs-tools">
                <%- include('partials/admin-nav', { adminNav: 'agenda' }) %>
            </div>
        </div>
        <div class="home-tabs-body">

    <div class="agenda-toolbar">
        <div class="agenda-date-block">
            <p class="agenda-date-label" id="agendaDateLabel"><%= datePretty %></p>
            <p class="agenda-date-meta">
                <% if (isToday) { %><span class="agenda-today-dot">Hoy</span><% } %>
                <%= shownTrips.length %> salida<%= shownTrips.length === 1 ? '' : 's' %><% if (onlyWithTrip) { %> con viaje<% } %>
            </p>
        </div>

        <form id="agendaForm" class="agenda-toolbar-form" method="GET" action="/admin/agenda">
            <div class="agenda-day-nav">
                <a class="agenda-day-arrow"
                   href="/admin/agenda?date=<%= encodeURIComponent(agendaPrevDate) %><%= owtQ %>"
                   title="Día anterior"
                   aria-label="Ir al día anterior"><%- include('partials/icon', { name: 'chevron-left', size: 18 }) %></a>
                <span class="agenda-date-input">
                    <span class="agenda-date-fake" aria-hidden="true"><%= dateShort %></span>
                    <input id="agendaDate" type="date" name="date" class="form-control" value="<%= date %>" aria-labelledby="agendaDateLabel">
                </span>
                <a class="agenda-day-arrow"
                   href="/admin/agenda?date=<%= encodeURIComponent(agendaNextDate) %><%= owtQ %>"
                   title="Día siguiente"
                   aria-label="Ir al día siguiente"><%- include('partials/icon', { name: 'chevron-right', size: 18 }) %></a>
            </div>
            <input type="hidden" name="onlyWithTrip" value="<%= onlyWithTrip ? '1' : '0' %>">
            <button class="visually-hidden" type="submit">Ver fecha</button>

            <% if (!isToday) { %>
                <a class="agenda-chip" href="/admin/agenda?date=<%= encodeURIComponent(todayISO) %><%= owtQ %>">Hoy</a>
            <% } %>

            <div class="agenda-seg" role="group" aria-label="Filtro de salidas">
                <a class="agenda-seg-btn <%= onlyWithTrip ? '' : 'is-on' %>"
                   href="/admin/agenda?date=<%= encodeURIComponent(date || '') %>&onlyWithTrip=0"
                   <%= onlyWithTrip ? '' : 'aria-current="true"' %>>Todas</a>
                <a class="agenda-seg-btn <%= onlyWithTrip ? 'is-on' : '' %>"
                   href="/admin/agenda?date=<%= encodeURIComponent(date || '') %>&onlyWithTrip=1"
                   <%= onlyWithTrip ? 'aria-current="true"' : '' %>>Con viaje</a>
            </div>
        </form>
    </div>

    <div class="agenda-kpis" role="group" aria-label="Resumen del día">
        <div class="agenda-kpi">
            <span class="agenda-kpi-value"><%= Number(totalPassengers || 0) %></span>
            <span class="agenda-kpi-label">Pasajeros</span>
        </div>
        <div class="agenda-kpi">
            <span class="agenda-kpi-value"><%= Number(totalPackages || 0) %></span>
            <span class="agenda-kpi-label">Paquetería</span>
        </div>
        <div class="agenda-kpi is-quiet">
            <span class="agenda-kpi-value"><%= Number(cancelledPassengers || 0) %></span>
            <span class="agenda-kpi-label">Pax cancelados</span>
        </div>
        <div class="agenda-kpi is-quiet">
            <span class="agenda-kpi-value"><%= Number(cancelledPackages || 0) %></span>
            <span class="agenda-kpi-label">Paq. cancelados</span>
        </div>
    </div>

    <% if (!shownTrips.length) { %>
        <div class="agenda-empty">
            <div class="agenda-empty-ico" aria-hidden="true"><%- include('partials/icon', { name: 'bus', size: 22 }) %></div>
            <div class="h6 mb-1"><%= onlyWithTrip ? 'Sin salidas con viaje' : 'Sin salidas' %></div>
            <div class="subtle"><%= onlyWithTrip
                ? 'No hay pasajeros ni paquetería en este día. Quita el filtro para ver el tablero completo.'
                : 'Cambia la fecha para ver otras salidas.' %></div>
            <% if (onlyWithTrip) { %>
                <a class="agenda-chip" href="/admin/agenda?date=<%= encodeURIComponent(date || '') %>&onlyWithTrip=0">Ver todas</a>
            <% } %>
        </div>
    <% } else { %>
        <div class="agenda-board">
            <% groups.forEach((group) => { %>
                <section class="agenda-col" aria-label="<%= group.from %> a <%= group.to %>">
                    <div class="agenda-col-head">
                        <div class="agenda-col-route">
                            <span class="agenda-col-from"><%= group.from %></span>
                            <span class="agenda-col-mid" aria-hidden="true"><%- include('partials/icon', { name: 'arrow-right', size: 14 }) %></span>
                            <span class="agenda-col-to"><%= group.to %></span>
                        </div>
                        <span class="agenda-col-count"><%= group.items.length %></span>
                    </div>

                    <% if (!group.items.length) { %>
                        <div class="agenda-col-empty subtle">Sin salidas en este rumbo.</div>
                    <% } %>

                    <div class="agenda-col-list">
                    <% group.items.forEach((t) => {
                        const used = Number(t.used_seats || 0);
                        const capRaw = Number(t.capacity_passengers || 0);
                        const cap = Math.min(6, Math.max(0, capRaw));
                        const remaining = Math.max(0, cap - used);
                        const packs = Number(t.packages || 0);
                        const hhmm = String(t.depart_time || '').slice(0, 5);
                        let tone = 'empty';
                        if (cap > 0 && used >= cap) tone = 'full';
                        else if (used > 0 && remaining <= 2) tone = 'tight';
                        else if (used > 0) tone = 'ok';
                        if (packs > 0 && used === 0) tone = 'ok';
                    %>
                    <a class="agenda-trip is-<%= tone %>"
                       href="/admin/trip/<%= t.trip_id %>"
                       aria-label="<%= group.from %> a <%= group.to %> a las <%= hhmm %>, <%= used %> de <%= cap %> asientos">
                        <div class="agenda-trip-time mono"><%= hhmm %></div>
                        <div class="agenda-trip-body">
                            <span class="agenda-seats" aria-hidden="true">
                                <% for (let i = 0; i < cap; i++) { %>
                                    <span class="agenda-seat <%= i < used ? 'is-on' : '' %>"></span>
                                <% } %>
                            </span>
                            <span class="agenda-trip-cap mono"><%= used %><span class="agenda-trip-cap-sep">/</span><%= cap %></span>
                        </div>
                        <div class="agenda-trip-aside">
                            <% if (packs > 0) { %>
                                <span class="agenda-pack has-pack">
                                    <%- include('partials/icon', { name: 'package', size: 14 }) %>
                                    <%= packs %>
                                </span>
                            <% } else { %>
                                <span class="agenda-pack" aria-hidden="true"></span>
                            <% } %>
                            <span class="agenda-trip-cta" aria-hidden="true">
                                <%- include('partials/icon', { name: 'chevron-right', size: 16 }) %>
                            </span>
                        </div>
                    </a>
                    <% }) %>
                    </div>
                </section>
            <% }) %>
        </div>
    <% } %>

        </div>
    </div>
</section>
</main>

<%- include('partials/admin-footer') %>
<script src="/js/theme.js"></script>

<script>
    (function () {
        const form = document.getElementById('agendaForm');
        const dateInput = document.getElementById('agendaDate');
        dateInput?.addEventListener('change', () => {
            form?.requestSubmit();
        });
    })();
</script>

</body>
</html>
