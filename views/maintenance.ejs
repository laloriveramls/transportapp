<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: (title || "Mantenimiento") + " | Servicio de Transporte",
    description: "Estamos preparando el sitio. Vuelve a intentarlo en unos minutos.",
    noindex: true
    }) %>
</head>

<body class="page-maintenance">
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<main class="maint-wrap">
    <section class="maint-card" role="status" aria-live="polite">
        <header class="maint-top">
            <div class="pill"><%- include('partials/icon', { name: 'wrench', size: 16 }) %> Modo mantenimiento</div>
            <h1 class="h3 title"><%= title || "Mantenimiento" %></h1>
            <p class="sub"><%= message || "Estamos preparando el sitio. Intenta de nuevo en unos minutos." %></p>
        </header>

        <div class="maint-body">
            <div class="tips">
                <div class="tip">Si estabas por pagar o reservar, no te preocupes: puedes volver a intentarlo cuando el
                    sitio esté listo.
                </div>
                <div class="tip">Si necesitas ayuda urgente, contáctanos por WhatsApp.</div>
            </div>

            <div class="actions">
                <a class="btn-wine" href="/" aria-label="Volver al inicio"><%- include('partials/icon', { name: 'house', size: 16 }) %> Volver al inicio</a>
                <a class="btn-soft" href="javascript:location.reload()" aria-label="Recargar página"><%- include('partials/icon', { name: 'refresh-cw', size: 16 }) %> Reintentar</a>
                <a class="btn-soft" target="_blank"
                   href="https://wa.me/528344756376?text=<%= encodeURIComponent('Hola, el sitio está en mantenimiento. ¿Me pueden apoyar?') %>">
                    <%- include('partials/icon', { name: 'message-circle', size: 16 }) %> WhatsApp
                </a>
            </div>

            <div class="tiny">Gracias por tu paciencia.</div>
        </div>
    </section>
</main>

<script src="/js/theme.js"></script>
</body>
</html>
