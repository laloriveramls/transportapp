<!doctype html>
<html lang="es" data-theme="light">
<head>
    <%- include('partials/head', {
    title: (title || "Mantenimiento") + " | Servicio de Transporte",
    description: "Estamos preparando el sitio. Vuelve a intentarlo en unos minutos.",
    noindex: true
    }) %>

    <style>
        .maint-wrap {
            min-height: calc(100dvh - 56px);
            display: grid;
            place-items: center;
            padding: 2rem 1rem;
        }

        .maint-card {
            width: min(480px, 100%);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            background: var(--surface);
            padding: 2rem;
            text-align: center;
        }

        .maint-title {
            margin: 0;
            font-weight: 600;
            font-size: 1.25rem;
            letter-spacing: -0.02em;
        }

        .maint-sub {
            margin: 0.5rem 0 0;
            color: var(--muted);
            font-size: 0.875rem;
            line-height: 1.5;
        }

        .maint-actions {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 1.5rem;
        }

        .maint-actions .btn {
            font-size: 0.8125rem;
        }

        @media (max-width: 576px) {
            .maint-actions .btn { width: 100%; }
        }
    </style>
</head>

<body>
<%- include('partials/body-open') %>
<%- include('partials/navbar') %>

<main class="maint-wrap">
    <section class="maint-card" role="status" aria-live="polite">
        <p class="section-label mb-2">Mantenimiento</p>
        <h1 class="maint-title"><%= title || "Sitio en mantenimiento" %></h1>
        <p class="maint-sub"><%= message || "Estamos preparando el sitio. Intenta de nuevo en unos minutos." %></p>

        <div class="maint-actions">
            <a class="btn btn-wine" href="/">Volver al inicio</a>
            <a class="btn btn-ghost" href="javascript:location.reload()">Reintentar</a>
            <a class="btn btn-ghost" target="_blank" rel="noopener"
               href="https://wa.me/528344756376?text=<%= encodeURIComponent('Hola, el sitio está en mantenimiento. ¿Me pueden apoyar?') %>">
                WhatsApp
            </a>
        </div>
    </section>
</main>

<script src="/js/theme.js"></script>
</body>
</html>
